  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 7375400,
    "id": 1,
    "wpWinPosId": 1,
    "wsWinStyleId": 1
  }, {
    "tStartMs": 67720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "始まったわけ。始まってるわけ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 76510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 76520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?どこだ?あの声ちょっとこれから喋って。あめ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 80270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 80280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。聞こえてる?まる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 83310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 83320,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "始まってるわけ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 85830,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 85840,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "始まってるわけ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 87870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 87880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日は何をするかと言うと、あめさん、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 91830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 91840,
    "dDurationMs": 5559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日は、え、はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 94389,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 94399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大富豪なんですけど、ルール知らないってま、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 97990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 98000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか忘れちゃった。なんか昔さ、一緒にやったけど毎回やるたびに期間が飽きすぎて忘れてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 105190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 105200,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前覚えてないんか?あの旅館でさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 107830,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 107840,
    "dDurationMs": 2800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "や",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 109550,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 109560,
    "dDurationMs": 3559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "朝が",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 110630,
    "dDurationMs": 2489,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 110640,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "朝が来るまで無限に大富豪してた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 113109,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 113119,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれを忘れたんか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 114910,
    "dDurationMs": 2809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 114920,
    "dDurationMs": 4519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやあ、やりましたね。あれね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 117709,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 117719,
    "dDurationMs": 2961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "懐かしいわ。ということで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 119429,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 119439,
    "dDurationMs": 4241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "懐かしい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 120670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 120680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本日は、え、安ば大富豪。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 124270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 124280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "イエー。もるよ。ということでです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 129109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 129119,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来てくれんのかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 130589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 130599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、今日はちょっと作戦があってすかすか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 134589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 134599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、やっぱいつもね、スマるだけがね、なんか凸かとか言ってるとね、ちょっともうゲがないわけ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 140150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 140160,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 141710,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 141720,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、スバルの人脈じゃ足りないってこと?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 144470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 144480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、もう足りない。ここでちょいとそのあめがちょっと凸をぶちかますことによってこうニューカマーを探そうみたいなそういうね回なんよ。これは裏",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 156309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 156319,
    "dDurationMs": 4441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね世で釣れんのかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 157750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 157760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、わからん。ちょっとさ、なんか逆に気になるくない?あめだってさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 162070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 162080,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、凸待ちとかしたことある?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 164670,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 164680,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 479,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 165350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 165360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回とかに、ま、ご片手で収まるぐらいしかないですよね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 171270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 171280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すげえって。いや、だから逆にその綾場であめが募集したら誰が来るんかなみたいななんかそういう辛いよ。来なかったな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 182030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 182040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、そしたら、ま、あめって人脈ないんだなってなって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 187030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 187040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええが悲しいことあるだけやんけ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 190110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 190120,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、そんならもう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 800,
      "acAsrConf": 0
    }, {
      "utf8": "人で祝と、ま、",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 2320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 192550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 192560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "期生あんまり尋問ありませんでしたっつって終わるから。今日はね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 195869,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 195879,
    "dDurationMs": 4841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだな。だな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 197710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 197720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ今日は、え、音量調整の方いかがでしょうか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 201589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 201599,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。どうでしょうか?要はこちらぐらいです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 204589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 204599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバルはこれぐらいかです。ちょさ、鳥ま一旦",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 209869,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 209879,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 210670,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 210680,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "遊び対善するか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 213030,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 213040,
    "dDurationMs": 1800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 213750,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 213760,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。まずまず",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 214830,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 214840,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずオンラインに接続しないといけないから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 217229,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 217239,
    "dDurationMs": 2841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。そ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 218470,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 218480,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "合流しないといけないのね。まずね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 220070,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 220080,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。合流しないといけないから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 222350,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 222360,
    "dDurationMs": 2640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 223270,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 223280,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバエルの声が小さいと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 224990,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 225000,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、これをこうして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 226550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 226560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オンラインでフレ、え、フレンドですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 229949,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 229959,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、さすがにフレンドでしょ。さすがにフレンド生フレンドですよね。さすがにフレンドでしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 238350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 238360,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ロビーは作った方がいいすか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 240710,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 240720,
    "dDurationMs": 4159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ロビーは作ってもらっていいすか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 243470,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 243480,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "了解です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 244869,
    "dDurationMs": 331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 244879,
    "dDurationMs": 1881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 245190,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 245200,
    "dDurationMs": 2759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "作れる?ロビー?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 246750,
    "dDurationMs": 1209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 246760,
    "dDurationMs": 4199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "作りました。作りました。今。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 247949,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 247959,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお、さすがに作れるか?ロビーさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 252190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 252200,
    "dDurationMs": 5399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さすがに遊びたいぜはね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 254589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 254599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やったことあるか?さすがにね。オンラインにして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 259430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 259440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フレンドと遊ぶ。ロビーを選ぶこれであめ出てこなかったらどうしよう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 264710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 264720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。お嬢作り方分かるのかって言われてんだけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 269230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 269240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもスバルもちょっと思ったよね。あめわかるんかみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 274270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 274280,
    "dDurationMs": 2280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ていうかなんかさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 276029,
    "dDurationMs": 531,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 276039,
    "dDurationMs": 3481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 276550,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 276560,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日サムネ作ってて思ったんだけどさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 279510,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 279520,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "自分で作ってて思ったけど、この",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 281430,
    "dDurationMs": 3170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 281440,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人の凸待ち行きたくねえなって。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 285110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 285120,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんでなんでなんでそれですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 287310,
    "dDurationMs": 2410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 287320,
    "dDurationMs": 2599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかこの感じでそのなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 289710,
    "dDurationMs": 209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 289720,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 289909,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 289919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "期生とかいう結構さ言ったらもう子参の子参なんかその共通がないなくて",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 299550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 299560,
    "dDurationMs": 1320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 299909,
    "dDurationMs": 971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 299919,
    "dDurationMs": 3961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、確かにね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 300870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 300880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか何話すんだろうとみたいな。結構なんかちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 306230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 306240,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、まあハードルは高いよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 308950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 308960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だってさ、作って思ったけど、ちょっとなんかおつ骨みたいな雰囲気あったも言うとしてやめたのに。このおつ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 315950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 315960,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人に入ってく勇気はないよね。",
      "tOffsetMs": 120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 318430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 318440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもお、おつではないというところをちょっと見せていきたいわけよ、今日。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 324110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 324120,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日ね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 324390,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 324400,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なかなか癖がある。おつ骨",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 326510,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 326520,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "だけど。",
      "tOffsetMs": 320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 327430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 327440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ちょっとね、ちょっとなんか、あ、強くね、このサムネと思ってビったよね、普通に。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 333029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 333039,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 333309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 333319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、そんな肝が座った子が来てくれるのか楽しみですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 337749,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 337759,
    "dDurationMs": 3401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "この",
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 241,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 338150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 338160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人だと誰が来てくれるんだらどうする?あのよくよく遊ぶメンバーも来てくれなかった。今日結構さ裏込み合ってるからさ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 349670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 349680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。そうだよ。うちらが仲いいね。みんなは結構忙しいんじゃないですか?今",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 355230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 355240,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。今日",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 357469,
    "dDurationMs": 931,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 357479,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫かな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 358390,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 358400,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最悪チョコ戦呼ぶしかないわ。起こしてちょっと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 361350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 361360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。最悪突発コラボにするしかないね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 364830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 364840,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。するしかないね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 366150,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 366160,
    "dDurationMs": 3759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、やめ殿の入りましたぞ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 368950,
    "dDurationMs": 969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 368960,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、行けました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 369909,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 369919,
    "dDurationMs": 2361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 371270,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 371280,
    "dDurationMs": 2160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、来た、来た、来た、来た、来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 372270,
    "dDurationMs": 1170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 372280,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来な、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 373430,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 373440,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来ました、来ました。で、これで、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 374990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 375000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ、ちょっと音量を調整しましたが良いですかな?大丈夫そうですかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 379629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 379639,
    "dDurationMs": 4521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫そうですか皆さん?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 381150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 381160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、来た、来た。しゃ、チョコ戦案件らしい。終わった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 386309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 386319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、終わった。もう無理やん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 389749,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 389759,
    "dDurationMs": 2440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "無理や。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 390270,
    "dDurationMs": 1929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 390280,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "きコラボ無理やん。じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 392189,
    "dDurationMs": 1531,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 392199,
    "dDurationMs": 2641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、誰かちょ、あめなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 1361,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 393710,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 393720,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人で遊べる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 394830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 394840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "てか早め何してんのお前さプレイ回数がさ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 398790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 398800,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5",
      "acAsrConf": 0
    }, {
      "utf8": "目並だけ",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 401469,
    "dDurationMs": 170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 401479,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 401629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 401639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "目並べだけめっちゃやってかないだった今回",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 405909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 405919,
    "dDurationMs": 5961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "56",
      "acAsrConf": 0
    }, {
      "utf8": "他",
      "tOffsetMs": 1441,
      "acAsrConf": 0
    }, {
      "utf8": "0",
      "tOffsetMs": 1680,
      "acAsrConf": 0
    }, {
      "utf8": "とか",
      "tOffsetMs": 1961,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 2400,
      "acAsrConf": 0
    }, {
      "utf8": "とかなのにさ、",
      "tOffsetMs": 2601,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 410390,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 2440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、待ってヒットアンドブロ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "60",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 411870,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 411880,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回やってるよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 412830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 412840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。ちょ、一応",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 417189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 417199,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、何が得意なの?スバル。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 419350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 419360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもまあちょっと大富豪だと時間かかっちゃうからやっぱボクシングしょ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 425070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 425080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。も、いや、それ早く少しと言っちゃうの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 428589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 428599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃあなんかあとエアホッケ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 433070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 433080,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 433589,
    "dDurationMs": 1211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 433599,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 434790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 434800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねさなんか殴り合うものしかないな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 438390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 438400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、そんなね、あのなんかヒットアブローみたいな頭使う遊びできないから基本ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 443150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 443160,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、確かにそうか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 444950,
    "dDurationMs": 3210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 444960,
    "dDurationMs": 6200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ま、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 519,
      "acAsrConf": 0
    }, {
      "utf8": "番めが強いやつでいいよ。",
      "tOffsetMs": 679,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 448150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 448160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そんなん言ったらご目並べになるけ?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 452189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 452199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、いいよ。ご目並べしようや。言うて",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 456510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 456520,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "正月優勝してんだからな。優勝。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 459270,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 459280,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 460270,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 460280,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうじゃん。そうじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 461230,
    "dDurationMs": 2369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 461240,
    "dDurationMs": 5359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバルは優勝してる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 463589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 463599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃ、じゃあこれソバルに勝つたらイオが優勝したことになる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 467749,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 467759,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるね。なる、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 469350,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 469360,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なる、なる、なる、なる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 471749,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 471759,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ボクシングか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 473350,
    "dDurationMs": 409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 473360,
    "dDurationMs": 3399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 473749,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 473759,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ目並かエアホケでどれ行く?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 477589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 477599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、目並べでしょ。今の流れ。友情不か。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 481869,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 481879,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、じゃ、行きましょう。行きましょう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 483589,
    "dDurationMs": 1170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 483599,
    "dDurationMs": 2641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 484749,
    "dDurationMs": 1491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 484759,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "重くならべ。いざ勝負。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 486230,
    "dDurationMs": 1689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 486240,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いざ勝負。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 487909,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 487919,
    "dDurationMs": 2081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これルール?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 489270,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 489280,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 489990,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 490000,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、何",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 491230,
    "dDurationMs": 2089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 491240,
    "dDurationMs": 5079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ?ルールどうしてた?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 493309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 493319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめん。ルールとかよくわかんねえから適当でいいよ。本当に優勝したんだよな。お前",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 500189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 500199,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優勝した。優勝した。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 502790,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 502800,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、よくわかんない。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 503350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 503360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとみんな、みんなルールこれ何にしてた?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 506469,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 506479,
    "dDurationMs": 4081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 507550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 507560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "許す。これ、これ許していいの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 512709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 512719,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "みんなどう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 513990,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 514000,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいんじゃね?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 516070,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 516080,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、いいか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 516750,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 516760,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 518550,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 518560,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ、ま、ええか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 519670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 519680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行こうぜ。まあ、なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 523350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 523360,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "223344",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 524389,
    "dDurationMs": 2651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 524399,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "とか何かわかんねえじゃんそもそも。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 527030,
    "dDurationMs": 1929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 527040,
    "dDurationMs": 3359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 528949,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 528959,
    "dDurationMs": 3841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あなた優勝されたよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 530389,
    "dDurationMs": 2411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 530399,
    "dDurationMs": 5401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "待って。分かってんの逆に。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 532790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 532800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんかあるよね。重なてるみたいなね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 539230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 539240,
    "dDurationMs": 5159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当にお前も分かってんのか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 541389,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 541399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、分かってる。分かってるよ。分かってますとも。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 546509,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 546519,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 548389,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 548399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分かってますとも。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 552110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 552120,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう見えてるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 554310,
    "dDurationMs": 1290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 554320,
    "dDurationMs": 1840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早い早い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 555590,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 555600,
    "dDurationMs": 1919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや、もう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 556150,
    "dDurationMs": 1369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 556160,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "手のうちが早いね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 557509,
    "dDurationMs": 2971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 557519,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優勝してるからね。さすがに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 560470,
    "dDurationMs": 2049,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 560480,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 562509,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 562519,
    "dDurationMs": 3641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さすがの優勝者はちょっと違うか。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 565310,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 565320,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "味。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 566150,
    "dDurationMs": 4330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 566160,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    }, {
      "utf8": "味。あんたうまいね。",
      "tOffsetMs": 1320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 575750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 575760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あんた、あんたうまいね。こ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 579790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 579800,
    "dDurationMs": 2200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、早いな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 580750,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 580760,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、早いわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 581990,
    "dDurationMs": 2170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 582000,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、うまいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 584150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 584160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、うまいすか?シスで優勝した方に褒めてもらえるのちょっと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 591389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 591399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わ、でもなかなかうまいっすね。スワルさんも",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 595389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 595399,
    "dDurationMs": 3481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うまい。ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 596670,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 596680,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なかなかなかなか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 598870,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 598880,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なかなかなかなか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 601190,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 601200,
    "dDurationMs": 1759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 602630,
    "dDurationMs": 329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 602640,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 602949,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 602959,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やはり優勝されただけはある感じありますよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 607269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 607279,
    "dDurationMs": 2800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だけあるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 608670,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 608680,
    "dDurationMs": 4399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう塞がれてんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 610069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 610079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、これ誰か来たらさ、一旦語目どっちか代表でさ、戦おうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 619470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 619480,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、まずはこれを倒してから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 621630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 621640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずね、大富豪とは言ったものの言ったもののこれなあ、なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 634630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 634640,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいはい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 636030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 636040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいはいだな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 647870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 647880,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 648550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 648560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だな。え、何も見えない。え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 656509,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 656519,
    "dDurationMs": 2361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 657150,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 657160,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 658870,
    "dDurationMs": 1170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 658880,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや大丈夫ですよ。大丈",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 660030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 660040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい。コメントチラチラ見てんのかお前?見てない。見てない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 664790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 664800,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "コメチらしてんのかお前?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 667310,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 667320,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "してない。してない。考えてる。考えてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 669150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 669160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "考えてるね。考えてるね。考えてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 676150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 676160,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、これ油断すると本当にさ、埋まってんだよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 679030,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 679040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかる、わかる、わかる、わかる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 680590,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 680600,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当に油断できない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 682030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 682040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかる、わかる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 688230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 688240,
    "dDurationMs": 4279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早く置いてよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 689629,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 689639,
    "dDurationMs": 5081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、だ。あ、ちょっとだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 692509,
    "dDurationMs": 2211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 692519,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、ごめん。俺だってんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 694710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 694720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。俺だった。普通にちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 697790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 697800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめん。ごめん。ごめん。俺だった。俺だった。ごめん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 702230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 702240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、危ねえ、危ねえ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 708030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 708040,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ねえ、危ねえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 710030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 710040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、待って。マジで怖いんだけどこれ。え、ガチ怖い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 715230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 715240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、今スバルも同じ気持ち。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 720389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 720399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんか気づいたらマジで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 724110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 724120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。なんか頭の中で君と夏の終わりがずっと流れてる。何これ?季節外れすぎない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 729910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 729920,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう夏終わったけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "ちょっと待って。",
      "tOffsetMs": 1440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 732670,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 732680,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう夏終わるけど。終わったけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 735110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 735120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。終わっちゃった。あ、危ない危ない危ない危ない",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 741230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 741240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない危ない危ない危ない",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 745230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 745240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない危ない。あ。え?あ、それ強い。ああ。え、大丈夫だ。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 756189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 756199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え。ああ。ああ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 759350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 759360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、あ、え、あ、何かあ、おい、おいて、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 765350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 765360,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 766310,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 766320,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、おいってなっちゃう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 767670,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 767680,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "場所を映すぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 769990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 770000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわあ、それね、それ嫌。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 773230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 773240,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ嫌でしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 774990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 775000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない、危ない、危ない。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 778710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 778720,
    "dDurationMs": 2679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない危ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 780269,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 780279,
    "dDurationMs": 3961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 781389,
    "dDurationMs": 2851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 781399,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない危ない危ないね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 784230,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 784240,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 785590,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 785600,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ないよ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 786910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 786920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ。危ないんだよ、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 790110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 790120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめそうなんで今老人の会話って言われてそうあちゃんたちもっと危ない危ない危ない",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 797710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 797720,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんな元気じゃないでしょ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 799430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 799440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうちょっとちゃんとした会話してるだろどうしよう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 807350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 807360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今狙ってるよねここ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 810430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 810440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "狙ってないすよこそ狙ってますよね",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 815030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 815040,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや狙ってないよ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 816790,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 816800,
    "dDurationMs": 4719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかここ狙ってます",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 818509,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 818519,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねえ、狙ってない。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 824750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 824760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと待って。急に攻撃してくるの。やだ、やだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 829629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 829639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなな、そんなこと言われても。わ、怖い、怖い、怖い、怖い、怖い。やだ、やだ、やだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 837310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 837320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、一旦なんか四角にしとくことで可能性を広げるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 840710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 840720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、ちょ、本当に危なかった。うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 848430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 848440,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと待って。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 849990,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 850000,
    "dDurationMs": 4199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、埋まる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 851550,
    "dDurationMs": 2649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 851560,
    "dDurationMs": 4959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "俺らうまいか。一旦目。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 854189,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 854199,
    "dDurationMs": 5281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、いい。いい勝負してるってこと?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 856509,
    "dDurationMs": 2971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 856519,
    "dDurationMs": 5961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いい勝負してるよね。いい勝負してるよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 859470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 859480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いい勝負してるかも。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 865629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 865639,
    "dDurationMs": 1601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 866790,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 866800,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 867230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 867240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。ねえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 873550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 873560,
    "dDurationMs": 2800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ねえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 874990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 875000,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "くそ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 876350,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 876360,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ガチ危ない。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 878110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 878120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今笑ってしまった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 881310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 881320,
    "dDurationMs": 5759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖ええ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 884069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 884079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖いって。なかなか嫌な置き方してくんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 896310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 896320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほどね。そういうことするんだ。そういうことそういうこと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 903590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 903600,
    "dDurationMs": 4239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そういうこともできます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 904829,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 904839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そういうこともするんだ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 907949,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 907959,
    "dDurationMs": 3041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 909509,
    "dDurationMs": 1491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 909519,
    "dDurationMs": 2721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すごくね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 910990,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 911000,
    "dDurationMs": 2120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんなこと言うのもなんだが。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 912230,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 912240,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それは埋まるんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 913110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 913120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ホロライブの今ティア上位ぐらいの戦いを今してるんじゃないか、俺たち。い",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 918870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 918880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "や、わかんないよ。たちが勝てる手を見えてない可能性ある。ずっと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 923230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 923240,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに何も見てない可能性あるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 925470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 925480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。あ、あそこたらすぐ勝てんのになみたいな戦いが起こってる可能性。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 930389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 930399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。逆にめちゃめちゃ今可能性を残しまくってるってこと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 934949,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 934959,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。危な。こうしとこう。これさ、打ち続けたらさ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 945990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 946000,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "全面埋まることあるんかな?",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 948990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 949000,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、あるんじゃない?じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 950350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 950360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "勝負つかなすぎて",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 953550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 953560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あるんじゃね?あ、そこ行っても",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 960350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 960360,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 960590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 960600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "できなくね?あ、とか言って。え、いやいや。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 976110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 976120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "くそ、くそ、やった。じゃあ優勝優勝が",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 984749,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 984759,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあいいよ。ちなみに優勝した普通にもう数日後にペコラが誰かに奪われてるから優勝したい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 990829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 990839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、守ってくれよ。優勝の竿を。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 995910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 995920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。ということでね、じゃあこんな感じでそろそろ凸待ちしますか。本題の大富豪ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1002949,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1002959,
    "dDurationMs": 4041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行きますか?本当に。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1003990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1004000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、あめさ、文章考えてよ。ちょっとこのエブリまで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1008189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1008199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うええ。ええ、よ投稿していいの?これで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1013430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1013440,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あめが投稿していいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1015470,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1015480,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ。え、これスワードがいいんじゃない?いいの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1018230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1018240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、いや。スアルはね、もういや、あめか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1022470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1022480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、あめがした時にね、誰が来んだろうみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1026470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1026480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあちょっとエブリワンで書いちゃおう。怖ええ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1030150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1030160,
    "dDurationMs": 2039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どんな文章を送る?あ、やめ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1031630,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1031640,
    "dDurationMs": 2919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これにさ、エブ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1032189,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1032199,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "everyブリーワンで書いたことある。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1034549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1034559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと待って。あるに決まってね。なんだと思ってんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1038909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1038919,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、なさそうと思って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1040189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1040199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あるよ、あるよ。ありますともえ、タレントの方がいいのか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1045549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1045559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうだね。アエブリーワンだとスタッフさんにまで飛ぶ可能性があ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1049950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1049960,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。運営さんみんなに来ちゃうからね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1052150,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1052160,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1052870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1052880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "タレントで。ええ。な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1057870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1057880,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んで書くの?こういう時。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1060110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1060120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、こういう時さ、めっちゃそワそワするんだよな。なんて書いたらいいんだろうみたいな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1064750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1064760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、分かる。絶賛下山中。絶賛。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1076149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1076159,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、あり、あり。いいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1078110,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1078120,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいじゃん。いいじゃん。いいじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1079350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1079360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいじゃん。いいじゃん。て、お前は乗ってくんなよ。絶賛下山中に乗ってくんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1086149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1086159,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これさ、文字でかくすんのどうやってやんだっけ?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1088710,
    "dDurationMs": 2089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1088720,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、文字でかくすんのはなんかあの",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1090789,
    "dDurationMs": 531,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1090799,
    "dDurationMs": 2041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "B",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1091310,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1091320,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかコマンドあるよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1092830,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1092840,
    "dDurationMs": 2319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "コマンドある。コマンド。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1094070,
    "dDurationMs": 1089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1094080,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、な、何だっけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1095149,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1095159,
    "dDurationMs": 2801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんかさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1096750,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1096760,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか間に挟むんだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1097950,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1097960,
    "dDurationMs": 3839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう、そう、そう。な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1099510,
    "dDurationMs": 2289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1099520,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んだっけ?誰か",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "disccord",
      "tOffsetMs": 720,
      "acAsrConf": 0
    }, {
      "utf8": "詳しい?",
      "tOffsetMs": 1240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1101789,
    "dDurationMs": 2091,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1101799,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待ってない?コメント欄。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1103870,
    "dDurationMs": 4289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1103880,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Disccord",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "ord",
      "tOffsetMs": 560,
      "acAsrConf": 0
    }, {
      "utf8": "文字でかくする。",
      "tOffsetMs": 1760,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1108149,
    "dDurationMs": 2211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1108159,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかコマンドあるんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1110350,
    "dDurationMs": 2449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1110360,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "B",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "とかじゃなかったっけ?",
      "tOffsetMs": 199,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1112789,
    "dDurationMs": 1651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1112799,
    "dDurationMs": 1961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "B",
      "tOffsetMs": 201,
      "acAsrConf": 0
    }, {
      "utf8": "だっけ?",
      "tOffsetMs": 441,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1114430,
    "dDurationMs": 330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1114440,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1114750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1114760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ、これ、これ。えっと、あれでかくすんのどれだ?太くすんのあるわ。いや、でかくするやつだよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1125310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1125320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でかくするやつはあ、これ、これ、これ、これ、これ、これ。スクショで送るわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1131669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1131679,
    "dDurationMs": 4521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1133190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1133200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これだよね。はい。え、これだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1146590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1146600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、これかもんね。これかも。これかも。え、じゃ、シャープってばいいの?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1151270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1151280,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだ。シャープ。ジャープ、シャープだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1152830,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1152840,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1155710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1155720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、これでさ、来てくれる子な?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1159590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1159600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、絶賛下段中の意味がわからん可能性はあるよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1164710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1164720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ワンチャンちょっとさ、よたはさ、ネタにできるけど後輩の子たちはいじりにくいんちゃうか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1171510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1171520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、確か下山中って何ですか?とかて遊び回りたいの子たちはって全然可能性あるよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1179710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1179720,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あるね。あるね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1180830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1180840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それか悪意なく本当にこう配信してることが下山っていう意味合いと受け取っている可能性がある。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1189830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1189840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、それはその、ま、一旦ね、ま、誰が来たとしても何すかって聞かれたら",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1195190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1195200,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1195390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1195400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回あめがね、やっぱね、先輩として説明した方がいいんじゃない?それはこう共通ルールとしてこれから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1202669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1202679,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "教色説明から入るか。じゃあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1205669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1205679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう。まずね、あめの言う下山っていうのはい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1210149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1210159,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずね、まずねって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1212149,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1212159,
    "dDurationMs": 5121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まず怖くね。なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1214789,
    "dDurationMs": 2491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1214799,
    "dDurationMs": 5481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖いか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1217270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1217280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかでかい文字で優しい優しいよとか書いとこうぜ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1221950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1221960,
    "dDurationMs": 5599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、よ怖くないと思うけどな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1224549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1224559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや、今日のサムネ見たら怖えだろって。いや、でも実際ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1233070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1233080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でも誰が来るんだろう?あめが募集したらルイとかとね、よくやってるイメージあるけどね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1242029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1242039,
    "dDurationMs": 5281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ルちゃんはワンチャン来てくれんじゃない?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1244310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1244320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、来てくれそう。優しいからな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1248669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1248679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、優しいんだよね。気が使ってくれる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1252310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1252320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ちょっと今日誰が配信してるか見よう。今日結構すごかったぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1259510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1259520,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジ?あ、待って。これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1261029,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1261039,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人までって言った方がいいよね。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1262669,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1262679,
    "dDurationMs": 4521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうそうそうそう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1264909,
    "dDurationMs": 2291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1264919,
    "dDurationMs": 4801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人までです。",
      "tOffsetMs": 201,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1267190,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1267200,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "先着",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 440,
      "acAsrConf": 0
    }, {
      "utf8": "名。",
      "tOffsetMs": 599,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1269710,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1269720,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、先着",
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1270390,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1270400,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "名でそ入れ替えはなくていいの?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1272470,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1272480,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。先着",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 840,
      "acAsrConf": 0
    }, {
      "utf8": "名であの",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1840,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1274470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1274480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ずつでもかみたいな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1277669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1277679,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これあの急遽だからさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1279190,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1279200,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人までしかさ、",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1280990,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1281000,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれなんよ。そう。コラボできないからちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1283430,
    "dDurationMs": 3090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1283440,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "人ずつ",
      "tOffsetMs": 119,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 640,
      "acAsrConf": 0
    }, {
      "utf8": "人ずつ呼ぼうぜ。",
      "tOffsetMs": 760,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1680,
      "acAsrConf": 0
    }, {
      "utf8": "人ずつ。",
      "tOffsetMs": 1760,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1286510,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1286520,
    "dDurationMs": 1759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "人ずつ。",
      "tOffsetMs": 120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1287070,
    "dDurationMs": 1209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1287080,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃ、じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 599,
      "acAsrConf": 0
    }, {
      "utf8": "人ずつ、",
      "tOffsetMs": 719,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1079,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1288269,
    "dDurationMs": 2371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1288279,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ずつ呼んで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1121,
      "acAsrConf": 0
    }, {
      "utf8": "人、",
      "tOffsetMs": 1280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1290630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1290640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、操まうと誰かみたいな感じで大封合してさ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1294830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1294840,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、はいはいはいはいはい。そういうことね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1296630,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1296640,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それを回していくってこと。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1297710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1297720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。それ回してこうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1301990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1302000,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これでさ、待って、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1304070,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1304080,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "人可いそうじゃない?このおツ",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1306350,
    "dDurationMs": 130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1306360,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1306470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1306480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人でもかみたいな。我々おつじゃないからね。ちなみにサムネがちょっとおつぼ感あるかみたいな感じではあったけど別におつぼではないからね。おツではそう違うか。ずつでお願いします。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1325110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1325120,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "人か",
      "tOffsetMs": 200,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 799,
      "acAsrConf": 0
    }, {
      "utf8": "人ずつでお願いしますがいい。",
      "tOffsetMs": 960,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1327590,
    "dDurationMs": 689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1327600,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 120,
      "acAsrConf": 0
    }, {
      "utf8": "人か",
      "tOffsetMs": 240,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1328269,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1328279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人でお願いします。うーん。来いよ。来いよとかだめよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1341350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1341360,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1342470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1342480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しみだわ。お、なんと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1348230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1348240,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "投稿します。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1349149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1349159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ナイス。え、これさ、スクショしてさ、待",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1352510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1352520,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "て。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "お前さ、でかくなってねえ。",
      "tOffsetMs": 519,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1355230,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1355240,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でかくなってないんだが。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1357350,
    "dDurationMs": 2850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1357360,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おもろいからいいんじゃない?これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1360190,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1360200,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でかくしたいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1361830,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1361840,
    "dDurationMs": 3439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でか、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1363510,
    "dDurationMs": 1769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1363520,
    "dDurationMs": 4759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんででかくなんないの?これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1365269,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1365279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかんない。ちょ、やめ、これ。あの、あれしないと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1370590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1370600,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0
    }, {
      "utf8": "倍サーバーにおりますって書かないと。",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1373350,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1373360,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうそうそう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1375190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1375200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとこれみんなにスクショして。これみんなに見せるね。あめがどういう投稿したのか。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1386789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1386799,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん、いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1388950,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1388960,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、最悪誰も来なかったら",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 1480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1390549,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1390559,
    "dDurationMs": 4961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人で遊ぶから。このまま",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1393269,
    "dDurationMs": 2251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1393279,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "悲しい。何が悲しくてこ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1395510,
    "dDurationMs": 3169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1395520,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人でやらなかんの。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1399549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1399559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。なきさん、今頑張って投稿しました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1402830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1402840,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こちら",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1404870,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1404880,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "人か",
      "tOffsetMs": 159,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 560,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1405590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1405600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人でお願いします。こい、お前さ、癖強なお、お曲",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1412510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1412520,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1412669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1412679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人やめろで。それさ、お前、お前そんなことすんなてマジで。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1418909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1418919,
    "dDurationMs": 3721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃあ癖要用な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1421029,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1421039,
    "dDurationMs": 3441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人って削っとくわ。じゃあ",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1422630,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1422640,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。削っといて。危ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1424470,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1424480,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おつ削っといた。じゃあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1426110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1426120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、もうここまで来たらなんかチョコ戦もおつ骨ってことにして",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1429390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1429400,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    }, {
      "utf8": "人で勝手におつしとくしかない。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1431990,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1432000,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。うつぼ",
      "acAsrConf": 0
    }, {
      "utf8": "3",
      "tOffsetMs": 960,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1433190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1433200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人に混ざれる勇気ないだろう。の子たちは。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1437669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1437679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもさ、なんかさ、わかんないじゃん。普通にさ、あの、今ふちゃんたちのコラボが終わったから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1445029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1445039,
    "dDurationMs": 4041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃあワンチャン。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1446070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1446080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。ワンチャン。その、あの、だからこのメンバーの誰かが来てくれるかもしれないし、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1453710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1453720,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、来ないかもしれない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1454870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1454880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しれないしみたいな。ちなみに大きくコマンド調べよう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1461830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1461840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あめってさ、凸待ちした時さ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1465070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1465080,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1465990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1466000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか誰がさ、なんか、誰と喋った記憶あんの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1471070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1471080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でかそれこそさ、遊び対人でやったのが初めてなんだよ、多分。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1474950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1474960,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうなんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1476590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1476600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうで、でもみこちとか来てくれたよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1480310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1480320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "みこちな、明日な。ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1483870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1483880,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そっか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1484830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1484840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "みこちは今日で来れないんすわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1489070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1489080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ニコちぶりだ。今日は忙しいもんね。忙。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1493909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1493919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあちょっと遊んで待ってるか。おい、ボクシングしようぜ。あ、文字でかくできた。見て見て見て見て。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1500029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1500039,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、どこ?ほんま?いや、もちでか。お前さ誰か誰か来たじゃなくて文字でかくできたじゃねえんだよね。やばい。まれちゃんからチャットで絶賛下山中。てんてんてんてん。笑ってきたんだけどやばいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1517230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1517240,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まねちゃんに苦笑いされてる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1519430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1519440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも良かったやん。まネちゃんもなんかほの物してんじゃないの?なんかあ、あめさん今日は下山の日なんすねみたいな。なんかそういう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1527310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1527320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちゃんね、すごい配信見てくれてるんだよね。優しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1531029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1531039,
    "dDurationMs": 3721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうなの?いいやん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1532510,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1532520,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。なんかね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1534750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1534760,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いつも配信中にチャットくれる見てる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1537750,
    "dDurationMs": 2929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1537760,
    "dDurationMs": 4799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "配信中にチャットくれんの?え、ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1540669,
    "dDurationMs": 1890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1540679,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんてくれんのつも?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1542549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1542559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、こないだはあのまねちゃんの引き継ぎのやつやってたのよ。紹介してたから多分見てくれて",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1549909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1549919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかコメントくれてたんだけどうん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1553470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1553480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなんか恥ずかしいですみたいな紹介されてる時に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1557789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1557799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほどね。そのままちゃんが行き過ぎので自分が紹介されて恥ずかしいですみたいなね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1561870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1561880,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうそうそうそう。そんな感じだった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1563830,
    "dDurationMs": 2170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1563840,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、なんかスタンプ来てるぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1565990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1566000,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、泣いてるぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1567350,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1567360,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "数が泣いてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1569190,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1569200,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、行けないんじゃない?これ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1570750,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1570760,
    "dDurationMs": 2639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。行けないんだよ。ま、ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1572830,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1572840,
    "dDurationMs": 2120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1573389,
    "dDurationMs": 1571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1573399,
    "dDurationMs": 2921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわあ、まジか。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1574950,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1574960,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回チーニしとくかな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1576310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1576320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。チーニしてゲームしよう。楽しそうにしてたらなんか来てくれるかもしれ誰か。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1579909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1579919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かに世たちが楽しそうな雰囲気。やっぱアットホームな職場感を出してもう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1584950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1584960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前選ぶワードが全部最悪なの何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1588950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1588960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え?選ぶワードが全部全部最悪なの選ぶや。お前どうなってんだ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1595149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1595159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいし、いいでしょ。職場魔環境もいいでしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1598230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1598240,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "環境はいいよね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1599669,
    "dDurationMs": 1651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1599679,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。いいでしょうよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1601310,
    "dDurationMs": 1489,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1601320,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "トイボクシングしようぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1602789,
    "dDurationMs": 1971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1602799,
    "dDurationMs": 2521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、トイボクシングですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1604750,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1604760,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1605310,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1605320,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ギスギんで、これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1607230,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1607240,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ギスギんで、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1609590,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1609600,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1610830,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1610840,
    "dDurationMs": 5319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これもう普通に殴り合いになるで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1613750,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1613760,
    "dDurationMs": 5399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ誰が混ざれるの?これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1616149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1616159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いえ、大丈夫、大丈夫。楽しくやっていんだけど。これ遊び対善だから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1620029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1620039,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。じゃあ、あそ、じゃ、た、楽しい雰囲気で取。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1623950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1623960,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、あの、なんか、あの、大きな声とか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1626070,
    "dDurationMs": 650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1626080,
    "dDurationMs": 2479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "NG",
      "acAsrConf": 0
    }, {
      "utf8": "ね。",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1626710,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1626720,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "大きな声とか",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1628549,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1628559,
    "dDurationMs": 2921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "暴力的な言葉",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "NG",
      "tOffsetMs": 961,
      "acAsrConf": 0
    }, {
      "utf8": "ね。",
      "tOffsetMs": 1161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1629909,
    "dDurationMs": 1571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1629919,
    "dDurationMs": 4081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうそうそうそうそう。強い言葉。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1631470,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1631480,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "NG",
      "acAsrConf": 0
    }, {
      "utf8": "ね。なしね。早くない?",
      "tOffsetMs": 319,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1633990,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1634000,
    "dDurationMs": 1120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1634510,
    "dDurationMs": 610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1634520,
    "dDurationMs": 1000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1635110,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1635120,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1635510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1635520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "痛い、痛い、痛い、痛い、痛い。えい、えい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1639190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1639200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "痛い、痛い。えい、えい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1642669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1642679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ツンツンツンツンツンツンツンツンツンツンツンツンツンツン。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1651389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1651399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてよ。はめちゃんやめてよ。え、やばい。スまるが思い出される。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1658870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1658880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ツンツンツ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1664190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1664200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうあめちゃんば",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1669230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1669240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。あめちゃんって呼ばれてちょっとかなり同揺してしまった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1674269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1674279,
    "dDurationMs": 5041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにあめちゃんって",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1677029,
    "dDurationMs": 2291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1677039,
    "dDurationMs": 4441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あやめちゃんって言われたこと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1679310,
    "dDurationMs": 2170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1679320,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれそんなに呼んでなかったっけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1681470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1681480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、最初総初期ぐらい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1684710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1684720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "総初期初めっちゃ早いってことね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1687950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1687960,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "ヶ月とかね、",
      "tOffsetMs": 280,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 1439,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1689669,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1689679,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヶ月。ま、それぐらいじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1691350,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1691360,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そういうこと。え、そんなに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1692870,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1692880,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初期うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1694230,
    "dDurationMs": 1890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1694240,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなに呼んでなかったか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1696110,
    "dDurationMs": 1289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1696120,
    "dDurationMs": 4279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そうだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1697389,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1697399,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃあ、え、じゃ、これもうマジ急に弱くなった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1701669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1701679,
    "dDurationMs": 2761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、トイトイカーリングをしようぜ。あ、もう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1704350,
    "dDurationMs": 90,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1704360,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1704430,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1704440,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回やれ。いいよ、いいよ、いい。え、ちょっと待ってね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1706870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1706880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フレンドと遊ぶのやめますか?やめて。その切断しようとすんのやめて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1714070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1714080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前勝てない。勝てないからってさ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1717789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1717799,
    "dDurationMs": 4401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "負けで切断するやつなんか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1720389,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1720399,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてやめて。さすがに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1722190,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1722200,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃあやめますね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1723509,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1723519,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "や、やめますね。じゃないんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1728750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1728760,
    "dDurationMs": 1399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1729549,
    "dDurationMs": 610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1729559,
    "dDurationMs": 1641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "俺やろうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1730149,
    "dDurationMs": 1051,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1730159,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "アホッケー行きますか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1731190,
    "dDurationMs": 2329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1731200,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "エアホッケーやろうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1733509,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1733519,
    "dDurationMs": 3801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これも仲良くですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1734830,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1734840,
    "dDurationMs": 5559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これも仲良くしよう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    }, {
      "utf8": "点マッチでね。",
      "tOffsetMs": 1319,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1737310,
    "dDurationMs": 3089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1737320,
    "dDurationMs": 4479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 79,
      "acAsrConf": 0
    }, {
      "utf8": "点マッチで行きますか。じゃあ",
      "tOffsetMs": 199,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1740389,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1740399,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1741789,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1741799,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行きます。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1744590,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1744600,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1745990,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1746000,
    "dDurationMs": 1880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1747070,
    "dDurationMs": 810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1747080,
    "dDurationMs": 1520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どっちがどっち?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1747870,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1747880,
    "dDurationMs": 1080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1748590,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1748600,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1748950,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1748960,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これヨが青うかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1750310,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1750320,
    "dDurationMs": 2640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1751630,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1751640,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1752950,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1752960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてよ。危ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1754590,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1754600,
    "dDurationMs": 2439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、やめてよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1755950,
    "dDurationMs": 1089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1755960,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1757029,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1757039,
    "dDurationMs": 2961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1758710,
    "dDurationMs": 1290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1758720,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、危ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1759990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1760000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それそれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1763310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1763320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それよし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1771389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1771399,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうすまるちゃんやめてよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1773470,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1773480,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。やばい。動揺する。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1774950,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1774960,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいよ。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1777870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1777880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうやめちゃんてばいいつもの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1781070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1781080,
    "dDurationMs": 2079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つまるちゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1782070,
    "dDurationMs": 1089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1782080,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1783149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1783159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つまるちゃんてばダメ。変なダメージダめて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1789149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1789159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。精神に来る。もうやめちゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1793990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1794000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわあ。スまるちゃんナイス。スまるちゃんありがとう。優しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1798669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1798679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何がなんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1801909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1801919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと危ない危ない危ない危ない危ない危ない危ながで危ないがつで危ない危ない",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1811110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1811120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えどういうことあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1816789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1816799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてよめちゃんそんなああああやばいちゃん付けで呼ばれるとやばいよったよも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1829870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1829880,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もやだ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1831350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1831360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてよ。すまれちゃう。ああ、やめちゃやめちゃやった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1848350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1848360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "汚れ声汚れ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1854110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1854120,
    "dDurationMs": 4039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。弱点全部弱点。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1856909,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1856919,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "全部。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1858149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1858159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、スバちゃん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1861470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1861480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あやめちゃん。やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1867629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1867639,
    "dDurationMs": 2681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいやばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1868590,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1868600,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいやばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1870310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1870320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前こんなんもう誰もさ、来てくるね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1873669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1873679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来てくんないよ、こんなの。うまい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1879629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1879639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おしやかにって話。おやかにしよ。ちょ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1882470,
    "dDurationMs": 169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1882480,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1882629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1882639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回さ、なんかさ、もっとさ、なんかなんか別のゲームするか。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1887950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1887960,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何?何がいい?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1888870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1888880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何があるかな?うーん。え、何する?でも大富を始めちゃうとね、結構もうあれだから長いからサクっと割るやつがいいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1904310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1904320,
    "dDurationMs": 5319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1906629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1906639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何がいいかな?ちょっとその辺長いから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1910070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1910080,
    "dDurationMs": 4599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "長いね。これは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1912110,
    "dDurationMs": 2569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1912120,
    "dDurationMs": 5559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "野球は野球。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1914669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1914679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、今さ、野球のルール、え、野球そ長いんじゃないの?あれ?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1917750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1917760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "野球長いか?え、そのさ、右にさ、右に行くとさ、右にそのタンクは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1926750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1926760,
    "dDurationMs": 3759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これいいんじゃない?これいいんじゃない?いいんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1928190,
    "dDurationMs": 2329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1928200,
    "dDurationMs": 3839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これいいよね?これちょうどいい。タンク",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1930509,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1930519,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しゃ行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1932029,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1932039,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもさ、ルールちょっと確認しいすか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1935590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1935600,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1938110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1938120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これを打って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1942750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1942760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1944149,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1944159,
    "dDurationMs": 4601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これルールわかんの?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1945750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1945760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ルール分かる?これ猫松さんに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1949230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1949240,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "死ぬほどボされたから全部覚えてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1951669,
    "dDurationMs": 2531,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1951679,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、これや強そう。これ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1954190,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1954200,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これガチで強えぞ。あいつ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1955909,
    "dDurationMs": 2411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1955919,
    "dDurationMs": 4281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ガチ強そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1958310,
    "dDurationMs": 1890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1958320,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、な、なんか、え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1960190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1960200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんかボムみたいのけて混んでなかった?今。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1963629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1963639,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "B",
      "tOffsetMs": 321,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1964190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1964200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かなんかやるとね、あのね、でかい弾がボンって落ちるんよな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1968269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1968279,
    "dDurationMs": 3441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "へえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1968990,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1969000,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ステージ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 279,
      "acAsrConf": 0
    }, {
      "utf8": "がいいぞ。",
      "tOffsetMs": 440,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    }, {
      "utf8": "でかいから。",
      "tOffsetMs": 1480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1971710,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1971720,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃあワンで行きましょう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1973470,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1973480,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1974990,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1975000,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1976070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1976080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみに誰からもまだね、来てません。ちょ、ちょ、何もノータッチですね、皆さん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1983389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1983399,
    "dDurationMs": 5601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ノータッチ。ノータッチです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1986230,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1986240,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これで、あ、あ、こう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1988990,
    "dDurationMs": 2610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1989000,
    "dDurationMs": 4519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、これバウンドするの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1991590,
    "dDurationMs": 1929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1991600,
    "dDurationMs": 4919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、バウンドする。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1993509,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1993519,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ攻め込んで当てればいいの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1997950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 1997960,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2000350,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2000360,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そらに当てたらいいってこと?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2002070,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2002080,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2004190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2004200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危な、危な、危な。そう。それ、それどうやってあんの?それどうやってんの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2008110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2008120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねえ、それ、それどうやってんの?それにもこれか?これか?これだ。危、危、危、危ない、危ない、危ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2016950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2016960,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これだな、これだな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2018110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2018120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よっしゃ。こうなったら攻め込むんや。あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2022950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2022960,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、あ、これリスキルできるってこと?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2025029,
    "dDurationMs": 2091,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2025039,
    "dDurationMs": 5081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、リスキルできる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2027110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2027120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オプ、オプ、オプリスキルやた。よし、行け。今だ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2037110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2037120,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今や。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2037789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2037799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。危ね。危ない、危ない、危ない、危ない。おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2047389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2047399,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ぬるっと負けたんだけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2049069,
    "dDurationMs": 1651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2049079,
    "dDurationMs": 4641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2050710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2050720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかあの祭りが泣いてて数が泣いててあの累があびしてる利",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2059990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2060000,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい見てんじゃねえよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2061829,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2061839,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい誰か来てそれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2063909,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2063919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "このままだとこのままだと俺たちがただ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2068030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2068040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ただ遊んでるだけになっちゃうよ。たちが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2071149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2071159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人脈じ徳がないことがバれてしまう。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2075270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2075280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2078389,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2078399,
    "dDurationMs": 2841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、なんかお、おがしてくれてる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2081069,
    "dDurationMs": 171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2081079,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2081230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2081240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ともいい先輩です。全く怖くないので安心して。余計怖えんだよ。バカ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2086669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2086679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、なんか余計に晴れ物みたいになってるよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2091950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2091960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか余計怖くね?怖く見えますが全く怖くありません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2099030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2099040,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖く見、怖く見えてんのか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2101030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2101040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え?怖く見えてんの?これで全く怖くありません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2111270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2111280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、だからアットホームな職場やめろて。なんでよ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2115790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2115800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前アットホームな職場好きすぎるだろ、これ。今こういう感じになってます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2126230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2126240,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これね、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2127270,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2127280,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来てくれるかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2129390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2129400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来てくれるかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2132670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2132680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、あのさ、後輩ちゃんたちとはさ、もうお話とかしたの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2137150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2137160,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "してない。した?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2138750,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2138760,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、してない。してない",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2141030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2141040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でしょうね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2144950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2144960,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、どういうことだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2146430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2146440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、だってだって。いや、これで、あめが喋ったよとか言ったらなんか、え、すっごいみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2153349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2153359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、あめそうなんだみたいになるよ。本当に意外とあるんだってなるよね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2158870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2158880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう。なんか累が戦法確認中とか言って戦法確認じゃ。おい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2165510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2165520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ガチわろた。ちょっと次のゲームやろうぜ。次のゲーム",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2172270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2172280,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何やる?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2173349,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2173359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。次はま、じゃあ一旦一旦",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2177829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2177839,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これで解放したいな。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2179349,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2179359,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、解放できねえんだよ、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2180710,
    "dDurationMs": 1369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2180720,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんでかって言うと、これ",
      "acAsrConf": 0
    }, {
      "utf8": "3",
      "tOffsetMs": 1160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2182069,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2182079,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人以上とかだから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2183670,
    "dDurationMs": 1290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2183680,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、そういうことか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 919,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2184950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2184960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "か。え、じゃあ、え、じゃ無理やん。ちょっと来てくれないとここら辺できないんだってこと。そう。左行って",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2191390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2191400,
    "dDurationMs": 2959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2191589,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2191599,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人でちょっとあのスペスピードスペードやろうぜ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2194349,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2194359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、スピード。あ、いいんじゃない?いいんじゃない?スペードってどんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2198630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2198640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "右から。そう。もっと右の右の右。それそれそれそれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2203150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2203160,
    "dDurationMs": 5679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、これ超よ。遅いんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2205829,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2205839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかる。これむずいんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2210150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2210160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "とっさに出せないよ、これ。か、ジョーカーはありでいいすか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2215309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2215319,
    "dDurationMs": 5921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。オケー。行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2218230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2218240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2221430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2221440,
    "dDurationMs": 1919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しげな雰囲気でね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2223109,
    "dDurationMs": 250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2223119,
    "dDurationMs": 1321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2223349,
    "dDurationMs": 1091,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2223359,
    "dDurationMs": 1921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しげな",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2224430,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2224440,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しそうにね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2225270,
    "dDurationMs": 2610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2225280,
    "dDurationMs": 4039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2227870,
    "dDurationMs": 1449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2227880,
    "dDurationMs": 4439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何にも出せないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2229309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2229319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、出せるカードないんだけど。どうしようかな。出る。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2233829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2233839,
    "dDurationMs": 4921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうしよっかな。え、あ、出せるカードがない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2236309,
    "dDurationMs": 2451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2236319,
    "dDurationMs": 5121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出せるカードがないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2238750,
    "dDurationMs": 2690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2238760,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出せるカードがないよ。出せるカード。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2241430,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2241440,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出せるカードがないよ。出せるカードがいないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2244150,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2244160,
    "dDurationMs": 4199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出せるカードがないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2245950,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2245960,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ないよ。ないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2248349,
    "dDurationMs": 1131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2248359,
    "dDurationMs": 4121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2249470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2249480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出してほしいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2252510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2252520,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出せるカードがないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2254230,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2254240,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "カードがないよ。えん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2256870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2256880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええんはなんで出せやねん。あ、出せるカードがないや。あ、出せなくなっちゃった。やだ。うざすぎる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2267390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2267400,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うざすぎるやめて。うざいやすぎる。やめて。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2270309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2270319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出せるカードがない。あ、あっよ。出せるカードない。早く出やめろ。やめろ。やめろ。やめろ。やめろ。やめろ。お前やめろって。今出してんだろう。て。出せてんだろて。ずやばい。やばい。やばい。やってん。やってんの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2287150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2287160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早く出してよ。やめちゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2290190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2290200,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと待ってよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2291670,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2291680,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早く出してよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2293030,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2293040,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい、やばい。出せないよ。は。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2295390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2295400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんで負けてんの?え?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2300270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2300280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、なんで負けた?ちょっと待って。わかんないな。なんで今負けた?なんで今負けた?なんで?今負けた。え?んで?な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2305630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2305640,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んで?ん?ん?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2307630,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2307640,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?あれ?あれ?あれ?な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2308510,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2308520,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んで勝ったかもわかんないんだけど。今な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2310510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2310520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んで負けた?今は書いた",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2315109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2315119,
    "dDurationMs": 5401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねえ。言葉が強いよ。な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2317510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2317520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んでさ、なんで今の負けたん?マジでなんかぬるっと負けたわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2320910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2320920,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジるっと勝ってた",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2322910,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2322920,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。ぬるっと勝った。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "神経衰弱でもやる。",
      "tOffsetMs": 1399,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2325790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2325800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっとさ、あれやろうよ。そのさ、コメントのみんなにさ、どう改善点をさ、聞いてさ、改善しようぜ。この何で来てもらえないかっていう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2334829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2334839,
    "dDurationMs": 1841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これを。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2335190,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2335200,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、いいね。フィードバックもらう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2336670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2336680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。フィードバック。お前横文字好きだね。あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2341069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2341079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "アットホームなの?フィードバックだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2344309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2344319,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。フィードバックもあろうぜ。フィードバック。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2346309,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2346319,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フィードバックいただきまし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2347670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2347680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "みんなどういう点がさ、どういう点が改善した方がいい?これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2351589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2351599,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "み、みんなコーチコーチなんで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2353309,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2353319,
    "dDurationMs": 2481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "コーチね、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2354470,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2354480,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "コーチみんな教えてください。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2355790,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2355800,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フィードバックしてくれ。す、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2357030,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2357040,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバトのみんな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2358630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2358640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、これスバトだけじゃないから押し付けんのやめて。スバト。あ、そっか。泣き、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2363630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2363640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ絶対泣きり組来てるだろ。絶対泣きり組めんどく。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2369910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2369920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、なんかもう結構ようお邪魔してる身だからね。ちょっとスの割合多いかなみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2375390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2375400,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。なるほどね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2376750,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2376760,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。どうすか皆さん?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2378990,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2379000,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "タイミングが悪い可能性。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2381430,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2381440,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2382150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2382160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、まあまあ、今ちょっと混んでますしね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2385589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2385599,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2385790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2385800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人で歓迎しますって言おう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2389390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2389400,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2389550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2389560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人で歓迎します。景品がない。もっとアットフォーム出してこう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2397510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2397520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、もっとアットホーム感を出すって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2400550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2400560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何?アットホーム感って何?え、な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2405870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2405880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んで今日にしたのとか言われてんだけ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2408670,
    "dDurationMs": 210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2408680,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2408870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2408880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかま、色々あって、色々あって、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2412150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2412160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "色々あって、じゃあ今日やるみたいなって今日やること",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2416030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2416040,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうやね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2416829,
    "dDurationMs": 2571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2416839,
    "dDurationMs": 4561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "呼び込みしようぜ。呼び込み。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2419390,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2419400,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "呼び込み鳴らすしかないな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2421390,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2421400,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何だっけ?呼び込みて。ててて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2424270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2424280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃあやべ。呼び込み役ね。て。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2427510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2427520,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、スバルが呼び込むわ。言って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2430030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2430040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "てててえ。あ、でただいまなんと中。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2437870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2437880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あやめ下山中。こんな機会めったない。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2441790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2441800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来るなら今、今、今、今、今、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2448309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2448319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "誰も来ないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2454670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2454680,
    "dDurationMs": 5919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。読み込みずっとやば。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2457589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2457599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "読み込み役ねとか言って",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2463950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2463960,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2464150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2464160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "年目にして初めて読み込み役やったわ。ああ。あとなんかないかな?他になんかアットホームヒートないすか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2475870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2475880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あめの思うアットホーム感って何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2479069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2479079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えーでもやっぱ雰囲気が名やかな感じじゃないの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2483309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2483319,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "名やかな感じか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2485309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2485319,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱ強い言葉とかはないよね",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2488309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2488319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え。じゃあちょっとなんか会話するか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2492030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2492040,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "会話?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2492750,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2492760,
    "dDurationMs": 3559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。なんか名やかな会話しようよ。あめ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2495630,
    "dDurationMs": 689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2495640,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "な話?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2496309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2496319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あやめちゃんって今日",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2499670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2499680,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2500309,
    "dDurationMs": 971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2500319,
    "dDurationMs": 3961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2501270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2501280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最近何してんの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2504870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2504880,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日今日最近何してる?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2507230,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2507240,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかんねえ。名かな会話って何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2509710,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2509720,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "名かな会話がわかんないな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2511790,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2511800,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかんない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2512270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2512280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最近なんかあ、え、無理して話してない。無理して話してないだろ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2519670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2519680,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2521589,
    "dDurationMs": 451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2521599,
    "dDurationMs": 2121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2522030,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2522040,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "中身がないと言われてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2523710,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2523720,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そういうこと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2525270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2525280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、中身を持った会話をしろってことか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2528470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2528480,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "中身が。うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2530390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2530400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃ、じゃあじゃ、じゃ、じゃ、じゃ、じゃ、この後輩ちゃんたちが来た時の遠くで聞かない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2536829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2536839,
    "dDurationMs": 3441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、いいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2537270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2537280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。歓迎、歓迎ムードをさ、出していかないと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2540829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2540839,
    "dDurationMs": 2041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、文字書いとくわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2542390,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2542400,
    "dDurationMs": 2280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2542870,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2542880,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "な、なんて書いとこう?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2544670,
    "dDurationMs": 1889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2544680,
    "dDurationMs": 4879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "トークデッキもありますみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2546549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2546559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、初心者歓迎。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2550710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2550720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初心者未経験者関係未経験者関係",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2554950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2554960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "未経験者未経け歓迎で黒文字にしてさでカデカと出しとくわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2566430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2566440,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2567990,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2568000,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あり",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2569950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2569960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "背景赤にしてこうね。トンパーやめて。新人つしじゃないから。よたち",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2574870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2574880,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "トンパやばいだろ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2577790,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2577800,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オレンジジョスあげることになっちゃう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2580270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2580280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見て。あめ。配信画面見て。赤字で出してみた。どう?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2586349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2586359,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "信画詰めて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2589069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2589079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これどう?ずれえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2595109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2595119,
    "dDurationMs": 5761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ、これ気づれ。い",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2598030,
    "dDurationMs": 2850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2598040,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "や、他になんか来そうなワード考えようぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2600870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2600880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわあ。何かな?え、でも確かに未経験は必要だよね。遊びたいじゃちょっと自分やったことないんだよなみたいな子も",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2610430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2610440,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。アットホームな職場です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2612390,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2612400,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2615190,
    "dDurationMs": 290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2615200,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2615470,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2615480,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "自分でも使うんか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2616670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2616680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや、あめがめっちゃさ、押してたからつけとこうかなと思って。これ中央にして",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2622190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2622200,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "文字の割合えぐい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2624150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2624160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにのえぐい。あ、えぐいよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2629069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2629079,
    "dDurationMs": 4921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こうして。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2630990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2631000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、あと何かな?ワード。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2634230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2634240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、シンプル分かりにくい可能性あるからと待ちって書いて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2638309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2638319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かにみんな分かってない可能性あるよね。凸待ちだって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2641390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2641400,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう、そう、そう、そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2642870,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2642880,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これって",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 840,
      "acAsrConf": 0
    }, {
      "utf8": "人の何なんだろう",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2645230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2645240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ですみたいな。何なんですかみたいになってる可能性あるからとま中ですって書いとこう。中です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2652750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2652760,
    "dDurationMs": 3359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これにして楽しそうに",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2655390,
    "dDurationMs": 729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2655400,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2656109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2656119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、七並べでもするか。これ下に出す。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2659230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2659240,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱ楽しいですって書いといた方がいいんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2661870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2661880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱ楽しくないのかなって思う。思われたらで楽しいですって書くのやばいって。お前",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2670030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2670040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや大事だよ。その簡単なことからもう伝えていくっていう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2675390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2675400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これやばいよ。やべ、見てみ。自分でこれ今出したけどさ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2681030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2681040,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "これ誰も来たくない。",
      "tOffsetMs": 720,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2683430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2683440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これいよ。楽しいですって。楽しいです。やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2691230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2691240,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいです。やばいよね、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2693030,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2693040,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいです。やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2694430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2694440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか言わされてる感やばいよね、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2698510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2698520,
    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これやばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2700190,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2700200,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "級",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2700750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2700760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "万円バカ野郎。そんな関係ねえだろ。バカ野。バカ野郎。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2704230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2704240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "バカ野郎。じゃあこれで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2707829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2707839,
    "dDurationMs": 2801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回するか。",
      "tOffsetMs": 201,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1681,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2709710,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2709720,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回やるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2710630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2710640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ロボちゃんなんか風呂に入ってるリラックスってスタンプ押しててく。どういうどういうかあ、今風呂中なんだろ。ぼちゃんこれ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2720150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2720160,
    "dDurationMs": 4919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ風呂出たら来てくれんのかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2722069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2722079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいやいや、今これ入り立てだったらどうすんだよ。ちょっとあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2727710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2727720,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 119,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2727950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2727960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回大富豪しようぜ。こういうもんだよ、大富豪ってみたいな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2730990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2731000,
    "dDurationMs": 4119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かに大富豪のルールを知らない可能性ある。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2733790,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2733800,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そうだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2735109,
    "dDurationMs": 1851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2735119,
    "dDurationMs": 4841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2736950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2736960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のル知らない可能性あるがあニャさんがなんか探偵探偵みたいなアーニャさん",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2743270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2743280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもこれのボちゃんの風呂覗いてるみたいになっててやばい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2747950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2747960,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "親みたいな",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2748990,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2749000,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "親ってなってる",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2749990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2750000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "親風呂ですかみたいな顔になってるからねみんななんかおい楽しんじゃってるやん俺たちが遊んでないよたちで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2761390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2761400,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねちょっとま",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1199,
      "acAsrConf": 0
    }, {
      "utf8": "回やってさ",
      "tOffsetMs": 1320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2764549,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2764559,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2765109,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2765119,
    "dDurationMs": 2561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大富豪ってやつを見せてやろうぜ。ちょ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2767109,
    "dDurationMs": 571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2767119,
    "dDurationMs": 2761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5",
      "acAsrConf": 0
    }, {
      "utf8": "ラウンド。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2767670,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2767680,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "この",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 960,
      "acAsrConf": 0
    }, {
      "utf8": "ラウンドですか?",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2769870,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2769880,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 160,
      "acAsrConf": 0
    }, {
      "utf8": "ラウンドクソ投げえから",
      "tOffsetMs": 320,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1439,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2771470,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2771480,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ラウンドやろうぜ。ちょっと",
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    }, {
      "utf8": "回。これ",
      "tOffsetMs": 1160,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 2240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2773950,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2773960,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ないから。",
      "acAsrConf": 0
    }, {
      "utf8": "5",
      "tOffsetMs": 680,
      "acAsrConf": 0
    }, {
      "utf8": "か",
      "tOffsetMs": 840,
      "acAsrConf": 0
    }, {
      "utf8": "10",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "しかないから。これ",
      "tOffsetMs": 1280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2776470,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2776480,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最初",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 359,
      "acAsrConf": 0
    }, {
      "utf8": "だ。",
      "tOffsetMs": 560,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2777430,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2777440,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。最初",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "5",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "だから。",
      "tOffsetMs": 1200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2780190,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2780200,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これルールはやりあり。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2782510,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2782520,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やりあり。スペード",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2784190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2784200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回しはちょっとホロライブには難すぎるなし。え、縛りなし。宮",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2790230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2790240,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あり",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2790950,
    "dDurationMs": 2609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2790960,
    "dDurationMs": 6359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まありだけど大丈夫?うわ、宮んだっけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2793549,
    "dDurationMs": 3770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2793559,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "宮り。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "でも、ま、",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1641,
      "acAsrConf": 0
    }, {
      "utf8": "回だけだからね。",
      "tOffsetMs": 1800,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2797309,
    "dDurationMs": 1451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2797319,
    "dDurationMs": 4441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "心地って何だっけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2798750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2798760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、不豪が、あの、大富豪が大富豪じゃなくなった段階で再下決定みたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2805430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2805440,
    "dDurationMs": 4399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。はいはいはい。なるほどね。ああ、はいはい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2807910,
    "dDurationMs": 1929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2807920,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2809829,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2809839,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2811069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2811079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、やりますか。まずお手本がこんなもんだよってね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2815470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2815480,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。楽しいよ。大富豪っていう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2817829,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2817839,
    "dDurationMs": 4041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。すっごい楽しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2819510,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2819520,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいよね。あめちゃん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2821870,
    "dDurationMs": 4170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2821880,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "大福をよくとやろうよ。",
      "tOffsetMs": 1160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2827950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2827960,
    "dDurationMs": 2639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいな。大富豪",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2830109,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2830119,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切られた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2830589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2830599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しきマジ切られたわ。なんで?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2835390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2835400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あー。えー、どうしよっかな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2843630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2843640,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、あめちゃんの番だよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2846510,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2846520,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうすか?ちょっと飛んじゃったけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2849230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2849240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2852270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2852280,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そういうこちなみに結構手札いいから。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2855190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2855200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おおっと。いや、これはもう使いたくないけどな。さあ、やめからまあまあそれ出してくると。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2866870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2866880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあまあ優しいよ。優しく行きましょう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2870230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2870240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。うわあ。お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2878309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2878319,
    "dDurationMs": 3681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうだ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2879430,
    "dDurationMs": 2570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2879440,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "結構行きます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "すね。どうだ。",
      "tOffsetMs": 1119,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2881990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2882000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわあ、これどうしようかな。いやーやいやんやんやんや。パズで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2888670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2888680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "パズね。なると、ま、一旦優しく始めましょうということになるんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2896589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2896599,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう、そう。アットホームでお願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2898589,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2898599,
    "dDurationMs": 2281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "アットホームなね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2899750,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2899760,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。アットホーム助かる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2900870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2900880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。アットホームな職場ですという。で、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2904150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2904160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こういう優しい手札も存在してます。優しくない。優しくない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2909190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2909200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2913630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2913640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、どうしようね。パスね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2918990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2919000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわあ、これ出せるんすか?うー",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2929270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2929280,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2931670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2931680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、これは一旦うんち、これは一旦ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2934789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2934799,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、これ持ってますね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "じゃ、",
      "tOffsetMs": 1320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2937829,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2937839,
    "dDurationMs": 1681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2938549,
    "dDurationMs": 971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2938559,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "パス",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2939510,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2939520,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だってジョーカーあるんだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2941750,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2941760,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ある、ありにしてる。ありにしてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2942870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2942880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ジョーカーありだもんね。はい。はい。こうして。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2949390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2949400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "誰持って?誰持ってんの?ジか。これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2955150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2955160,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行け。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2957950,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2957960,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわー。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2958870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2958880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、お前持ってんのか?誰持ってんのとか言って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2962510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2962520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "誰?誰?うわ、なんてこと?楽しいな。大富豪、大富豪楽しいな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2976870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2976880,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、よう置いていかんでくれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2979430,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2979440,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "NPC",
      "acAsrConf": 0
    }, {
      "utf8": "と戦だよ。",
      "tOffsetMs": 639,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2981190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2981200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに何にもわからんくて画面終わる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2986390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2986400,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何も画面終わらへんがわからんやんけ。これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2988710,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2988720,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何にもわからんくて画面終わる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2990710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2990720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これちょっとあめ頑張れ。負けるな。お、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2994549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2994559,
    "dDurationMs": 3481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "CPU",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "に負けるな。う",
      "tOffsetMs": 481,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2998150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2998160,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わ、これ負け。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 2998950,
    "dDurationMs": 2849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 2998960,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これも行けそうじゃない?その何残してんの?ちな。あ、行けた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3001789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3001799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、ナイス、ナイス、ナイス、ナイス、ナイス、ナイス、ナイスナ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3006270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3006280,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "良かった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3006750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3006760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいね。どう?あめ。大富豪楽しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3010710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3010720,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うおん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3012990,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3013000,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお、お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3014190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3014200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お。なんか置いてかれちゃったな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3020309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3020319,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか置いちゃうとな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3021829,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3021839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあま、一旦ね、強いカードもらって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3025150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3025160,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 159,
      "acAsrConf": 0
    }, {
      "utf8": "枚だけだね。",
      "tOffsetMs": 360,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3026470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3026480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。あー、いいっすっね。いいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3031390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3031400,
    "dDurationMs": 5159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいっすね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3033549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3033559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "凸はあって凸来ねえよ、誰も。凸来ねえよ誰も。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3037069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3037079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、来ねえよ、誰も。なんかさ、ストンプだけ押して逃げてくんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3043109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3043119,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうやってんすねみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3045150,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3045160,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やってんすねみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3046470,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3046480,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、え、みたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3049390,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3049400,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しい雰囲気出さなくてね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3051150,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3051160,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3051870,
    "dDurationMs": 2850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3051880,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どんな結果でも楽しんでいこうね。あめちゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3054710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3054720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽。そうだよね。どんな結果でも楽しいもんね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3057910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3057920,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。どんな結果でも楽しい。負けても楽し。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3060589,
    "dDurationMs": 2651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3060599,
    "dDurationMs": 5641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出さないよ。出さない。これ出ない。出ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3063230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3063240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やさぐれんの早くね。やされんの早いでしょ。ちょっと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3067069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3067079,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3067990,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3068000,
    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こじて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3069390,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3069400,
    "dDurationMs": 1399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、優しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3070230,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3070240,
    "dDurationMs": 3559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "切り。",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3070789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3070799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。切っていく。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3073950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3073960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切られていく。あ、ま、でも優しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3075710,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3075720,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優しいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3076950,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3076960,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ドぶ優しいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3079150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3079160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。この辺をね、ちょっとね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3083549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3083559,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。はい。はい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3085750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3085760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。はい。はね。うーん。お、ジョーカーを切っていく。うーん。で、あ、やべ。ったか。まあ、いいや。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3107390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3107400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお、なるほどね。ええ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3112870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3112880,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ、あれ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3115710,
    "dDurationMs": 369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3115720,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3116069,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3116079,
    "dDurationMs": 2121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ、あれ、あれ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3117430,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3117440,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3118190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3118200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3122030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3122040,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ふう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3123349,
    "dDurationMs": 2851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3123359,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うう。やります。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3126190,
    "dDurationMs": 369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3126200,
    "dDurationMs": 3119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3126549,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3126559,
    "dDurationMs": 3401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?ちょっと待って。あれ?ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3129309,
    "dDurationMs": 651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3129319,
    "dDurationMs": 2961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3129950,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3129960,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3132270,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3132280,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3132710,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3132720,
    "dDurationMs": 4359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?早く出せよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3135670,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3135680,
    "dDurationMs": 2399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これよし。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3137069,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3137079,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、もう優しくない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3138069,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3138079,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切っていく。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3140109,
    "dDurationMs": 851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3140119,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3140950,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3140960,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3143670,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3143680,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、強い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3146470,
    "dDurationMs": 369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3146480,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3146829,
    "dDurationMs": 1131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3146839,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しゃあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3147950,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3147960,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、マジか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3149990,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3150000,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいな。大富豪は。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3152750,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3152760,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 760,
      "acAsrConf": 0
    }, {
      "utf8": "や。また、また",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3155470,
    "dDurationMs": 3290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3155480,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "や。これくそ。うわ、",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3159069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3159079,
    "dDurationMs": 3961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "9",
      "acAsrConf": 0
    }, {
      "utf8": "大しそった。よかった。",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3160990,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3161000,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切りついた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3163030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3163040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、切り方ミスった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3168190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3168200,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね、俺たち",
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 1320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3169670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3169680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人の大富豪配信になっちゃってるよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3173510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3173520,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 240,
      "acAsrConf": 0
    }, {
      "utf8": "回さ、戻るか。",
      "tOffsetMs": 400,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3175109,
    "dDurationMs": 1771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3175119,
    "dDurationMs": 1921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回戻って違うゲームする。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3176870,
    "dDurationMs": 170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3176880,
    "dDurationMs": 2679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3177030,
    "dDurationMs": 2529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3177040,
    "dDurationMs": 5519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回。え、これさ、部屋って崩せんのかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3179549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3179559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、崩せないのかな?これあめ崩せない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3182750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3182760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えっとね、体質みたいのないからヨがもう部屋をぶっ壊す",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3190390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3190400,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ。一旦こ、一旦これでやろうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3193230,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3193240,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よがもう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3193750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3193760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、やん、やん、やんの?オッオオ。やろうぜ、一旦。この感じだとすぐ終わるでしょ、多分。えっと、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3199470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3199480,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "待の店舗いい感じ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3201390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3201400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。えー、なるほどね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3207990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3208000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヨが部屋をぶっ壊す。ヨが部屋をぶが部屋をぶっ壊す。やばい。あ、うわあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3219630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3219640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これね、どうなん、どうなん、これ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3223789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3223799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これはね、一旦こうでしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3230430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3230440,
    "dDurationMs": 2159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "切り",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3230950,
    "dDurationMs": 1649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3230960,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3232589,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3232599,
    "dDurationMs": 4601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "枚も持ってた。えぐ。",
      "tOffsetMs": 281,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3234190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3234200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。この戦いを終わらせてでだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3238270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3238280,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ゴらせに来てるね、だいぶ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3240030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3240040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。この戦いを終わらせに来てこうして。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3243589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3243599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3248990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3249000,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こうして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3251150,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3251160,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいはいはいはいはい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3254030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3254040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいはいはいはいさすがいいカード持ってますね",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3259430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3259440,
    "dDurationMs": 960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3259589,
    "dDurationMs": 811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3259599,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "位なんだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3260390,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3260400,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 159,
      "acAsrConf": 0
    }, {
      "utf8": "位だからね。",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3262109,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3262119,
    "dDurationMs": 4801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやでもましく行こうよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3263910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3263920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優しくね。うーん。わあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3278670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3278680,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、ここで",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3281190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3281200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。もうんじゃない、それ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3284750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3284760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ワンチャン。うわ。うわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3288470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3288480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しいな。フやこれ。え、これよ。負ける。負ける。負ける。負けれる。負けれる。全然負けれる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3295270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3295280,
    "dDurationMs": 2039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "負けれる",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3296230,
    "dDurationMs": 1089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3296240,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "負けれる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3297309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3297319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "イエーイ。切なさいで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3300750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3300760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい。あれね。そんなことあれでば。お前チャットを見ろ。チャット。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3304630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3304640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、何?チャット見ろ。チャット",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3309789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3309799,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3310309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3310319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た、来た、来た、来た、来た、た、た、来た、来た、来た、た、来た、来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3316390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3316400,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "カモン、カモン。ホームアットホームの職場来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3318870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3318880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早く部屋ぶっ壊せ。カモン、カモン、カモン。早く行った。一旦終わってよ。この部屋もう、もう負けるから。負けるから。負けるから。部屋を壊すぞ。俺が",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3329390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3329400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前負けるから。ぶっ壊。最悪すぎ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3332910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3332920,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3333910,
    "dDurationMs": 2169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3333920,
    "dDurationMs": 4919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 40,
      "acAsrConf": 0
    }, {
      "utf8": "人ずつとえ、終わった。終わった。",
      "tOffsetMs": 119,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3336069,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3336079,
    "dDurationMs": 3641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    }, {
      "utf8": "位やんけ。",
      "tOffsetMs": 201,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3338829,
    "dDurationMs": 891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3338839,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3339710,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3339720,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "部屋壊すわ。こ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3341150,
    "dDurationMs": 2649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3341160,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "壊せて。部屋壊せて。これでこれ一旦壊して。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3343789,
    "dDurationMs": 1651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3343799,
    "dDurationMs": 1800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。壊します。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3345430,
    "dDurationMs": 169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3345440,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3345589,
    "dDurationMs": 4811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3345599,
    "dDurationMs": 4801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ずつと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 841,
      "acAsrConf": 0
    }, {
      "utf8": "人。どっちがいい?え、や、",
      "tOffsetMs": 1801,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3351549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3351559,
    "dDurationMs": 2441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人の方がいいか。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 921,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3352829,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3352839,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、そりゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 361,
      "acAsrConf": 0
    }, {
      "utf8": "人じゃない。",
      "tOffsetMs": 520,
      "acAsrConf": 0
    }, {
      "utf8": "2、",
      "tOffsetMs": 960,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3353990,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3354000,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "人で、",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3356190,
    "dDurationMs": 1889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3356200,
    "dDurationMs": 4879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、今なんか誰が入ってきてなかった?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3358069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3358079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、嘘。で、カモン。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3362150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3362160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、ちょっとなんかなんかあれらしい。ちょっと今トラブル中らしい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3367829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3367839,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、バグってるらしい音声が。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3369549,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3369559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょ、その前にさ、ちょ、まジ、部屋の様子とこのマジ赤文字消すわ。一旦赤文字消して。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3374029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3374039,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、清掃して。清掃。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3376069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3376079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前さ、変な言い方すんなよ、お前。これ綺麗に文字をね、文字を片付けて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3383069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3383079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃ、先に先に先に来れる?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3389430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3389440,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、先に来れるかな?大丈夫かな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3391990,
    "dDurationMs": 1170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3392000,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫かな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3393150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3393160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかいざとなったらなんか心配になってきただ。本当に来て本当に来て大丈夫なのって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3400309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3400319,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんか急に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3401789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3401799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "るがなんか何のスタンプ?これ何?何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3405990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3406000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。おい、ちょっと終わっちまったよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3412270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3412280,
    "dDurationMs": 4519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3413789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3413799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのチャット見てみ。今なんかすごい流れが来てるから。あれ?え、ちょ、集まったんじゃね?これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3426150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3426160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えっと、集まってきてます。来れるかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3432789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3432799,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、これ。そう。あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3434870,
    "dDurationMs": 1689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3434880,
    "dDurationMs": 2479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もしもし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3436549,
    "dDurationMs": 810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3436559,
    "dDurationMs": 1681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "誰だ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3437349,
    "dDurationMs": 891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3437359,
    "dDurationMs": 2841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3438230,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3438240,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんにちは。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "その声は",
      "tOffsetMs": 640,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3440190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3440200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、どう?新人のそらしなソフィアと申します。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3446390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3446400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "声可愛い来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3449870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3449880,
    "dDurationMs": 2439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3450670,
    "dDurationMs": 1649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3450680,
    "dDurationMs": 2119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3452309,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3452319,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3452789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3452799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ようこそ。ようこそ。アットホームな場所へ。よ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3456910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3456920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "たちのこの流れをやりしてくれた。ありがとう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3460150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3460160,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、うま、うま、うま。え、うま。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3462470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3462480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみにすいません。あの、ソフィアちゃん、あの、立ち絵をいただけますか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3467150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3467160,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3467990,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3468000,
    "dDurationMs": 5319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もちろんです。えっと、どちらに貼ればよろしいでしょうか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3470870,
    "dDurationMs": 2449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3470880,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そっか。友達じゃないから。ちょっと待って。えっと、そう、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3473309,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3473319,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "友達じゃない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3474789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3474799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうですよね。まだ全然そう話。いや、違う。そういうことじゃない。そう、そうですね。あ、一瞬ジェネラルでもいいんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3481150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3481160,
    "dDurationMs": 2080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かに一旦、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3482710,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3482720,
    "dDurationMs": 1399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3483230,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3483240,
    "dDurationMs": 3879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一旦ジェネラルに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 760,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3484109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3484119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回。あ、それとこのボイスのチャットを開くみたいなとこにこにさ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3489549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3489559,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここにさ、貼ってくれね。ここのあの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3491789,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3491799,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、このジェネラルに。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3493549,
    "dDurationMs": 2611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3493559,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "企画、企画募集のとこに貼ってくれたっていい?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3496150,
    "dDurationMs": 1290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3496160,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、待って、待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3497430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3497440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、ソフィアちゃんここのチャット分かりづらいかもだから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3501710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3501720,
    "dDurationMs": 1879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "天才。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3503230,
    "dDurationMs": 369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3503240,
    "dDurationMs": 1119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3503589,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3503599,
    "dDurationMs": 2921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3504349,
    "dDurationMs": 2171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3504359,
    "dDurationMs": 3401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみにソフィアちゃん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3506510,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3506520,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3507750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3507760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だ、遊び対善はしたことある?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3511069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3511079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、ちょっとだけあのメラとやってボコしました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3515630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3515640,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうなんだ。やる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3518470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3518480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、これはなすごい。なんか、なんかさ、ここ多分めちゃめちゃ離れてるし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3525230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3525240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジで初めて喋ってるじゃん、今。そのさ、多分結構さ、緊張してるよね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3532430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3532440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、なんかすごいあの怖い場所じゃないですよね、ここ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3536670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3536680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖い場所じゃない。怖い。じゃない。怖い。怖ないですよね。あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3541270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3541280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖い場所じゃないよ。え、今なんか怖いこととかある?なんか怖とか心配なことあります。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3546950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3546960,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。心配なこととか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3548710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3548720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、やっぱなん、あの、逆にそのやっぱアットホームな職場ってなんか強調しているのってなんか裏があるのかなとか",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3558589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3558599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "逆に不審感をい抱かせてしまっていたのか。これを",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3562630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3562640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "当たり前だろ。あんなアットホームな職場とか言て当たり前だろ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3567470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3567480,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当にアットホーム。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3569109,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3569119,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、本当に本当にア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3571109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3571119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、もうようこそウェルカムホロライブみたいなところまであるからもう本当に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3575349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3575359,
    "dDurationMs": 4521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうウェルカムですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3576870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3576880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ようこそ来ていただきます。え、ちなみにあの、え、ここのさ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3580270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3580280,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、何?何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3581910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3581920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアちゃん、このチャットとメンション行ってるかな、これ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3585670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3585680,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、行きました。こ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3586870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3586880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "と、ここで貼ってくれたら多分かりやすいかも。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3590390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3590400,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "入りました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3591750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3591760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとう。ソピアちゃんはな、何て呼んだらいいかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3596829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3596839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、もう何でもソピーでもソピーピでも何でも大丈夫です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3601109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3601119,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、先輩?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3601829,
    "dDurationMs": 2611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3601839,
    "dDurationMs": 4121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピじゃあソピーピか。じゃあ、ソピソピ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3604430,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3604440,
    "dDurationMs": 2159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあソピカ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3605950,
    "dDurationMs": 649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3605960,
    "dDurationMs": 1800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピピピカ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3606589,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3606599,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ナソピピピカ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3607750,
    "dDurationMs": 2809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3607760,
    "dDurationMs": 5559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 319,
      "acAsrConf": 0
    }, {
      "utf8": "人来てくれたんじゃない?これ",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3610549,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3610559,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんにちは。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3613309,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3613319,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、やばい。なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3614069,
    "dDurationMs": 2451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3614079,
    "dDurationMs": 5441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3616510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3616520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃのじゃ来た。ちょ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3620870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3620880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おちゃんちっちゃいですか?大丈夫ですか?はい。あちメロレスのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3626950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3626960,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来たのじゃん。じゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3629190,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3629200,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとなのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3630950,
    "dDurationMs": 2169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3630960,
    "dDurationMs": 2800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当にありがとなのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3633109,
    "dDurationMs": 651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3633119,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初めまして。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3633750,
    "dDurationMs": 2329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3633760,
    "dDurationMs": 5319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとなのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "初めまして。",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3636069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3636079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当にマジで初見だから。初見。え、お互いマジ初めましてだから。ちょ、自己紹介した方がいいと思ってて。ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3643630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3643640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここのバは始めましたなんだそうな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3648029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3648039,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "滑舌終わりすぎだろ。お前なんでお前が緊張してんねん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3652230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3652240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "緊張しすぎて。はめざ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3655349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3655359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わかる。なんかさ、マジでさ、こういう機会本当にないからさ、あれだよね。レアだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3662069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3662079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあちょっとまずじゃあちょっとさっき来ていただいた、え、ソフィアちゃんから自己紹介いですか?よいしょ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3668470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3668480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。え、みとの出会いときめきを、え、ホロライブ遊び回りたい平きたんとバーチャルサイエンスアイドルのおさらしなソフィアと申します。よろしくお願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3679029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3679039,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かいい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3680270,
    "dDurationMs": 1809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3680280,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かいいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3682069,
    "dDurationMs": 2131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3682079,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フレッシュかいいです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3684190,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3684200,
    "dDurationMs": 4599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フレッシュだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3685789,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3685799,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "恐食ですね。え、そして、あ、メラちゃんさ、ちょっとさ、立ちもらっていい?ごめん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3691789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3691799,
    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、貼ってくれてるよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3693069,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3693079,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ますのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3694029,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3694039,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "神天才。ちょっと待って。あとソピアちゃんの音量。ヨがフレンドをさりげなく送っておく。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3699349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3699359,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "天才や。こうして。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3700990,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3701000,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3702309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3702319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待ってね。これをこうして。え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3706510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3706520,
    "dDurationMs": 2319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え。メラチの",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3707950,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3707960,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こうして。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3708829,
    "dDurationMs": 2891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3708839,
    "dDurationMs": 4081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。自己紹介も",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3711710,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3711720,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいですか?メラちゃんも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3712910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3712920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいですか?はい。させていただきますのじゃあ。あらあら。メラメラ。あちちんメラ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3720150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3720160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "このライブ遊び回りたいご利役担当のひしやサラマンダちメロンのじゃーよろしくお願いしますのじゃーん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3729349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3729359,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "たのじゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3730230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3730240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃよろしくお願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3733349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3733359,
    "dDurationMs": 5081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よろしくお願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3735430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3735440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "入力ちっちゃいかもなのでお手数なんですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3738470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3738480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今爆上げしました。今爆上げしました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3742630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3742640,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "皆さんこんなんでどうやせ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3744990,
    "dDurationMs": 1129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3745000,
    "dDurationMs": 4119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "みんなどうな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3746109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3746119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今ねあの爆速で立ちをね備してるのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3751430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3751440,
    "dDurationMs": 2879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3752670,
    "dDurationMs": 1649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3752680,
    "dDurationMs": 4639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フレンドを送っているのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3754309,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3754319,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょマジでさ、こんなさ、改造バカメカのさ、立ち絵マジ久しぶりに扱うからやばい。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3762069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3762079,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3762950,
    "dDurationMs": 2889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3762960,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんな全身のちょっと待ってな。よいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3765829,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3765839,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "サアちゃんの",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3767430,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3767440,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Twitch",
      "acAsrConf": 0
    }, {
      "utf8": "のフレンドコードを",
      "tOffsetMs": 320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3769829,
    "dDurationMs": 2051,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3769839,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "教えていただいても",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3771870,
    "dDurationMs": 2969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3771880,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すいません。ちょっと本当に申し訳ないんですけれど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3774829,
    "dDurationMs": 2331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3774839,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ススイッチが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3777150,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3777160,
    "dDurationMs": 1919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "充電は",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3778710,
    "dDurationMs": 369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3778720,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3779069,
    "dDurationMs": 2851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3779079,
    "dDurationMs": 5841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あたお",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3781910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3781920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "充電が切れていました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3785710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3785720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あららベラベラちベラ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3792990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3793000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今高速充電中です。ちょっとさ、お話しよう。お話で",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3799349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3799359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう一旦遊び対もいいけど一旦ね、お話しようよ。お話対戦する前に敵を知らないと。そう、そう、そう。そうしよう。そうしよう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3808910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3808920,
    "dDurationMs": 3439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうしよう。そうしよう。じゃあ、え、まずは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3811230,
    "dDurationMs": 1129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3811240,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "温い会話ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3812349,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3812359,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "え、ちなみにお",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3814069,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3814079,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人はこの",
      "tOffsetMs": 121,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3816029,
    "dDurationMs": 3211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3816039,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "期生のあのスバルとあめのことは",
      "tOffsetMs": 201,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3819950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3819960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか知ってたりとかした?てか今ちょまず怖、怖い。今なんか不安なこととかある?怖いです。その人がもう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3829190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3829200,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、怖くないか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3830870,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3830880,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖くないです。じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3831950,
    "dDurationMs": 1290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3831960,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖くないよね。よかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3833230,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3833240,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖くないよ。怖くないよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3834470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3834480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのソフィアもメラも多分ズいから全然怖くないですのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3838549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3838559,
    "dDurationMs": 4641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうなんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3840190,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3840200,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "色々人生経験歩んできてますから、ある程度の調べは任せてください。ちょ、ちょっとでもさっきやスイッチ充電してないみたいになってたから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3851309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3851319,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すごい動揺してはいた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3852510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3852520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。動揺してはいたかいた。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3855549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3855559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そっちの方が怖かったかもしれないね。じゃね、え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3858990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3859000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖くないからこそ充電を確認せずとも来れたということですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3863630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3863640,
    "dDurationMs": 4639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そういうことです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3865269,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3865279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちなみにさ、あ、ちょっと待って。まだちょっと声がちっちゃいかな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3868910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3868920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラちゃんのメラちゃん、もうちょい音あげれたりする。すいません。もう",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3874190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3874200,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あげれますのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3875510,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3875520,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お願いしますのじゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3876910,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3876920,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃん。どうでしょう?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3879309,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3879319,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、来た、来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3880829,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3880839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これで、これでどうや?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3884109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3884119,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうだ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3885789,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3885799,
    "dDurationMs": 4121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバルがでかい。スバルがちょっと下げ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3888309,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3888319,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "たら切り替えますの?じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3889910,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3889920,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんなんでどう?どっちにしようかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3891870,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3891880,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうでしょうか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3892990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3893000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい、やばい。急にめっちゃめっちゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3897309,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3897319,
    "dDurationMs": 2561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すいません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3898109,
    "dDurationMs": 1771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3898119,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも超いいと思う。ちょうどいい。あ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3899870,
    "dDurationMs": 2209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3899880,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当ですか?いい。ありがとうございます。こ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3902069,
    "dDurationMs": 891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3902079,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "がちょっと割れてるから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3902950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3902960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかね、真ん中ぐらいに音量したら多分",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3907230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3907240,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3908549,
    "dDurationMs": 1851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3908559,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございます。のっちゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3910390,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3910400,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3910870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3910880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人はさ、どういうさ、遊び対戦でゲームが得意なん?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3915150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3915160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かにヨットですの。じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3918230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3918240,
    "dDurationMs": 2039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヨっと運ゲない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3919710,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3919720,
    "dDurationMs": 800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3920269,
    "dDurationMs": 251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3920279,
    "dDurationMs": 2080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3920510,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3920520,
    "dDurationMs": 2759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ご利担当。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3922349,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3922359,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。そっか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3923269,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3923279,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、いいですの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3924829,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3924839,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあもう安場の運がいい方が行くしかないんじゃないの?これは。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3928390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3928400,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、別に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "4",
      "tOffsetMs": 600,
      "acAsrConf": 0
    }, {
      "utf8": "人でやりゃいいだろ。",
      "tOffsetMs": 760,
      "acAsrConf": 0
    }, {
      "utf8": "4",
      "tOffsetMs": 1840,
      "acAsrConf": 0
    }, {
      "utf8": "人で",
      "tOffsetMs": 2000,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3931390,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3931400,
    "dDurationMs": 2959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヨって",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "4",
      "tOffsetMs": 360,
      "acAsrConf": 0
    }, {
      "utf8": "人でできるんですか?",
      "tOffsetMs": 520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3932750,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3932760,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ヨっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 400,
      "acAsrConf": 0
    }, {
      "utf8": "人ゲーじゃから。",
      "tOffsetMs": 559,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3934349,
    "dDurationMs": 2371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3934359,
    "dDurationMs": 2641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そうだよね。ないんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3936710,
    "dDurationMs": 290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3936720,
    "dDurationMs": 1319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3936990,
    "dDurationMs": 1049,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3937000,
    "dDurationMs": 1760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かの機会に。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3938029,
    "dDurationMs": 731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3938039,
    "dDurationMs": 1601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そっか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3938750,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3938760,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3939630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3939640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どっちが運いんだろうね。まあ、なんかどっちか運よ。え、じゃあさ、どっちかと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3943589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3943599,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "対",
      "tOffsetMs": 161,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 321,
      "acAsrConf": 0
    }, {
      "utf8": "ずつ勝負しようよ。",
      "tOffsetMs": 520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3948029,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3948039,
    "dDurationMs": 1881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3948990,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3949000,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そし",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3949910,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3949920,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラちゃんはヨっとね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3952390,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3952400,
    "dDurationMs": 1360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3952950,
    "dDurationMs": 810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3952960,
    "dDurationMs": 3599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、嬉しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3953750,
    "dDurationMs": 2809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3953760,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ソピアソピアちゃん何が得意どういう系?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3956549,
    "dDurationMs": 1211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3956559,
    "dDurationMs": 2681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何が得意?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3957750,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3957760,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヒットアンドブローですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3959230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3959240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、頭使うやつ。じゃあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3964069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3964079,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "が一旦あめでいいか?一旦やめ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3965870,
    "dDurationMs": 2729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3965880,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと終わった。終わった。無理、無理、無理。絶対無理。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3968589,
    "dDurationMs": 2371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3968599,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアでもリバースも得意じゃよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3970950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3970960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあね、メラチをね、もう完全に白に染み上げましたからね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3975510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3975520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、見たよ。キルの傷。だ、え、結構自信あり。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3980069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3980079,
    "dDurationMs": 4881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。めっちゃ強かったよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3981950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3981960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見てる。私が強いのか?それともお",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3986510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3986520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、弱い説ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3989910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3989920,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それとも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3991230,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3991240,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3991950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3991960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、逆には今日やることでそれやばいわかる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 3996870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 3996880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじ可愛い。え、何?何?何?ごめん、ごめん、ごめん。何だった?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4000870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4000880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、なんで今日対戦することで私が強かったのか、もしくは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4005670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4005680,
    "dDurationMs": 1919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4006109,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4006119,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ミラが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4007589,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4007599,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あっちゃったのかが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4009269,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4009279,
    "dDurationMs": 2641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "証明されるかもしれない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4010789,
    "dDurationMs": 1131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4010799,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "うん。",
      "tOffsetMs": 601,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4011910,
    "dDurationMs": 2649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4011920,
    "dDurationMs": 5439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だから今日わかるってことね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4014549,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4014559,
    "dDurationMs": 4401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあその場で証明されるってこと?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4017349,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4017359,
    "dDurationMs": 4601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "証明なのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4018950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4018960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃあどうしよう。え、これさ、え、指名性にしてもらうか。その、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4025589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4025599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "戦いたいですみたいなですっていう。うわあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4029230,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4029240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、大丈夫?これに関してはどっちを選んでもあの後からちょっとそういうのやめてよとかないからマジで好きにないない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4038349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4038359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのいいね。ちょっと名していてもよしいでしょうか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4041430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4041440,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。遊びたいなって思うとね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4042910,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4042920,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうそうそう。遊びなっていう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4044950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4044960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "遊び回りたいなっていうのを選んでいただいて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4048910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4048920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。じゃあまずはどっちか行こうかな。じゃあメラちゃんどっちがいいですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4054510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4054520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。え、ちなみにお二方の運がどれぐらい自信あるかをまず先に把握しておきたいですのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4059950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4059960,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあ、",
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 599,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4060710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4060720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "期生はこんなことを言ってはなんだが。え、運ないの?ちょっと嘘でしょ?え、え、ニキーはなんかもう運だけはなんかあるみたいなイメージある?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4073950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4073960,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4074589,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4074599,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4075950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4075960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、だって運なかったらホロライブあのタイミングで入れないっしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4079870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4079880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それ言ったらみんなま、みんなそうなんだけどま、でも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4084910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4084920,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "期生はどうなんだろう。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4086470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4086480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、あめ的にはダメし、スバルはなんかあるんかなって思うけどね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4090549,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4090559,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "要はなんか普段運なくてピンポイントで爆発的な運がいい時があるって感じ。村があるタイプ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4096789,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4096799,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4097630,
    "dDurationMs": 1569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4097640,
    "dDurationMs": 2039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "めっちゃ村あるタイプすね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4099189,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4099199,
    "dDurationMs": 1241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4099669,
    "dDurationMs": 771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4099679,
    "dDurationMs": 1201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4100430,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4100440,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4100870,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4100880,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヨではすごい爆発力大事なんで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4103590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4103600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。ま、引ければ引けなかった時えぐい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4107470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4107480,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4108669,
    "dDurationMs": 1411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4108679,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "タイプですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4110070,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4110080,
    "dDurationMs": 2239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございますの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "じゃあ、",
      "tOffsetMs": 1279,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4111870,
    "dDurationMs": 449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4111880,
    "dDurationMs": 1640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4112309,
    "dDurationMs": 1211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4112319,
    "dDurationMs": 1520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4113510,
    "dDurationMs": 329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4113520,
    "dDurationMs": 3159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "す、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4113829,
    "dDurationMs": 2850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4113839,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どっちもいいのか悩ましいですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4116669,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4116679,
    "dDurationMs": 4921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どっちもいいよ。めらちゃんどっちがいいですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4118789,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4118799,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございますの。じゃ、そしたら、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4121590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4121600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、どちらとも遊びたいんですが、あの、今回やはりあの、あめ先輩が下山しておられるということで、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4130349,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4130359,
    "dDurationMs": 4041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、山友として",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4132510,
    "dDurationMs": 1890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4132520,
    "dDurationMs": 4639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "私も山に住んでいたので、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4134390,
    "dDurationMs": 2769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4134400,
    "dDurationMs": 5759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここ山のあ、山友だ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4137149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4137159,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。そう、そうだよ。そうだよ。山友ですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4140149,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4140159,
    "dDurationMs": 2961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山こ山。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4141749,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4141759,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう、山友です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4143110,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4143120,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "共通山じゃあ、あめ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4144829,
    "dDurationMs": 2051,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4144839,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "vs",
      "acAsrConf": 0
    }, {
      "utf8": "メラね。オッケー。",
      "tOffsetMs": 641,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4146870,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4146880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいはいはい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4147749,
    "dDurationMs": 2131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4147759,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ごめん。強制でソフィア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4149870,
    "dDurationMs": 289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4149880,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "vs",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4150149,
    "dDurationMs": 2251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4150159,
    "dDurationMs": 5241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバルだけどソフィアちゃん大丈夫?そう?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4152390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4152400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、もちろんです。いや、だってスバル先輩あれでしょ?あの、免許とかもお持ちで。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4158110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4158120,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。そう。あとまム好き。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4161110,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4161120,
    "dDurationMs": 1039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4161870,
    "dDurationMs": 289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4161880,
    "dDurationMs": 600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4162149,
    "dDurationMs": 331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4162159,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4162470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4162480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。だから俺たちは熊ムシナジーで行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4166950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4166960,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "く友です。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4169309,
    "dDurationMs": 2771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4169319,
    "dDurationMs": 4121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "俺ら熊友でそっち友で行こうぜ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4172070,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4172080,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山友で。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4173430,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4173440,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4174630,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4174640,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ行きますか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4175470,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4175480,
    "dDurationMs": 3879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあそろそろ充電は大丈夫?そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4178110,
    "dDurationMs": 1249,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4178120,
    "dDurationMs": 4239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、どうすか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4179349,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4179359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おかげ様で復活しました。あの水です。フレンドコーナー買っときました。じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4185269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4185279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございます。じゃあヨがフレンド",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4188829,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4188839,
    "dDurationMs": 2601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4189709,
    "dDurationMs": 1731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4189719,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しとこうかな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4191430,
    "dDurationMs": 2849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4191440,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?メラちにはフレンド行ったかな?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4194269,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4194279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?許可できてませんか?見ますの?じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4197550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4197560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあだ、スバルがソピアちゃんとフレンドなればいいん?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4202030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4202040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "フレンド。あ、なったっぽいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4203709,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4203719,
    "dDurationMs": 4321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オオ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4205030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4205040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ待って。じゃあ今からスバルがソピアちゃんにやる前にその前にあれか、あめが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4211390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4211400,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "部屋立てといてくれたらよフレンド",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4213950,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4213960,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人とも送っちゃう。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4215470,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4215480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、オッーオッケー。じゃあ部屋立てればいいか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4217750,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4217760,
    "dDurationMs": 1120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4218470,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4218480,
    "dDurationMs": 2080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "了解。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4218870,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4218880,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、いや、違う。あ、が立てないといけない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4220550,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4220560,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめん。嘘、嘘、嘘。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4221790,
    "dDurationMs": 2449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4221800,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、それをスバルがキャプればいいんだな。オケー。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4224229,
    "dDurationMs": 2771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4224239,
    "dDurationMs": 5041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そう、そう、そう、そう。で、多分これで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4226990,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4227000,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人とも友達。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4229270,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4229280,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちなみに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 1080,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4230510,
    "dDurationMs": 2689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4230520,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ともう他の先輩と会った。喋った。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4233189,
    "dDurationMs": 2571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4233199,
    "dDurationMs": 5561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、確かに喋ったの",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4235750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4235760,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しょ。いや、スタジオとかでもお会いしてない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4238750,
    "dDurationMs": 810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4238760,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あんまり。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4239550,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4239560,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱさ、いや、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4241110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4241120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバルも、え、まだ全然あってないみたいなこと言うからやっぱまだ合ってないんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4246870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4246880,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかしないよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4249790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4249800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ですね、オフラインではなんか凸待ちとかに参加させていただいたりはあるんですけれど",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4254350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4254360,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。リアルでは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4256030,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4256040,
    "dDurationMs": 2440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4257030,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4257040,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、読むないな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4258470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4258480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "誰とさ、なんかちょっとさ、喋ってみたいとかある?なんかホロライブの",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4264110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4264120,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "誰と喋ってみたいなとか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4266590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4266600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わしはあの、明日コラボさせていただくんですけど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4270709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4270719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱあのジオゲッサー大好きじゃからあず先輩と",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4274830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4274840,
    "dDurationMs": 4879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お話したいなとは。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4276750,
    "dDurationMs": 2969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4276760,
    "dDurationMs": 5959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あずちゃん優しいぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4279709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4279719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優しいお姉さんだよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4282950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4282960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優しいお姉さんだぞ。あずっちゃん作りました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4286470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4286480,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オッケー。できました。ありがとうございます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4288550,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4288560,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ソアちゃんは?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4290990,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4291000,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、それで言うと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4292470,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4292480,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4292990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4293000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "めっちゃスる先輩とお話ししてみたかったので。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4296630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4296640,
    "dDurationMs": 3039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4297270,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4297280,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっといじ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4299669,
    "dDurationMs": 2291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4299679,
    "dDurationMs": 5281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんでなんでいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4301950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4301960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんかス原先輩すごいソフィアめちゃくちゃ好奇心あるんですけどなんかスバ原先輩からなんかいろんな好奇心方なんじゃないかなっていうなんかオーラを感じて",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4311430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4311440,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "同じ匂い感じられてんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4313590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4313600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみにスバルもよくわかんねえけど科学とかよく行く。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4318270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4318280,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、嬉しいなの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4320790,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4320800,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一緒に行きましょう。私なんだけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4323430,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4323440,
    "dDurationMs": 2279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4324110,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4324120,
    "dDurationMs": 2039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行きたい。いいの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4325709,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4325719,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4326149,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4326159,
    "dDurationMs": 1961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ?いいじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4327629,
    "dDurationMs": 491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4327639,
    "dDurationMs": 1201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4328110,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4328120,
    "dDurationMs": 1519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4328830,
    "dDurationMs": 809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4328840,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ待って。マジ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4329629,
    "dDurationMs": 811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4329639,
    "dDurationMs": 3801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しみ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4330430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4330440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジ今日来てくれてほんま。あ、あめさ、ちょっとさ、画面してもらっていい?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4335110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4335120,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、画面許ね。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4336310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4336320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お願します。ほならじゃあ、あめ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4340590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4340600,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "vs",
      "acAsrConf": 0
    }, {
      "utf8": "メラちゃん行きますか、これ。",
      "tOffsetMs": 480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4343790,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4343800,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4345910,
    "dDurationMs": 1170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4345920,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こうして。じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4347070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4347080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ね、先にしてもろていいすか?で、こうして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4355629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4355639,
    "dDurationMs": 3281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4356310,
    "dDurationMs": 2610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4356320,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ待って。今鬼の作っちゃうよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4358910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4358920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "鬼のね、キャプリをしてる。ちょっと待な。こうして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4362149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4362159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "を使ったポカ遊びだよ。サイコロのベーク。これだ。これにしてこうしてるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4372189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4372199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちなみに自信のほどはメラちゃんあめなかなか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4376910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4376920,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "終わりですの?じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4377950,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4377960,
    "dDurationMs": 2239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "終わり。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4379310,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4379320,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4380189,
    "dDurationMs": 2731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4380199,
    "dDurationMs": 4921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみに誰に勝ったことあんの?今まで?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4382910,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4382920,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ソピアに勝ちましたの?じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4385110,
    "dDurationMs": 650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4385120,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアだけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4385750,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4385760,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、すごかったな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4388070,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4388080,
    "dDurationMs": 3079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの時のは",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4389110,
    "dDurationMs": 2049,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4389120,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そう。結構圧勝だったんだ。あ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4391149,
    "dDurationMs": 1851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4391159,
    "dDurationMs": 4841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そんなに強いんや。やっぱ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4392990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4393000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、どうしよう。え、じゃ、普段から運がいいタイプなのか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4396910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4396920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。運がいいので遊び回りたいのご利役担当を与えられましたのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4401629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4401639,
    "dDurationMs": 1961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4402229,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4402239,
    "dDurationMs": 4161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4403590,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4403600,
    "dDurationMs": 5800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お手紙拝見といきましょうか。どれどれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4406390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4406400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあちょまずいっすね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4409470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4409480,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、め、頑張れって。見せたれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4411030,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4411040,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "生のなんだっけ?",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4412950,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4412960,
    "dDurationMs": 5759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "期生のご役担当だっけ?見せたれ。行",
      "tOffsetMs": 120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4415750,
    "dDurationMs": 2969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4415760,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "くのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "行くのじゃん。",
      "tOffsetMs": 1320,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4418709,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4418719,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くのじゃん。行くのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4420310,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4420320,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くのじゃん。あ、でも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4422149,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4422159,
    "dDurationMs": 2921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "62",
      "acAsrConf": 0
    }, {
      "utf8": "個か。",
      "tOffsetMs": 520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4423750,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4423760,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、お、結構いいんじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4425070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4425080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最初から",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4429270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4429280,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、まあ、じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4431790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4431800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあまあまあまあ、これ今、あめさんすね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4434990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4435000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。よがちょっと回しておりますけれども",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4438030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4438040,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 1159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4439430,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4439440,
    "dDurationMs": 4320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "が出たらいい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4440750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4440760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4449030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4449040,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4449750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4449760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日尖ってる日だ。今日尖ってる日。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4452790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4452800,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの爆発の日来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4454149,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4454159,
    "dDurationMs": 3721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日爆発の日や。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4455830,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4455840,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4457870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4457880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの敗北宣言をさせていただいてより早。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4463790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4463800,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだ早いよ。まだ早いよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4465790,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4465800,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや諦めんな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4467750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4467760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにしもヨっとを出せる。そう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4471030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4471040,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちゃんも出せばいいんだから。大丈夫大夫。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4472510,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4472520,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "全然ある。全然ある。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4474229,
    "dDurationMs": 3771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4474239,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "全然あるよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "行きますのじゃ。",
      "tOffsetMs": 1041,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4477990,
    "dDurationMs": 610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4478000,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4478590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4478600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、ま、ま、ま、いい。ま、ま、ま、ま、ま、いい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4482550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4482560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、何回かのうちでヨっと出せばいいからね。ミストも狙えますから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4487110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4487120,
    "dDurationMs": 3559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "徐々に、徐々にね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4488270,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4488280,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "徐々にやればいいからね。うち徐々に徐々に。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4490669,
    "dDurationMs": 2891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4490679,
    "dDurationMs": 3401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "B",
      "tOffsetMs": 281,
      "acAsrConf": 0
    }, {
      "utf8": "ストレート強い。",
      "tOffsetMs": 480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4493550,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4493560,
    "dDurationMs": 720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4494070,
    "dDurationMs": 210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4494080,
    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "は、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "B",
      "tOffsetMs": 79,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4494270,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4494280,
    "dDurationMs": 2919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ストレート埋めさせていただきます。ちょっと運が",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4496310,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4496320,
    "dDurationMs": 3879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人とも良すぎて",
      "tOffsetMs": 120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4497189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4497199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。山、山シ山って運いいんだな。すげえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4501590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4501600,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山の、山のか護山のか護す。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4504310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4504320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山のかがあるかもしんない。これあ、いいね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4508270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4508280,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すごくないか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4509870,
    "dDurationMs": 2610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4509880,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初定ヨットは配信者すぎますのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4512470,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4512480,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "めっちゃ配信者。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4513950,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4513960,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今までで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 759,
      "acAsrConf": 0
    }, {
      "utf8": "番いい良かったかも。",
      "tOffsetMs": 960,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4516590,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4516600,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱちょっと民せてやってくださいよ。やめさん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4519070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4519080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと先輩ってところを見せるのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4522990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4523000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "映ってる、映ってる。お前のじキャラじゃないの?せるのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4528189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4528199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早いだろ。映るの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4531430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4531440,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "て行くのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4532669,
    "dDurationMs": 2371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4532679,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くのじゃよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4535030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4535040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "前回のメラ対ソピアは初めソピアがヨッと出して、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4540070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4540080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それソピアがリードしてたところをメラが逆転したんですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4543270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4543280,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、じゃ全然あるじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4544430,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4544440,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、全然あるね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4545830,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4545840,
    "dDurationMs": 2399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4546350,
    "dDurationMs": 1889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4546360,
    "dDurationMs": 4879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わせらせていただきます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4548229,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4548239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとすごいなんかワシって名前なんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4552629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4552639,
    "dDurationMs": 2361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうね。ワシ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4553790,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4553800,
    "dDurationMs": 2399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ワシね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4554990,
    "dDurationMs": 1209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4555000,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ワシです。ワし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4556189,
    "dDurationMs": 2331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4556199,
    "dDurationMs": 4161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、どうだ?結構いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "4",
      "tOffsetMs": 1440,
      "acAsrConf": 0
    }, {
      "utf8": "揃ってる。",
      "tOffsetMs": 1761,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4558510,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4558520,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、惜し",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4560350,
    "dDurationMs": 1809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4560360,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "惜しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "え、",
      "tOffsetMs": 1200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4562149,
    "dDurationMs": 1971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4562159,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ハイレベルの戦い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4564110,
    "dDurationMs": 3089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4564120,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "4",
      "tOffsetMs": 1039,
      "acAsrConf": 0
    }, {
      "utf8": "ダイス埋めとくか。",
      "tOffsetMs": 1240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4567189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4567199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや、あめさん大丈夫です。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4570870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4570880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見せてやってくださいよ。肩で切っちゃって。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4574669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4574679,
    "dDurationMs": 5681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回ね、",
      "tOffsetMs": 201,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 761,
      "acAsrConf": 0
    }, {
      "utf8": "回見せちゃって。うん。うん。",
      "tOffsetMs": 960,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4577910,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4577920,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "強い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 960,
      "acAsrConf": 0
    }, {
      "utf8": "回ちょっと",
      "tOffsetMs": 1160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4580350,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4580360,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見せるのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4581430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4581440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見せ早いな。映るの?お前それ気に入りすぎだろ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4587669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4587679,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山すご。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4588950,
    "dDurationMs": 2689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4588960,
    "dDurationMs": 5679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山すごいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "ご利がすごい。",
      "tOffsetMs": 1279,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4591629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4591639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、すごいな。え、ソフィアちゃんなんかさ、その",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4595790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4595800,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4596070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4596080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "Eいいエピソードとか自分では運そんなになの?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4600709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4600719,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアちゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4601270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4601280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアいですか?ソピアは正直あんまりこれまで人生でめっちゃ多いなって思ったことないすね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4608390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4608400,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうなんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4609550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4609560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもなんかメラが結構バフタイプのあれなんですよ。バフをなんか投げてくれるんで、なんかメラと一緒にいたらなんかあ、結構当たるなみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4617950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4617960,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、めっちゃがいいってことをじゃあ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4620910,
    "dDurationMs": 729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4620920,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4621629,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4621639,
    "dDurationMs": 4241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "リアクタという風、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4622870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4622880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、すごいやらせていただいております。まし、ちょっとなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4626430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4626440,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも結構さ、いいんだよね、この",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4628350,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4628360,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、本当にデ目がいい。デメが。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4630270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4630280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、目が目の数ちゃんと多いんだけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4633990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4634000,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんか大事なことのなんかあれだな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4636390,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4636400,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "9",
      "acAsrConf": 0
    }, {
      "utf8": "時とか引く前",
      "tOffsetMs": 160,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 799,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4637350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4637360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回メラに連絡しようか。あ、で、それ絶対あり",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4641030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4641040,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4641470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4641480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回今からガチャ引くんだけどさとか言ってちょっと別ないって言うしかないよね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4646950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4646960,
    "dDurationMs": 1400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4648149,
    "dDurationMs": 211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4648159,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "9",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4648350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4648360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "時は正直自信なくて毎回宝くじ買ってるんですけど当たらないのじゃあれ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4653229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4653239,
    "dDurationMs": 1561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4653550,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4653560,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4654790,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4654800,
    "dDurationMs": 2359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかそうなてく",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4656030,
    "dDurationMs": 1129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4656040,
    "dDurationMs": 4119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "9",
      "tOffsetMs": 920,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4657149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4657159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "時以外人間が絡む系の運はいいんじゃけど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4660709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4660719,
    "dDurationMs": 4561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人間が絡む系の",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4662270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4662280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あチケットだからダメなのかな宝くじは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4665310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4665320,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4665750,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4665760,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "欲がありすぎるとブルーハウス",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4668550,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4668560,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4668990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4669000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ブルハウスだけど死刑死刑なので",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4673510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4673520,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "シケハウスか一旦",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4674830,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4674840,
    "dDurationMs": 4879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "シケハウスなので一旦死刑ケハウスで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4677310,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4677320,
    "dDurationMs": 3839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃあよいしょ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4679709,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4679719,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わし、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4681149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4681159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わし。いやあ、何とも言えないなあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4685149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4685159,
    "dDurationMs": 4961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、何とも言えないだな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4687149,
    "dDurationMs": 2971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4687159,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こういう時選ぶのむずいよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4690110,
    "dDurationMs": 1569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4690120,
    "dDurationMs": 4039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、エススト埋めるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4691669,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4691679,
    "dDurationMs": 4401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一旦",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "S",
      "tOffsetMs": 401,
      "acAsrConf": 0
    }, {
      "utf8": "ストレート埋めたい。",
      "tOffsetMs": 641,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4694149,
    "dDurationMs": 1931,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4694159,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4696070,
    "dDurationMs": 2569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4696080,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。埋まらなさそう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4698629,
    "dDurationMs": 2891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4698639,
    "dDurationMs": 3681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもわかんないよ。こっから巻き返す可能性あるからね。全然。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4701510,
    "dDurationMs": 810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4701520,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4702310,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4702320,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "埋めます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4704590,
    "dDurationMs": 1649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4704600,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4706229,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4706239,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4707910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4707920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、でも、え、すごい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4711430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4711440,
    "dDurationMs": 2279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ナイス、ナイス。のちゃん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4713110,
    "dDurationMs": 609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4713120,
    "dDurationMs": 3599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4713709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4713719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも天才いい感じだね。すごいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4716750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4716760,
    "dDurationMs": 1080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4717270,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4717280,
    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4717830,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4717840,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヨっと出して。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4719510,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4719520,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにヨっと出してんのにこれすごくね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4721870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4721880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっからヨっと出されたらよ、結構やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4725030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4725040,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、どうだ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4726390,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4726400,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かなりやばいです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4727750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4727760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なキりさん、そんな弱けいいんすか?今日は山から折り立てほやほや。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4733430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4733440,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4733709,
    "dDurationMs": 2131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4733719,
    "dDurationMs": 5121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。せっかく降りたんですから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4735830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4735840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "せっかく降りた。ワロ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4740350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4740360,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "せか降りたんですから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4742110,
    "dDurationMs": 2690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4742120,
    "dDurationMs": 5039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "せっかく降りたんですから。山根くだって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4744790,
    "dDurationMs": 2369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4744800,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、これフルハウス狙ってみてもいい?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4747149,
    "dDurationMs": 731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4747159,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4747870,
    "dDurationMs": 1769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4747880,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4749629,
    "dDurationMs": 1971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4749639,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いわか強気はあるけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4751590,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4751600,
    "dDurationMs": 1840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1/3。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4752830,
    "dDurationMs": 610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4752840,
    "dDurationMs": 2280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4753430,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4753440,
    "dDurationMs": 2239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、どうだ?あと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    }, {
      "utf8": "回。",
      "tOffsetMs": 1520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4755110,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4755120,
    "dDurationMs": 3559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1/3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4755669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4755679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "引けるかな?いや、引けなかったら結構終わり。う、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4760189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4760199,
    "dDurationMs": 4841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "引いていく。で、引く。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4762470,
    "dDurationMs": 2570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4762480,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、やべ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4765030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4765040,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山やばいぞ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4768030,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4768040,
    "dDurationMs": 2639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "山やばいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4769390,
    "dDurationMs": 1289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4769400,
    "dDurationMs": 4279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "引けたのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4770669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4770679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すごいのじゃこ何この幸運なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4774189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4774199,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "恐しい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4775070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4775080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかさ、ソピアこんだけ幸運見てると不安になってこないかなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4778830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4778840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかちょっと見ちゃいけないもの見てる気がしてきました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4782470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4782480,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4784070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4784080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人間がそうの当たりにしていい光景じゃない気がした。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4787270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4787280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに人間の我々にはちょっと早いかも。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4791229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4791239,
    "dDurationMs": 2761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4792629,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4792639,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "超越しているかもしれない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4793990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4794000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何かを超越している可能性あり。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4798310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4798320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあどうだけさん何狙うんすか?こ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4805830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4805840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょちょちょちょちょいちょいちょいちょいちょいちょいちょっと待ってちょっと待って。逆に焦ってきた。やばい。やばい。なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4814390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4814400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも今なんか変な汗帰てきた。なんかドッキー。え、よ変な汗出てきちゃった。ここ違うんだよ。違うよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4820790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4820800,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、どうしよう。どうしよう。どうしよ。ちょっと",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4823270,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4823280,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怖いよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4824830,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4824840,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいな。ゴリ担当。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4826310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4826320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これあれじゃのゴリが山りのバフちゃってる。そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4832790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4832800,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっちに来てる可能性ある。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4834229,
    "dDurationMs": 1851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4834239,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "達成してる説ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4836070,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4836080,
    "dDurationMs": 2599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、全然ある。これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4837550,
    "dDurationMs": 1129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4837560,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4838669,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4838679,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え。これさ、お代わり行けるし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4841470,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4841480,
    "dDurationMs": 920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4841830,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4841840,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4842390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4842400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あめじゃないんだけど手の手今めっちゃ冷たいんだけど。スバるなんかもうコントロールなってる手がもうびしちょびしだよ、もう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4850910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4850920,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "変な汗描いても",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4853149,
    "dDurationMs": 1291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4853159,
    "dDurationMs": 3801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあまあまあまあまあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4854430,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4854440,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあまあまあまあと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 920,
      "acAsrConf": 0
    }, {
      "utf8": "回引いてみますけど",
      "tOffsetMs": 1080,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4856950,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4856960,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 80,
      "acAsrConf": 0
    }, {
      "utf8": "回ね",
      "tOffsetMs": 239,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4857830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4857840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいやまさすがによったらさすがにないですよないですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4863709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4863719,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと今一瞬ね",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4865189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4865199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと見えたないですよ。いや、待って。これどっちに入れるか迷うんだよな。でも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4871709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4871719,
    "dDurationMs": 4401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "迷うね。結構",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4873110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4873120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大なしつくから微妙ですね。余裕は別にないからうちえかな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4881070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4881080,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、いいね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4882950,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4882960,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか序盤とは思えない点数",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4884950,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4884960,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人とまだ前半戦ですよ。",
      "tOffsetMs": 120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4887590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4887600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ何を見せられてる?今日",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4891310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4891320,
    "dDurationMs": 5879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人生で",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 600,
      "acAsrConf": 0
    }, {
      "utf8": "番いいかも。これ",
      "tOffsetMs": 800,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4894189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4894199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今が今がピクやめろて更新してピ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4900270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4900280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやどうしよう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4901430,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4901440,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 239,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 560,
      "acAsrConf": 0
    }, {
      "utf8": "つは結構いいんじゃない?",
      "tOffsetMs": 719,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4903270,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4903280,
    "dDurationMs": 2080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え?うん。結構",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4903990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4904000,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おクルハウス狙い",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4905350,
    "dDurationMs": 250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4905360,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4905590,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4905600,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "狙いますのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "お",
      "tOffsetMs": 880,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4906830,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4906840,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4907550,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4907560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行けるのか?ここで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4909550,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4909560,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、惜しい。お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4910550,
    "dDurationMs": 2410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4910560,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よっしゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4912950,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4912960,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "チョイスですのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4914070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4914080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、でもこういう時にチョイスいいよね。なんかね、狙ってチャレンジ。救済措置がね、あるからね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4920229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4920239,
    "dDurationMs": 1361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4921430,
    "dDurationMs": 170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4921440,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4921590,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4921600,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、微妙。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4923950,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4923960,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、微妙ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4925030,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4925040,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "目",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "123。",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4926830,
    "dDurationMs": 4450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4926840,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、でも",
      "acAsrConf": 0
    }, {
      "utf8": "B",
      "tOffsetMs": 1399,
      "acAsrConf": 0
    }, {
      "utf8": "ビ埋まってないもんねよ。",
      "tOffsetMs": 1440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4931629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4931639,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4933189,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4933199,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめん。あめ。なんか色々言ってるけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4934870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4934880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバル全然これルール分かってねえからノりで行ってる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4938870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4938880,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4939590,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4939600,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここまで来てからなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4941910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4941920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。そうだねとか言ってるけど結構うえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4947030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4947040,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ビーストレは",
      "acAsrConf": 0
    }, {
      "utf8": "5",
      "tOffsetMs": 960,
      "acAsrConf": 0
    }, {
      "utf8": "つなんで嘘でしょ。",
      "tOffsetMs": 1080,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4952310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4952320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "揃ってちょいちょいちょいちょいちょいちょいちょいちょいなんかちょい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4956750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4956760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ先輩理論地叩き出そうとしてませんか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4960430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4960440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最高人類史場最高特定を叩き出そうとしている",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4963990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4964000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。メラねこれ座れてるぞ。お前",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4967590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4967600,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいやばいやばいやばいやになっちゃった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4970189,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4970199,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これやばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4971510,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4971520,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとこれは",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4973070,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4973080,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと目",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4975310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4975320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラ頑張れ。負けるな。ちょ頑張れ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4978590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4978600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれはえ、あれ頑張れ。負け。勝ち",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4982910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4982920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "たいが。勝ちたがちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4988189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4988199,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4988669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4988679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "半分ぐらいでこの点数はやめ。変な止まんない。変な諦めません。諦めません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4994470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4994480,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前こ役担当だろ。頑張る。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4997350,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4997360,
    "dDurationMs": 1040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4997870,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4997880,
    "dDurationMs": 1279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4998390,
    "dDurationMs": 769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4998400,
    "dDurationMs": 2200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "怒って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 4999149,
    "dDurationMs": 1451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 4999159,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "怒んでます。",
      "tOffsetMs": 441,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5000590,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5000600,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよな。とピちゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5002189,
    "dDurationMs": 2371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5002199,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよ。遊び回りたい。背負ってんだからな。メラは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5004550,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5004560,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。めっちゃ背負わされてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5006390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5006400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばせ。遊び回りたいですの。じゃあプレッシャーかけられてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5011310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5011320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなに気わなくていいからな。そ気を抜いて楽しくやってくれ。楽しく",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5015669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5015679,
    "dDurationMs": 4281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しい。楽しくね。楽しくね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5017910,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5017920,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、楽しいです。とても。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5019950,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5019960,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫か?声めっちゃ小さ。声が。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5021950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5021960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいやいやいやいやいやいや。ちゃうちゃうちゃうちゃうちゃう。あの干渉にしたっており。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5025590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5025600,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、今ね、今ね。今ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5027669,
    "dDurationMs": 811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5027679,
    "dDurationMs": 1281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今ね、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5028470,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5028480,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "とても、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5028950,
    "dDurationMs": 3130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5028960,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "人しとけばよかった。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5032070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5032080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、やめさんいい感じですけど、何狙いすか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5036390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5036400,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、こう、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 520,
      "acAsrConf": 0
    }, {
      "utf8": "か",
      "tOffsetMs": 759,
      "acAsrConf": 0
    }, {
      "utf8": "4",
      "tOffsetMs": 960,
      "acAsrConf": 0
    }, {
      "utf8": "か、ま、",
      "tOffsetMs": 1239,
      "acAsrConf": 0
    }, {
      "utf8": "6",
      "tOffsetMs": 2279,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5039030,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5039040,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個かを埋めたいんですけども。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5041750,
    "dDurationMs": 489,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5041760,
    "dDurationMs": 1280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5042229,
    "dDurationMs": 811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5042239,
    "dDurationMs": 1361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5043030,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5043040,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "が",
      "tOffsetMs": 199,
      "acAsrConf": 0
    }, {
      "utf8": "3",
      "tOffsetMs": 360,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5043590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5043600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つしか出ないんでちょっと焦ってますね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5047870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5047880,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5047990,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5048000,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つかなり十分ですのじゃ実は。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5049790,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5049800,
    "dDurationMs": 2120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ま、最低保証だね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5051350,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5051360,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    }, {
      "utf8": "ね。",
      "tOffsetMs": 319,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5051910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5051920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。はい。はい。わし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5055430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5055440,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5056350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5056360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でも埋まれてると埋まってないわね。でからね。確かに",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5062669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5062679,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5063510,
    "dDurationMs": 1129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5063520,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5064629,
    "dDurationMs": 2291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5064639,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "悩む。うわ、悩む。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5066910,
    "dDurationMs": 329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5066920,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5067229,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5067239,
    "dDurationMs": 1400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ悩むね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5068390,
    "dDurationMs": 249,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5068400,
    "dDurationMs": 2120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5068629,
    "dDurationMs": 1891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5068639,
    "dDurationMs": 4121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと悩みますね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5070510,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5070520,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっともう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 360,
      "acAsrConf": 0
    }, {
      "utf8": "も",
      "tOffsetMs": 480,
      "acAsrConf": 0
    }, {
      "utf8": "3",
      "tOffsetMs": 600,
      "acAsrConf": 0
    }, {
      "utf8": "もちゃってるもんね。",
      "tOffsetMs": 719,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5072750,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5072760,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
