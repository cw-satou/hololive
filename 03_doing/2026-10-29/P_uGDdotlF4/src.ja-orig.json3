    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5266280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、でもでかい、でかいでかいの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5270669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5270679,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "堅実にいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5272709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5272719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "追いついてきてるぞ。メラ銃。もうちょいや、もうちょい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5276350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5276360,
    "dDurationMs": 4759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よしよしよしよしよし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "僕",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    }, {
      "utf8": "3",
      "tOffsetMs": 1600,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5278109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5278119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つ出さないとボーラスもらえないな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5281830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5281840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ほんまやん。ああ、間違えた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5284950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5284960,
    "dDurationMs": 2679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0
    }, {
      "utf8": "つまずいからの",
      "tOffsetMs": 480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5287470,
    "dDurationMs": 169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5287480,
    "dDurationMs": 1840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5287629,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5287639,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つって意外とね、難しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5289310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5289320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもあめさん出ちゃうんじゃないですか?こういう時そうな予感しますのじゃ。え、出ません。出ません。なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5295149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5295159,
    "dDurationMs": 4641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうですか?これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5296790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5296800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとまずいです。これまずいです。まずいです。これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5300550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5300560,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずい。これまず",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5301790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5301800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずいです。これチョイスまずいです。これ負けちゃう可能性全然あります。負けちゃう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5306990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5307000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "危ない危ない。いや、どうしよう。どうしよう。どうしよう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5311629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5311639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "悩みどころ。いや、超いす。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5314830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5314840,
    "dDurationMs": 3879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かけようぜ。最後",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 1279,
      "acAsrConf": 0
    }, {
      "utf8": "が出るに。",
      "tOffsetMs": 1640,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5317990,
    "dDurationMs": 729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5318000,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最後",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5318709,
    "dDurationMs": 771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5318719,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最後に。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5319470,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5319480,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。最後に見せよ。投りやめ。最後。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5321910,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5321920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、その、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5323830,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5323840,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "その",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 279,
      "acAsrConf": 0
    }, {
      "utf8": "欲し。",
      "tOffsetMs": 560,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5324910,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5324920,
    "dDurationMs": 2640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よっかよ。狙",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5327270,
    "dDurationMs": 290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5327280,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "狙。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5327550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5327560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もちろんヨットを狙わしていただきますのじゃ。い",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5330629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5330639,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いね。いいね。いいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5332149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5332159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もちろんヨットを狙わしていただきますので。うわ。うわ、めっちゃいいフルハウスやけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5337109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5337119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "嘘。え、お、まさかの嘘でしょ?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5340189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5340199,
    "dDurationMs": 6121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5",
      "acAsrConf": 0
    }, {
      "utf8": "を確かに確かに埋まってないからね。",
      "tOffsetMs": 281,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5343310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5343320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そういうことじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5346669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5346679,
    "dDurationMs": 1560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5347030,
    "dDurationMs": 1209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5347040,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、でもいい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5348229,
    "dDurationMs": 1211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5348239,
    "dDurationMs": 2241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいよ、いいよ、いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5349430,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5349440,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "足りない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5350470,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5350480,
    "dDurationMs": 4719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "足りない。足りない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5352910,
    "dDurationMs": 2289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5352920,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "了解。足りない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5355189,
    "dDurationMs": 1571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5355199,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ノし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5356750,
    "dDurationMs": 409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5356760,
    "dDurationMs": 1959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5357149,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5357159,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、もうあと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5358709,
    "dDurationMs": 1771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5358719,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0
    }, {
      "utf8": "を狙うだけです。",
      "tOffsetMs": 241,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5360470,
    "dDurationMs": 1649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5360480,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、なりさんさすがにここ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5362109,
    "dDurationMs": 691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5362119,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0
    }, {
      "utf8": "出してもらないか。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5362790,
    "dDurationMs": 929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5362800,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "ちょっと",
      "tOffsetMs": 319,
      "acAsrConf": 0
    }, {
      "utf8": "6",
      "tOffsetMs": 600,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5363709,
    "dDurationMs": 1771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5363719,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個も出ないですし、ちょっとまずいですから。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5365470,
    "dDurationMs": 2169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5365480,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最後あなた見せなんですから。こ頑張ってもらう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5367629,
    "dDurationMs": 731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5367639,
    "dDurationMs": 3121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 441,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5368350,
    "dDurationMs": 2410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5368360,
    "dDurationMs": 3839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個ここでちょっと先輩の腕で見せちゃうよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5370750,
    "dDurationMs": 1449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5370760,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0
    }, {
      "utf8": "個ちゃったら",
      "tOffsetMs": 40,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5372189,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5372199,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずいですのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 1281,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5373790,
    "dDurationMs": 3090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5373800,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "つ出しちゃうよって。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1200,
      "acAsrConf": 0
    }, {
      "utf8": "個もあ、",
      "tOffsetMs": 1359,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1800,
      "acAsrConf": 0
    }, {
      "utf8": "個。",
      "tOffsetMs": 1919,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5376870,
    "dDurationMs": 1249,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5376880,
    "dDurationMs": 4239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5378109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5378119,
    "dDurationMs": 4641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 201,
      "acAsrConf": 0
    }, {
      "utf8": "個やばい。",
      "tOffsetMs": 361,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 921,
      "acAsrConf": 0
    }, {
      "utf8": "個",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1321,
      "acAsrConf": 0
    }, {
      "utf8": "個やばい。",
      "tOffsetMs": 1441,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5381109,
    "dDurationMs": 1651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5381119,
    "dDurationMs": 2961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "投けさん、投けさん頑張って。ここ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5382750,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5382760,
    "dDurationMs": 2959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0
    }, {
      "utf8": "あと",
      "tOffsetMs": 840,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 959,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5384070,
    "dDurationMs": 1649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5384080,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出ます。出ますから。あと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5385709,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5385719,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "個ね。あと",
      "tOffsetMs": 201,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 1480,
      "acAsrConf": 0
    }, {
      "utf8": "個。出ます。",
      "tOffsetMs": 1601,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 2281,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5388149,
    "dDurationMs": 3090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5388159,
    "dDurationMs": 3281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個ぐらいで。",
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 681,
      "acAsrConf": 0
    }, {
      "utf8": "個も出ないよ。",
      "tOffsetMs": 841,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5391229,
    "dDurationMs": 211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5391239,
    "dDurationMs": 1161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5391430,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5391440,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個も出ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5392390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5392400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そういう日もあるか、一体",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5395590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5395600,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そういう日もあるか。う",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5396270,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5396280,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わ、ボーラ捨てられなかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5397950,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5397960,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さあ、ここよ出せた。わし、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5400430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5400440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここでヨっと出せたらギリ勝てますのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5403510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5403520,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここで出せたら英雄。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5405790,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5405800,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい、やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5406550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5406560,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、英雄なりたい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5409550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5409560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちゃんいいよ、いいよ、いいよ。目指しちゃいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5414030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5414040,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "切るよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5414870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5414880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "目切る。目指しますのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5417910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5417920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張れ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5419310,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5419320,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "負けれる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5420910,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5420920,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 440,
      "acAsrConf": 0
    }, {
      "utf8": "回。",
      "tOffsetMs": 480,
      "acAsrConf": 0
    }, {
      "utf8": "あ、もう",
      "tOffsetMs": 799,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    }, {
      "utf8": "回あるよ。",
      "tOffsetMs": 1120,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 1520,
      "acAsrConf": 0
    }, {
      "utf8": "回",
      "tOffsetMs": 1600,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5423270,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5423280,
    "dDurationMs": 1919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行けるよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5424030,
    "dDurationMs": 1169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5424040,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張れ。すのか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5425189,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5425199,
    "dDurationMs": 4081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "落ち着いて、落ち着いて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5426990,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5427000,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "英雄を目指す。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5429270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5429280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張れ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5433470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5433480,
    "dDurationMs": 2239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5434669,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5434679,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "乗せなかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5435709,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5435719,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもこれは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5438149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5438159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのやばいです。このなんかハイスコア戦すぎてちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5442910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5442920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当にこんなハイレベルの戦い見たことない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5446270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5446280,
    "dDurationMs": 3879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そうだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5447149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5447159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかさ、なんかよくわかんないけど、こんなに埋まることってあんのないんじゃないの?あさん、これないよね、これ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5453470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5453480,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもなかなか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5456310,
    "dDurationMs": 1290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5456320,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね、お互い",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5457590,
    "dDurationMs": 2529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5457600,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お互いでもお互い埋まってる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5460109,
    "dDurationMs": 2891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5460119,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラはメラでめ結構でかかったよ、ずっと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5462990,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5463000,
    "dDurationMs": 5119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。メラちゃんは悪くないんだよ、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5465910,
    "dDurationMs": 2209,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5465920,
    "dDurationMs": 5199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと、あめ先輩が強すぎました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5468109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5468119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、これはね、あの、あめ、これ昔からなんだけど、あめってなんか周りのバフめっちゃ吸んよ、こいつ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5474830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5474840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だからなんか言い方はなんかもうね、これマジで結構昔から思ってんだけどこいつね、こいつとあのお会はマジで吸ってくる人のちおいしい",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5487790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5487800,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "し美いしかったな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5489910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5489920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だからね、今日はね、あのうまく吸いましたということで、あめさんがでもめちゃんナイスファイトありがとうね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5495830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5495840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがありとうございますね。楽しかったですのじゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5500550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5500560,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5502910,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5502920,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スコアだったと思いますということ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5504550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5504560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、本当にメラちなかったらこんなバフかかってないからね。基本的に運ないから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5509910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5509920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。本ん当運ないからって言うなよ。運なかったらじゃしっかり吸ってんじゃねえか。今日ち",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5517470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5517480,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちちちじゃねえよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5518669,
    "dDurationMs": 1291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5518679,
    "dDurationMs": 4281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "座れるのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5519950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5519960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "めっちゃ座れてるぞ。じゃあちょっと続いてまいりますか。お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5524590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5524600,
    "dDurationMs": 6200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあスバルとソピアちゃんの戦いですかね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5527510,
    "dDurationMs": 3290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5527520,
    "dDurationMs": 4119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "申し訳ないけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "いやあ、そびピの戦い",
      "tOffsetMs": 840,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5530790,
    "dDurationMs": 849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5530800,
    "dDurationMs": 2319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "申し訳ないけどさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5531629,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5531639,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "任せてください。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5533109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5533119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなハイレベルな戦いできないよ。スバルは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5537790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5537800,
    "dDurationMs": 2160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヒットアンドブローだっけな",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5539510,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5539520,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んだっけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5539950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5539960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、え、どっちでもリバーシでもそっかそっか。ほんまにすまん。リバーシにしてもろていいか?ちょっとちょっとあの",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5547910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5547920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ヒットアンドブローブガチわからんすぎる。ちょっと待ってな。こうして",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5551350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5551360,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ結構むずいからね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5553149,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5553159,
    "dDurationMs": 4241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうそうそうそう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5554390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5554400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょで今からえっとフレンドで送ります。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5559030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5559040,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "画面共有を",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5560470,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5560480,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5562910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5562920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、楽しみ。え、エヴーシはそもそもスパル得意なの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5566950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5566960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、得意か得意じゃないかって得意じゃないよね。頭使うから普通に。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5572550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5572560,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、あれじゃ、そう、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5575149,
    "dDurationMs": 2211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5575159,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっちはだから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5577350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5577360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、ここだけの話ですけど、多分勝てます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5580950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5580960,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5581550,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5581560,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "そう、",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5583270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5583280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前や。お、あの、すごい内緒、もうここだけ本当スバルにはちょっと内緒の話なんだけど多分けてた方だ。さっきお前応援しちゃったやないか。スバのこと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5597510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5597520,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5598870,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5598880,
    "dDurationMs": 2799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張るよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5599990,
    "dDurationMs": 1689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5600000,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "遊びに背負って監",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5601669,
    "dDurationMs": 1291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5601679,
    "dDurationMs": 2601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "た。メラの敵を",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5602950,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5602960,
    "dDurationMs": 2199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "監督監督来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5604270,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5604280,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、メラちゃん?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5605149,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5605159,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "の敵を取るんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5606310,
    "dDurationMs": 2809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5606320,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、メラのな。あ、送ったよ、今。おいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5609109,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5609119,
    "dDurationMs": 3281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、今、今。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5610109,
    "dDurationMs": 2291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5610119,
    "dDurationMs": 5281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、オ、オ、オ、オッケー。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "で、これで",
      "tOffsetMs": 921,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5612390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5612400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめらな、マジで最強バッファーの可能性あるからな。全然",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5616310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5616320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだ。だ、メラちゃんのバフを受け取ってる可能性あるからね。ソピア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5620310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5620320,
    "dDurationMs": 2280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5621070,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5621080,
    "dDurationMs": 4039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "くれご役。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5622590,
    "dDurationMs": 2529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5622600,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これでロビー作って",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5625109,
    "dDurationMs": 1411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5625119,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "真っ白にしよう。ソピア。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5626510,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5626520,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。開けるよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5628470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5628480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、やべえ。ガチで普通に普通にその",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5631990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5632000,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソルの分まで吸っちゃってる可能性ある?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5634030,
    "dDurationMs": 1770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5634040,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。吸っちゃってる。お前が",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5635790,
    "dDurationMs": 1889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5635800,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "IQ",
      "acAsrConf": 0
    }, {
      "utf8": "されなんか",
      "tOffsetMs": 359,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5637669,
    "dDurationMs": 1891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5637679,
    "dDurationMs": 4641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "全員のうん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5639550,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5639560,
    "dDurationMs": 4079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽されてる。マジ普通に",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5642310,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5642320,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "チューンってしてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5643629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5643639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、本当だよ。これこうしてじゃあ行きますか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5647750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5647760,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お準備整いましたか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5649430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5649440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。じゃあ画面共有意します。これメラちゃんも見てる。お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5652709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5652719,
    "dDurationMs": 3121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5653750,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5653760,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しみなの?じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5655830,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5655840,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見れる?おいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5657229,
    "dDurationMs": 651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5657239,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見れました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5657870,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5657880,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5659189,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5659199,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見れましたのじゃあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5660709,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5660719,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、楽しみだな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5662070,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5662080,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "しゃあ行くぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5663910,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5663920,
    "dDurationMs": 2759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "リバは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5665510,
    "dDurationMs": 1169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5665520,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5666669,
    "dDurationMs": 1771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5666679,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分かりやすいからいいよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5668430,
    "dDurationMs": 809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5668440,
    "dDurationMs": 1160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "シンプルで",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5669229,
    "dDurationMs": 371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5669239,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5669590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5669600,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、メラちゃんはリバシ得意ではないの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5672590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5672600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ソピアにボコボコにされて一色にされるぐらい苦手ですのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5676830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5676840,
    "dDurationMs": 1279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5677109,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5677119,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、じゃ一緒だ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5678109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5678119,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみにメロアちゃんソフィアちゃんの弱点ってなんかないの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5681109,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5681119,
    "dDurationMs": 2241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5682109,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5682119,
    "dDurationMs": 2681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5683350,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5683360,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ多分このままたら普通に負けるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5684790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5684800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えっと、えっと、普通に弱いです。ソフィア普通に弱いです。なじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5689470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5689480,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなさ、こっからさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5690830,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5690840,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんな痛み、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5691790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5691800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。え、何殴るってこと?縛るの?ソフィアがやめろ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5696950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5696960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "普通に殴れて靴以外には強いんですよ。この世の全てを",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5702830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5702840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何人でも好奇心があるので",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5705390,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5705400,
    "dDurationMs": 2759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5705830,
    "dDurationMs": 2329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5705840,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "靴以外何でも行けちゃうんですよ、この子。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5708149,
    "dDurationMs": 2171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5708159,
    "dDurationMs": 3601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "任してください。何でも食います。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5710310,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5710320,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジでも食います。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5711750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5711760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピア、お前あんまりホロライブでそういうこと言わない方がいい。本当にやばいもん食わされる可能性あるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5716910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5716920,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい、やばい、やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5719189,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5719199,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、虫食されちゃうよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5720709,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5720719,
    "dDurationMs": 2440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "虫は全然いけますよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5722229,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5722239,
    "dDurationMs": 2521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5723149,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5723159,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ほんまにかよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5724750,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5724760,
    "dDurationMs": 4640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうこんなの無敵すぎる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5726390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5726400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、言うけど言わん方がいいてた。ソフィあんまりそういうこと。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5729870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5729880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、そやちゃんそこまで言わなくてもいいんじゃ。言わなくてもいい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5734430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5734440,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ行くぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5735950,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5735960,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "スバルが黒。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5737510,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5737520,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5737910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5737920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、先手。先手はあれ、ま、黒がスバルで白がソピーちゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5742629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5742639,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、はい。白色に染み上げます。この番な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5745149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5745159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んでここ置けない?ああ、これあれご目並べじゃなかったわ。ちょっとごめん。ちょっとし",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5750709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5750719,
    "dDurationMs": 2601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5751070,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5751080,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。大丈夫。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 1079,
      "acAsrConf": 0
    }, {
      "utf8": "背負ってるよ。",
      "tOffsetMs": 1480,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 2079,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5753310,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5753320,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "期生やばいやばいやばい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5754550,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5754560,
    "dDurationMs": 4599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "期生背負ってますよ。",
      "tOffsetMs": 119,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5756149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5756159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピや、そや全然行けそうじゃん。なんか",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5759350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5759360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。あれけそうじゃん。ナメプでも行けるかもし。メプちゃん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5765070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5765080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よ。これ日期生の異厳がなくなるよ。言わせてもらいますけど。ホロライブで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5769310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5769320,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5769550,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5769560,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "年やらせてもらってんのか。あらららららららら",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5772510,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5772520,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あららららら。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5773750,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5773760,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あららららら。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5775430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5775440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっと待ってくださいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5778470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5778480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか恥を取るのが大事なんですよね。リバシって",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5782430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5782440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "バカ。あめ。それスバルの秘作なんだからあんま言うな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5785990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5786000,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、そっか、そっか。かな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5787790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5787800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あんま言う。あ、そっか、そっか。ソビアちゃんでも知らないよね。そんな知らない。知らない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5793149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5793159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さすがの、さすがのさんでも知らないと思で",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5796390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5796400,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8",
      "acAsrConf": 0
    }, {
      "utf8": "年で続いてるからね。",
      "tOffsetMs": 239,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5797950,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5797960,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。そうだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5799950,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5799960,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5800870,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5800880,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5801990,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5802000,
    "dDurationMs": 3239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初めての端っこ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5803910,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5803920,
    "dDurationMs": 2719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5805229,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5805239,
    "dDurationMs": 2440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほどね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5806629,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5806639,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5807669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5807679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱ、やっぱ聞こえてるとこで話しちゃだめでしょ、先輩。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5810910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5810920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あんまり情報話す。聞こえてますね。ごめ、ごめ、ごめん、ごめん。そっか、そか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5814270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5814280,
    "dDurationMs": 1280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5814870,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5814880,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、ごめん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5815550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5815560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回さ、え、ソフィア、これどうやったら勝てんの、このゲーム。ちょっと待って。敵に聞く、敵に。ごめ、あの、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5821910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5821920,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5822030,
    "dDurationMs": 2810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5822040,
    "dDurationMs": 4280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "期生だけど、あんまりプライドとかないからごめん。これどっんの?これ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5824830,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5824840,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "プライドねえのかよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5826310,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5826320,
    "dDurationMs": 4839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねえよ、これ。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5828149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5828159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんで基本的にはまず真ん中を置けるなら真ん中置いた方がいいです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5832709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5832719,
    "dDurationMs": 4721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなんだ。優しい。ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5834430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5834440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "優しい。おい、だいぶ舐められてるか。めっちゃ優しいか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5838070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5838080,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どっかどっちかどっちかだな、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5839790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5839800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どっちかだな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5842910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5842920,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5845270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5845280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやあ。え、まだ、え、ソピア的にはオセロやってる人的にはどうなの?こ、こっからでも両方勝てる?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5852750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5852760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、全然勝てると思う。で、ソフィアもマジで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5856510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5856520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのよくある定石しか知らないからそこを覆えされたらかなり厳しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5860990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5861000,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ちょっと待って。よくある定石って何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5863189,
    "dDurationMs": 2371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5863199,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "セオリーがあるらしい。ですか定って?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5865550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5865560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっといや、ま、混じってる。お前も混てくるから。ま、確かにボされたんだもん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5870990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5871000,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ナメラもメラも起こされたんだもん。そう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5873229,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5873239,
    "dDurationMs": 4601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、一にされてますので。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5874830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5874840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分かった。ちょっとじゃあ頼む。メラ。メラもうなんか困ったらあのソピアに聞いてくれ。ありがとうって。そ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5881430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5881440,
    "dDurationMs": 5279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、どこに置かれたらいか教えてくれるかもしれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5884189,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5884199,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに確かに確かに。確かに。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5886709,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5886719,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ええ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5889589,
    "dDurationMs": 2291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5889599,
    "dDurationMs": 5281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わからんな。先が読めないのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5891870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5891880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、やめてよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5896030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5896040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やめてよ。ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5899589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5899599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、どうすりゃいいの?いや、これだいぶでも苦しそうじゃない?すぐ悪るが",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5906750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5906760,
    "dDurationMs": 2240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "苦しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5908070,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5908080,
    "dDurationMs": 3039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5908990,
    "dDurationMs": 2129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5909000,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すいません。いきます。角が",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5911109,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5911119,
    "dDurationMs": 2241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やべ。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5912270,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5912280,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これはまずい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5913350,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5913360,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラ聞いてくれ。メラ聞いてくれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5914870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5914880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、え、え、そ、ソアさん、あの、こ、こっからでも勝てますか?まだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5919510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5919520,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、まだね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 639,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5920310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5920320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個だけだから角取ったの。他の角取られたら全然負ける可能性あるんで。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5924709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5924719,
    "dDurationMs": 1520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5925270,
    "dDurationMs": 969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5925280,
    "dDurationMs": 3800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっとあの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5926229,
    "dDurationMs": 2851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5926239,
    "dDurationMs": 5041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3/4",
      "tOffsetMs": 161,
      "acAsrConf": 0
    }, {
      "utf8": "残って。",
      "tOffsetMs": 880,
      "acAsrConf": 0
    }, {
      "utf8": "え、ちなみにソピア今",
      "tOffsetMs": 1721,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5929070,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5929080,
    "dDurationMs": 5200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "番置かれたら嫌なとこと変な。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5931270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5931280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、ナイス、ナイス、ナイス、ナイス、ナイス。ああ、でもやっぱ橋でなんかちょっと開けられておかれたりするとちょっとやだかな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5938229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5938239,
    "dDurationMs": 4761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "開けて置かれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5939990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5940000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一旦橋とかなくね?なんかどこが橋なの?これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5943270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5943280,
    "dDurationMs": 1800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "橋まだないの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5944310,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5944320,
    "dDurationMs": 2160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ないよね。ない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5945070,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5945080,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ど、ど、どこだ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5946470,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5946480,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。それそこれる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5948470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5948480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもでもそうなってくるともうここのライン置けないわけよ。分かる?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5952910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5952920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、どこなら置けるんじゃろう?箸。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5956589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5956599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、こっから勝てる保険あるんですか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5959709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5959719,
    "dDurationMs": 4041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あるらしい。あるらしい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5960990,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5961000,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あるってソび言ってしたのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5963750,
    "dDurationMs": 650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5963760,
    "dDurationMs": 1520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5964390,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5964400,
    "dDurationMs": 4279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あるんか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5965270,
    "dDurationMs": 3409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5965280,
    "dDurationMs": 3399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 240,
      "acAsrConf": 0
    }, {
      "utf8": "人で考えようぜ。",
      "tOffsetMs": 399,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5969470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5969480,
    "dDurationMs": 1119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5969589,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5969599,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人の頭脳で",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 881,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5970589,
    "dDurationMs": 2251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5970599,
    "dDurationMs": 3761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人に勝てるかどうかっていう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5972830,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5972840,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "情けねえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5974350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5974360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "情けねえよ、これ。こ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5977470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5977480,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5978109,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5978119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。もお願いし先輩が端っこ取ってもすぐソフィアが",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5983470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5983480,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何これ?何が起こってる?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5985430,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5985440,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "わからない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5987149,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5987159,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5988510,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5988520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、やばい。一色に変えられる。また",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5991030,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5991040,
    "dDurationMs": 2800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "列。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5991510,
    "dDurationMs": 2330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5991520,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。ま、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5993830,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5993840,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5994550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5994560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "落ち着け、落ち着け、皆の州。ここで気を見な。こういうことだ。つまり、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6000390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6000400,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つまりこういうことだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6001430,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6001440,
    "dDurationMs": 1159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6001990,
    "dDurationMs": 609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6002000,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6002589,
    "dDurationMs": 1451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6002599,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6004030,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6004040,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6005830,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6005840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6006390,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6006400,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "が真っ白にされた時となんか似たような感じ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6008830,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6008840,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジ?ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6010070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6010080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか似てる。なんかなんか似てる。似てる。え、似てる。ちょっとま、まだこっからですよ。勝負は。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6015870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6015880,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだこっから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6016390,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6016400,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当ですか?ソピアさん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6017910,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6017920,
    "dDurationMs": 4799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。全然。ちょっとね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6019950,
    "dDurationMs": 2769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6019960,
    "dDurationMs": 5759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとなんかさっきよりあの返事まで時間か。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6022709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6022719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6025790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6025800,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうなの?じゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6027310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6027320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、だから一旦こうでしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6030390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6030400,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6033070,
    "dDurationMs": 3250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6033080,
    "dDurationMs": 4760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "ちょ、こうでしょ。",
      "tOffsetMs": 1159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6036310,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6036320,
    "dDurationMs": 2919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 319,
      "acAsrConf": 0
    }, {
      "utf8": "期生の異が",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6037830,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6037840,
    "dDurationMs": 4399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれなんか、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6039229,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6039239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、わし回りたいじゃけどさすがにスボル先輩を応援したくなる盤面。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6044669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6044679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちょっとさすがにさ、ちょっとさ、そさん、そやさん、ソビやさん、あの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6050550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6050560,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6050830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6050840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "個めっちゃ置けるとこ見えてると思うんすけど、ちょ、一旦そこやめてもらおう。ことかてやばい、やばい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6060390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6060400,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ささん、あの、",
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 640,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6061350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6061360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回そこちょっとなんか、あの、ちょっと焼肉おるんでちょっと",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6065629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6065639,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回スキップことかあって可能すかね。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6070510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6070520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "プライドがない。そ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6074990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6075000,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "プライドとかはない感じだ。ま、プライドないか。ま、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6077990,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6078000,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回目。",
      "tOffsetMs": 119,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6078510,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6078520,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ない感じだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6080310,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6080320,
    "dDurationMs": 4399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "は、ちなみに買収される系。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6081709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6081719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、ま、でもあの、あの、買収とかないから。そんなね、そんなことないから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6087470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6087480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一緒に科学に行くという約束を取りけた上で。そう。おセロは自由だから。そんな別にこれうん。おセロは自由だ。だから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6096830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6096840,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6097830,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6097840,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいよ。自由に自由に置いてみて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6099750,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6099760,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、自由に。自由だって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6101270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6101280,
    "dDurationMs": 5439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、科学と焼肉。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6104270,
    "dDurationMs": 2449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6104280,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、もうね、全然いいとこ連れてきますよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6106709,
    "dDurationMs": 2571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6106719,
    "dDurationMs": 3880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "全ピアいでる。ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6109270,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6109280,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "偉いでますよ。ソピアさんに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6110589,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6110599,
    "dDurationMs": 1961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6111750,
    "dDurationMs": 810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6111760,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "焼肉。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6112550,
    "dDurationMs": 2049,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6112560,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアよく考えてみるの。じゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6114589,
    "dDurationMs": 491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6114599,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6115070,
    "dDurationMs": 1529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6115080,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "自分とは何か。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6116589,
    "dDurationMs": 1971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6116599,
    "dDurationMs": 4961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、深のためにここに来たのか。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6118550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6118560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。深い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6121589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6121599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "待って。オセロってそんな深いこと考えながら打つのかよ。マジかよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6125790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6125800,
    "dDurationMs": 5359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃからこんなに勝つんじゃないですか、やはり。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6128149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6128159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、なるほどね。確かに考えてる量が違うのかな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6131870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6131880,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6133149,
    "dDurationMs": 2651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6133159,
    "dDurationMs": 3761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、ソピアは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6135790,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6135800,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6136910,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6136920,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいぞ。ソピアどこに置いたっていいぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6138910,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6138920,
    "dDurationMs": 5000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かかってこい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6141270,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6141280,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "せってやつを見せてやるよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6143910,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6143920,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "どこに置くんだ?",
      "tOffsetMs": 799,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6146390,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6146400,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どこに置くんだ?そ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6148510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6148520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばすまる先輩",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6151709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6151719,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "買収されてや",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6154510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6154520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "買収されたのにすされたくせに置けてなくて一瞬端ことしてたちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6165430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6165440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもあれですよね。さっき置かなかったからもうあれですよね。焼肉は決まりですもんね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6170910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6170920,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう諦めてるやん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6172189,
    "dDurationMs": 651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6172199,
    "dDurationMs": 3601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "決まりだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6172830,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6172840,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ピアさ、これ見てた。もしかしてちょっと待って。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6175790,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6175800,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そんなわけないよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6177430,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6177440,
    "dDurationMs": 2199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6177830,
    "dDurationMs": 1809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6177840,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなわけないじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6179629,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6179639,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6180669,
    "dDurationMs": 1291,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6180679,
    "dDurationMs": 3121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、もしかしてこれ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6181950,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6181960,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最初から",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 440,
      "acAsrConf": 0
    }, {
      "utf8": "つとも",
      "tOffsetMs": 639,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6183790,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6183800,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "理由たか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6185390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6185400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最初から全部取るつもりだそうのことかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6189070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6189080,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6190669,
    "dDurationMs": 2331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6190679,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "してやられた。これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6192990,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6193000,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "拍手だ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6195030,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6195040,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えい。いな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6196510,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6196520,
    "dDurationMs": 3079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、ちょ、ちょ、ま、落ち着いてください。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6197870,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6197880,
    "dDurationMs": 4719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "感じゃの、やっぱ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6199589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6199599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、ま、一旦落ち着きましょうよ。そんなね、焦る時間じゃない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6206510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6206520,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう焦ってくれ。こんな埋まってたら",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6208830,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6208840,
    "dDurationMs": 2879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当じゃ。あれ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6210950,
    "dDurationMs": 769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6210960,
    "dDurationMs": 3679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "焦ってくれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6211709,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6211719,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って、ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6214629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6214639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかさっきからスバル先輩があの、置こうとして置けないがめちゃくちゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6218629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6218639,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "や、やばい、やばい、やばい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6220990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6221000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい、やばい。めっちゃ塗られてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6225030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6225040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうだ?おら、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6229990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6230000,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おやおや。まずいのでわさん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6232589,
    "dDurationMs": 2851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6232599,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "親ソピア先生聞いていいですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6235430,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6235440,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6235790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6235800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここから入れる保険ありますか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6239030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6239040,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6239550,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6239560,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "な、な、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6241070,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6241080,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ど、どうじゃ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6242070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6242080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6246390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6246400,
    "dDurationMs": 3759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっから入るなし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6249149,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6249159,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "な、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6250149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6250159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソフィア、お前はコロナイブセロ大会を開け。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6253310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6253320,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6255070,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6255080,
    "dDurationMs": 4159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やってくれ。やってくれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6256390,
    "dDurationMs": 2849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6256400,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やってくれ。お前。ちょっと待って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6259229,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6259239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと待って。これさ、これ待って。ちょっとさ、あめともやってほしいわ。これすの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6265830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6265840,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "無理、無理、無理。確かに確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6268030,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6268040,
    "dDurationMs": 3119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、マジでおる本当に弱いよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6270750,
    "dDurationMs": 409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6270760,
    "dDurationMs": 3399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6271149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6271159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回弱くてもいいからちょっと見たい、見たい。このスマがそやばかっただけなんか、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6277629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6277639,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、ソフィアちゃん、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6278390,
    "dDurationMs": 2570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6278400,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソフィアがマジで強いんかみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6280950,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6280960,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6281910,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6281920,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソフィアの感想言っていいですか?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6283910,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6283920,
    "dDurationMs": 1560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6284750,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6284760,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "な、なんじゃ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6285470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6285480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ソフィアはやっぱそんな強くないっす。人や、てめえだけあんだけこでした。お前",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6295390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6295400,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オキルされてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6297070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6297080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ホロライブってやつを分からせてやろうか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6301109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6301119,
    "dDurationMs": 5761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "先輩が怒ってるよ。ソフィア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6303870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6303880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "マジでソフィア自分のことリワイス強いって思ったこと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6307070,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6307080,
    "dDurationMs": 4119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回もなくて。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6308189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6308199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おいおい、そんなこと言っていのか。なきりさんやったってください。じゃ、煽られてますよ。キりさんやったてください。なりさん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6317229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6317239,
    "dDurationMs": 3321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6317550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6317560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どうちまるより弱い可能性が全然あるのに弱。まずいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6323310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6323320,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6324430,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6324440,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとじゃきたら言って。これで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6326870,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6326880,
    "dDurationMs": 4279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ルム作りました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6328510,
    "dDurationMs": 2649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6328520,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オ画面鏡お願いします。よいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6331149,
    "dDurationMs": 2891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6331159,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 121,
      "acAsrConf": 0
    }, {
      "utf8": "回抜ければいいんですかね?",
      "tOffsetMs": 241,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6334030,
    "dDurationMs": 2490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6334040,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。抜けて。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6336510,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6336520,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "フレンドを探して。",
      "tOffsetMs": 560,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6339430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6339440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっとオセロ大会の時代来るか、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6342709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6342719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやあ。え、でもあ木先輩がめっちゃ強いらしくて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6347430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6347440,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6347950,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6347960,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、そうだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6349430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6349440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ木先輩には多分めっちゃもうぼっこボコにされると思うよ。ソ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6353189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6353199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、いいじゃん。ソピー、ソピアなんか場みたいな送ってみたらなんか場なんか何分待つみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6358870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6358880,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。裏にて",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6360950,
    "dDurationMs": 330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6360960,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6361270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6361280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかホロライブ事務所裏にますみたいななん",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6366149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6366159,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ワン",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6366510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6366520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにじゃ、あめ先輩勝ったらじゃあちょっと送っちゃおうかな。もう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6371550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6371560,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0
    }, {
      "utf8": "人します。",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6372589,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6372599,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。ここなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 1161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6373950,
    "dDurationMs": 2729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6373960,
    "dDurationMs": 5719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "立てしてるってことになるもんね。メラ含めてこれ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6376669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6376679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。なきまでに。ちなみにこれメラもこれぐらいの差で負けたんだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6384430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6384440,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのわしは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 920,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6385550,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6385560,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "枚も自分の色がない状態で負けました。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6388430,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6388440,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6390790,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6390800,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "までもあれだからね。ゴリ担当じゃない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6393750,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6393760,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごリ担当だからこう時点",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6395470,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6395480,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "運でしか勝てませんのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6397070,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6397080,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、運があることはいいことだよ本当に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6399830,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6399840,
    "dDurationMs": 3879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6400709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6400719,
    "dDurationMs": 4721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。可愛いな。の",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6403709,
    "dDurationMs": 1731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6403719,
    "dDurationMs": 4721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6405430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6405440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そしてじゃこれで行けるかな?来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6410669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6410679,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。楽しみですの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6413189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6413199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、リバーシマジで",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6416390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6416400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、普通にその、あめのリバーシてえわ。はい。映ってます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6419950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6419960,
    "dDurationMs": 4639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6421589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6421599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、白がソピちゃんで黒が、あめです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6425109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6425119,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。ふん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6425910,
    "dDurationMs": 809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6425920,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6426709,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6426719,
    "dDurationMs": 1841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "雪のように。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6428390,
    "dDurationMs": 170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6428400,
    "dDurationMs": 2279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6428550,
    "dDurationMs": 2129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6428560,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう冬の北海道のように",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6430669,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6430679,
    "dDurationMs": 2201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "真っ白に染め上げられる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6432470,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6432480,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6432870,
    "dDurationMs": 2809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6432880,
    "dDurationMs": 5799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "北海道もう雪降ってるらしいからな、今日。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6435669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6435679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうなんだ。そう、そう、そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6438830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6438840,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "早いですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6439830,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6439840,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。早い。え、メラちゃんさ、え、やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6441910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6441920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "普通に雑談しちゃうわ。寒いの得意なんとか言って。寒いの得意なんとか言。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6447310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6447320,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "寒いの。暑いのよりは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6450030,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6450040,
    "dDurationMs": 1599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱ得意。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6450950,
    "dDurationMs": 689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6450960,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "得意です。なのじゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6451629,
    "dDurationMs": 1731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6451639,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "熱いのが苦手なんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6453350,
    "dDurationMs": 329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6453360,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6453669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6453679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかいろんなこと知りたくなっちゃ。お、なんか大丈夫そう。なんかもう、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6456709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6456719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、なんかめちゃくちゃ端っこてやばさな黒ですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6462750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6462760,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、やばいやばいやばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6465070,
    "dDurationMs": 1169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6465080,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "黒ですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6466229,
    "dDurationMs": 771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6466239,
    "dDurationMs": 3761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいやばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6466990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6467000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "橋に置いちゃダメて言ったじゃないですか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6470270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6470280,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、されておる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6473070,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6473080,
    "dDurationMs": 4240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "橋は誰なんだ?橋は。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6474310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6474320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、橋、橋じゃえ。どこに置けてんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6479669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6479679,
    "dDurationMs": 2241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ふんふん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6480189,
    "dDurationMs": 1731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6480199,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ふんふんふん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6481910,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6481920,
    "dDurationMs": 4719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6483629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6483639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっから入れる保険は",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6487109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6487119,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっからまだわかんないんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6488910,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6488920,
    "dDurationMs": 2160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここから全然入れます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6490229,
    "dDurationMs": 851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6490239,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。そうだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6491070,
    "dDurationMs": 1089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6491080,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6492149,
    "dDurationMs": 931,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6492159,
    "dDurationMs": 3921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最初そうだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6493070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6493080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。そうだよ。まだわかんないよ。そう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6496589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6496599,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なキりさんゲームうまいんだから",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6499030,
    "dDurationMs": 1569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6499040,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫でしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6500589,
    "dDurationMs": 931,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6500599,
    "dDurationMs": 3921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうそうだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6501510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6501520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。そうだよ。ナキりさん。うん。うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6506790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6506800,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6507910,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6507920,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どう?ソピアちゃんなんか手応えとしてはどう?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6510790,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6510800,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ま、まだ全然わかんないかな?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6512510,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6512520,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、わかんないね。ゴブ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6513830,
    "dDurationMs": 1250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6513840,
    "dDurationMs": 2399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだわかんないよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6515070,
    "dDurationMs": 1169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6515080,
    "dDurationMs": 4159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ふん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6516229,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6516239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これメラマジでさ、ソフィアがさ、何考えてるか知りたくね?これ売ってる時。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6521390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6521400,
    "dDurationMs": 3040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、知りたいですの?じゃあ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6522629,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6522639,
    "dDurationMs": 4801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかよくわからないなと思って見てない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6524430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6524440,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかなんか色がどんどん変わってくみたいな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6527430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6527440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そう。なんかなんでここに置くかとかがなんかなんて先を読むとかが全くわからないから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6532629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6532639,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分かるよ。めら",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6534830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6534840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかとりあえずここやみたいな直感で選んでみるんじゃけど全部",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6539510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6539520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "結るんだよな。そうそう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6544870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6544880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、でもいい感じだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6548229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6548239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、いい感じなのかな、これは。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6551390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6551400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ま、スバルから見ると相当いい感じに見えるけどね。色半分だし。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6555790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6555800,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに半分だし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6556870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6556880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。これ実況解説のレベル低すぎるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6560310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6560320,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "半分ではあるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6561669,
    "dDurationMs": 2611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6561679,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "色半分だしとかね。メラちゃん色半分だね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6564270,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6564280,
    "dDurationMs": 2919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "は実況な。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6565870,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6565880,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6567189,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6567199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ボロ負けしてる人ができないのじゃ。そんな実況。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6570310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6570320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すごいなみたい。でもさ、やっぱさ、内側の色を取ることが大事だと思うんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6575790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6575800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6579510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6579520,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6580350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6580360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。なんかでもやっぱソピア強くね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6585030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6585040,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいやいやいや。そんなそ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6586030,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6586040,
    "dDurationMs": 1800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "迷いがない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6586950,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6586960,
    "dDurationMs": 2279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "迷いないよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6587830,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6587840,
    "dDurationMs": 3640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6589229,
    "dDurationMs": 2251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6589239,
    "dDurationMs": 5241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、そんなポンポ置げないんだけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6591470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6591480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫。早めのペースでやってこうよ。橋は置いちゃダめらしい。え、橋以外になんかやっちゃいけないことあんの?そっぴーちゃん、これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6599709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6599719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "橋か。あと序盤を実はあんまり取らない方がいいって聞いたことあります。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6604470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6604480,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、何それ?最初に言ってほしいのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6606430,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6606440,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなの確かに",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6608430,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6608440,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "序盤さ来たぞつってめっちゃ取ってたわ。スバルも。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6611350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6611360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうそうそうそうそうそうそう。嬉しくて。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6614430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6614440,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。いや、ちょっとそれはね、あんまり良くない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6617109,
    "dDurationMs": 1891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6617119,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6618990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6619000,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "角取られちゃった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6620350,
    "dDurationMs": 2210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6620360,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でもまだ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 799,
      "acAsrConf": 0
    }, {
      "utf8": "角だからやべ。",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 2000,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6622550,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6622560,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "角わかんないよ、これ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6624390,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6624400,
    "dDurationMs": 1920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 560,
      "acAsrConf": 0
    }, {
      "utf8": "角取れば",
      "tOffsetMs": 719,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6625870,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6625880,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 279,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6626310,
    "dDurationMs": 2690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6626320,
    "dDurationMs": 3359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "角取ればいけるもん。なめラ理論ではな。ま、ま、ま、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6628990,
    "dDurationMs": 689,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6629000,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなんです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6629669,
    "dDurationMs": 2411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6629679,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "角取ったら多分。く",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6632070,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6632080,
    "dDurationMs": 3119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そ、多分",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6633030,
    "dDurationMs": 2169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6633040,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "盾を許すな。",
      "tOffsetMs": 280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6635189,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6635199,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、まだ、まだ行けるよね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6636510,
    "dDurationMs": 3169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6636520,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 280,
      "acAsrConf": 0
    }, {
      "utf8": "つありますからね。",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6639669,
    "dDurationMs": 371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6639679,
    "dDurationMs": 2721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6640030,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6640040,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ま、まだ行けるよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6642390,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6642400,
    "dDurationMs": 1880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだ行ける。やべ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6643950,
    "dDurationMs": 330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6643960,
    "dDurationMs": 2440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "死んで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6644270,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6644280,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "声ずっと余裕。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6646390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6646400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前何回おセロしてきなんだ。ホロライブで思い出せ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6651870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6651880,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、全然未来が見えません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6653950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6653960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オセロした日々をグラグで走りながらオセロしただろ思い出せ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6659669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6659679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "先生全く未来が見えません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6662790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6662800,
    "dDurationMs": 2359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "心が折れちゃった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6664550,
    "dDurationMs": 609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6664560,
    "dDurationMs": 3599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やべ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6665149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6665159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "このです。どこに置いても取り返される未来しか見えません。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6669830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6669840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張れ。後手先を読め。ご手先を。後手先読んでも真っ暗なんだが。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6679830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6679840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかさ、このさ、橋取るのソピアめっちゃうまい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6683669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6683679,
    "dDurationMs": 1281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、うまい",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6684510,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6684520,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6684950,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6684960,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "囲まれてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6686470,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6686480,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "気づいたら。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6686950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6686960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。気がついたらね。え、こんなんこっちに白置かれたら終わりますやみたいな地形ばっかりになっちゃうんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6692109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6692119,
    "dDurationMs": 5881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "やばい。始まったぞ。ソピアの",
      "tOffsetMs": 681,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6694990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6695000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいやばいやばいやばい。自郎から覆えされていくやつ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6698950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6698960,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6699350,
    "dDurationMs": 1930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6699360,
    "dDurationMs": 4920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そぴまる?まだ勝てますか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6701270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6701280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや正直にスバル先輩より強い。お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6708629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6708639,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱりそうなんだ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6709950,
    "dDurationMs": 1169,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6709960,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6711109,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6711119,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱり。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6712350,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6712360,
    "dDurationMs": 4319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どんだけ良かったんや。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6713669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6713679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、やっぱさ、相当直感だからメラとスバルは直感デュエルしてたから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6720629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6720639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、やっぱり今あめ論デュエルしてるから多分あめのが強い",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6725950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6725960,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "先読んでるし",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6727550,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6727560,
    "dDurationMs": 3079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "理論で",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6728510,
    "dDurationMs": 2129,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6728520,
    "dDurationMs": 5119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "勝てませんよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6730629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6730639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、ちなみにソフィアちゃんメラとスバルだったらどっち?ああ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6736189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6736199,
    "dDurationMs": 1761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おいちゃった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6737229,
    "dDurationMs": 731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6737239,
    "dDurationMs": 3601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、まだまだ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 561,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6737950,
    "dDurationMs": 2890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6737960,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "つ目なんで。まだあります。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6740830,
    "dDurationMs": 849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6740840,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いけるいける。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6741669,
    "dDurationMs": 771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6741679,
    "dDurationMs": 3681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだあるよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6742430,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6742440,
    "dDurationMs": 4159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "数値ではいける。数値では",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6745350,
    "dDurationMs": 1249,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6745360,
    "dDurationMs": 2799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うううう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6746589,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6746599,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張れ。あめ。諦めるな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6748149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6748159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやあ、難しいのじゃん。かなり無理な気が。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6754069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6754079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかさ、置いてもちょっとしか取れねえし、すぐ取り返されるんだよな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6759470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6759480,
    "dDurationMs": 2040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう、そう、そう。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6760189,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6760199,
    "dDurationMs": 4321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そうなんだよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6761510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6761520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やなのじゃ。すぐ取り返される。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6764830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6764840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やなのじゃ。やなのじゃ。ちょっていくの。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6771629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6771639,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じわじわとじわじわと。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6773310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6773320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、マジね。ソフィア冷静なんだよ。なんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6777229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6777239,
    "dDurationMs": 4281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかよがさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "30",
      "tOffsetMs": 1000,
      "acAsrConf": 0
    }, {
      "utf8": "秒ぐらい考えてもた",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 2400,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6779830,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6779840,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "秒で返されてい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6781510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6781520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そ、どういうことをさ、考えておせろしてんの?今",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6785709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6785719,
    "dDurationMs": 1641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6786510,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6786520,
    "dDurationMs": 1639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "聞きたい。聞きたい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6787350,
    "dDurationMs": 809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6787360,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6788149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6788159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、もう本当に単純で橋をできるだけ詰めていきたいっていうそこに最適な手をだけ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6795270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6795280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だっそ、それが分かったら苦労し出ねんだよ。それが分かったら",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6802589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6802599,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あめ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6803229,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6803239,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "どういう意味なのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6804910,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6804920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はだからなんか目ら端っこを置くといいらしいぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6808910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6808920,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "端っこに置くといい。なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6810189,
    "dDurationMs": 731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6810199,
    "dDurationMs": 1641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。端っこに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6810910,
    "dDurationMs": 930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6810920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "置けねえのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6811830,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6811840,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。それな、それ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6813910,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6813920,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "置くための土台がねえのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6815750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6815760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それな、それ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6821589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6821599,
    "dDurationMs": 5681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うーん。いや、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6824270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6824280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やあ、置いちゃったらね、ちょ、ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6828189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6828199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあね、ちょ、ここいいんじゃないかなって思うとこあんだけどね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6833950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6833960,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6835149,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6835159,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、いいやん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6837950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6837960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。何のなるほどだ、これは。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6841149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6841159,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初めてでも橋取ったぞ。あめ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6843589,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6843599,
    "dDurationMs": 3401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにやめて。これは",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6845669,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6845679,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こんなに並んでんのに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6846990,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6847000,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いい手でした。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6847990,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6848000,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いい手なんだ。くなかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6849310,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6849320,
    "dDurationMs": 4200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、褒められた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6850510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6850520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "褒めだってさ、スバル褒められなかった。やっぱやめ。うまいんだよ、これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6855910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6855920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "テレベルの争いしてるよ、多分。これ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6859669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6859679,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これスバルと多分結構",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6861830,
    "dDurationMs": 249,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6861840,
    "dDurationMs": 1160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6862069,
    "dDurationMs": 931,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6862079,
    "dDurationMs": 3921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "テレベルよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6862990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6863000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前ちょっと言葉選んだけど。さしてる。さしてる。全然スバルというよ。たち多分めっちゃベルテレベルだぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6872750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6872760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも大丈夫。ソピア的には今だってさ、メこんなにさ、黒と白がさ、この後半戦にさ、なんか綺麗になってのあんまなくない?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6881350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6881360,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そう。ここまで残ってることがありえないのじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6883870,
    "dDurationMs": 1289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6883880,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6885149,
    "dDurationMs": 1411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6885159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6886550,
    "dDurationMs": 1609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6886560,
    "dDurationMs": 4599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のじゃのじ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6888149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6888159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6892790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6892800,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "厳しい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6893950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6893960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "厳しいか。厳しい。厳しい。でもあめこういうないといっぱいあるんだな。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6902030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6902040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかでも持ち直すの得意やん。あやめ。厳しい厳しいとか言いながらなんだかんだやりこなすタイプやん。あやめ。うやばい。これやばい。おい。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6915069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6915079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。これ置くべきじゃなかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6918550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6918560,
    "dDurationMs": 4880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなことはない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6920430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6920440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これやばい。これやばい。本当に。あ、一になる。これ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6924990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6925000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でも一色にはならないんじゃなかろうか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6928270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6928280,
    "dDurationMs": 3359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "番は白になっちゃう。",
      "tOffsetMs": 120,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6930550,
    "dDurationMs": 1089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6930560,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、メラちゃん、これま、",
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 920,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6931629,
    "dDurationMs": 2331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6931639,
    "dDurationMs": 4281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "枚ぐらい残るよね、これ。多分、これ、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6933950,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6933960,
    "dDurationMs": 3759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "23",
      "acAsrConf": 0
    }, {
      "utf8": "枚は残るんじゃない?これ。",
      "tOffsetMs": 360,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6935910,
    "dDurationMs": 1809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6935920,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。なら、なら、なら十分。わ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6937709,
    "dDurationMs": 1131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6937719,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "枚も残らんかった。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6938830,
    "dDurationMs": 2329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6938840,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。スバルもそんな怒ってないから。な",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6941149,
    "dDurationMs": 2131,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6941159,
    "dDurationMs": 5121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "んだがい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6943270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6943280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大丈夫だよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6946990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6947000,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6947629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6947639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これマジ周り囲まれるとオセロってガチで積むんだなっていうのがよくわか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6952390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6952400,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ねえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "どうしよう",
      "tOffsetMs": 1040,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6956510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6956520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だってさ、こんなにさ、置けるとこあったらさ、スファルもうめちゃめちゃ喜んでいろんなとこ置いちゃうんだけど。メラ置かない?これ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6963709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6963719,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よっしゃみたいなすぐ置いちゃうよね。こんなん、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6966510,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6966520,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうドパりまくりですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6968870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6968880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ドパるよね、これ。ここみたいな。え、ソピちゃん今何で悩んでんの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6977149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6977159,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6977709,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6977719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、いや、どんだけ後を取れるかなっていう名前。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6981669,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6981679,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、もうさせ上を目指した。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6983229,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6983239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さらにやばい。さらに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6986870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6986880,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6987589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6987599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こテパにされてよ。どこに置けんの?これどこに置くことが可能?こ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6993830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6993840,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さんアシストがありますよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6996430,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6996440,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かにアシストか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 6997830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 6997840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "アシストあるで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7001189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7001199,
    "dDurationMs": 3601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、そうですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7003189,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7003199,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうなんですよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7004790,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7004800,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7006629,
    "dDurationMs": 651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7006639,
    "dDurationMs": 3641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7007270,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7007280,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一食に染められる。いや、やだ。すごいな。ソピア頑張れ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7016189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7016199,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、でも相みせばこれまで戦った中では",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7021069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7021079,
    "dDurationMs": 1520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "番強い。",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7022030,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7022040,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7022589,
    "dDurationMs": 2811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7022599,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そ、そう、それって、この",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7025390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7025400,
    "dDurationMs": 5080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "人の話、",
      "tOffsetMs": 80,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7028390,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7028400,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "この",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 199,
      "acAsrConf": 0
    }, {
      "utf8": "人の話ですか?",
      "tOffsetMs": 319,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7030470,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7030480,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7030990,
    "dDurationMs": 2370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7031000,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうですね。ホロライブ内での話ですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7033350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7033360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃ、このメラとスバルと、あめだったらティアマン、あめ。え、メラとスバル、スバル先どっちが強い?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7041390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7041400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、オけばよかった。さすがにスバル先輩な。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7047910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7047920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラお前どんだけかったんだよ。逆に弱かったんや。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7053709,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7053719,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんなミラここ置いて欲しいなってとこにばっか置いてくれるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7058350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7058360,
    "dDurationMs": 2319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7058950,
    "dDurationMs": 1729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7058960,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれなんじゃない?メラ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7060669,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7060679,
    "dDurationMs": 4161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "体ですかって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7061830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7061840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "メラはやっぱ素直なんじゃない?ポンと置いちゃうんだよ。喜んでよし。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7066229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7066239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもし強いと思って置いてましたのじゃ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7070430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7070440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前踊らされ踊らされてるぞ。それで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7075470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7075480,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そう。何?何?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7076830,
    "dDurationMs": 2369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7076840,
    "dDurationMs": 5279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか最初の方めっちゃ取れると思って",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7079189,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7079199,
    "dDurationMs": 5161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だって言ってたよ。序盤はあんま取らない方がいいって。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7082109,
    "dDurationMs": 2251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7082119,
    "dDurationMs": 5241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、それ知ってればな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7084350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7084360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それなやばいぞ。早め。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7089990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7090000,
    "dDurationMs": 4239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まず",
      "acAsrConf": 0
    }, {
      "utf8": "え、これどこ行ても角が埋まります。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7093109,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7093119,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7094229,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7094239,
    "dDurationMs": 1440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあ、でも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7094589,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7094599,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "すて先を読んでも、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7095669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7095679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうここまで来たら、ま、置きたいところに置くべきやね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7100430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7100440,
    "dDurationMs": 1159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに思って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7101189,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7101199,
    "dDurationMs": 1561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7101589,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7101599,
    "dDurationMs": 4161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう、もうどこも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7102750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7102760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "アシスト、アシスト。あ、いいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7105990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7106000,
    "dDurationMs": 5159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "失礼します。失礼します。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7108149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7108159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここに置いてもここに置いても角取られて、ここに置いても角取られるんだよね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7115870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7115880,
    "dDurationMs": 4839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7118390,
    "dDurationMs": 2329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7118400,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、",
      "acAsrConf": 0
    }, {
      "utf8": "1",
      "tOffsetMs": 239,
      "acAsrConf": 0
    }, {
      "utf8": "枚でもさ、多くさ、",
      "tOffsetMs": 440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7120709,
    "dDurationMs": 211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7120719,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7120910,
    "dDurationMs": 1769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7120920,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "枚でも多くパス、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7122669,
    "dDurationMs": 1731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7122679,
    "dDurationMs": 4721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "パス置くところないです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7124390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7124400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。置くとこないです。やばい。何枚残る?お、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7129109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7129119,
    "dDurationMs": 2401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "枚ぐらいは残る。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7130550,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7130560,
    "dDurationMs": 1599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "残るんじゃない?します。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7131510,
    "dDurationMs": 649,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7131520,
    "dDurationMs": 2159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと残るんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7132149,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7132159,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "残い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7133669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7133679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7137229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7137239,
    "dDurationMs": 2801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7138629,
    "dDurationMs": 1411,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7138639,
    "dDurationMs": 2241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やばいや。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7140030,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7140040,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うえ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7140870,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7140880,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、これよりは残ってないんじゃない?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7143310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7143320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、でもあんま変わらんよ。しょ、賞味。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7146589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7146599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "正味あんま変わんないんじゃない?え、ソピアお前ガチで強いやん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7151950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7151960,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "強いやん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7153270,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7153280,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ホロライブおせおセロブ部長来た。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7155990,
    "dDurationMs": 1850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7156000,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おセロ大会いてくれ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7157830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7157840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。おセロ大会楽しみだな、これ。ちょっと、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7162109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7162119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、本当に?なんか今すごいなんか異世界転訂した気分だ。め",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7167870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7167880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なけ残っといて。てめえ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7172510,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7172520,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "俺なんかやっちゃいました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7173910,
    "dDurationMs": 2650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7173920,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、俺なんかやっちゃました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7176550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7176560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お前痛みに弱いんだってな。お前されるよ。ソフィアボにこないけどね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7184550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7184560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソフィアが生きてきた世界では全然ソフィアリバーシ強いって言われたことなかったんですけど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7190270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7190280,
    "dDurationMs": 2839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7190589,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7190599,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おい刺されてるぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7193109,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7193119,
    "dDurationMs": 1761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "チクチクチクチク",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7194189,
    "dDurationMs": 691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7194199,
    "dDurationMs": 3681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずいのじゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7194870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7194880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピアさんこれがホロライブですよ。これからよろしくね。ちょ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7199589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7199599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "えちょっと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7201030,
    "dDurationMs": 1569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7201040,
    "dDurationMs": 2039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "やっぱあ先輩に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7202589,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7202599,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7203069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7203079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずはね、アちゃんとね、勝負してほしいわ。ちょっと",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7206229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7206239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見たいね。見たい、見たい、見たい。気になる。で、あ先輩はさすがにソピア無理だと思います。全然本当にソピアクソ雑魚だと思うんで。ピちょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7216790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7216800,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ソピア",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 520,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7217470,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7217480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人ぼしてキの背中を背負ってて。これこのあめとスバルだからいいけど。お前本当に裏からボーンやられる可能性あるから気をつけろよ。ソピアれるぞ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7230229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7230239,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "気をつけ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7231629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7231639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかあったら言いに来いよ。すいません。すいません。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7236390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7236400,
    "dDurationMs": 4239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃありがとうね。今日来てくれてメらちゃんも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7239350,
    "dDurationMs": 1289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7239360,
    "dDurationMs": 2319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございます。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7240629,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7240639,
    "dDurationMs": 3921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとう。楽しかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7241669,
    "dDurationMs": 2891,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7241679,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そやちゃんもありがとうね。急に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7244550,
    "dDurationMs": 1529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7244560,
    "dDurationMs": 3039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあまたね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7246069,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7246079,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。本当ありがとうございまし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7247589,
    "dDurationMs": 2691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7247599,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ありがとうございました。ありがとうございました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7250270,
    "dDurationMs": 1690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7250280,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "またね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7251950,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7251960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "バイバイ。ないちゃん",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7255870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7255880,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "強かったね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7257510,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7257520,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、強かったなあ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7259790,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7259800,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ボコボコだったよ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7261270,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7261280,
    "dDurationMs": 4480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、マジで強くなかったか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7263109,
    "dDurationMs": 2651,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7263119,
    "dDurationMs": 5641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、オセロマジで勝てなかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7265750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7265760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、スバルもさ、はいはい。見せちゃいますか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7268910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7268920,
    "dDurationMs": 3239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7269149,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7269159,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "年分のせろってやつをつってボコボコにされたわ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7274470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7274480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "面木丸つぶりですよ。先輩のでもさ、なんか頼もしいじゃん。今後さ、なんかさ、おセロといえばみたいなね、おセロ大会もね、てくれるかもしんないしね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7288109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7288119,
    "dDurationMs": 3281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7288390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7288400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう言われたらね、全然やりますんでということではい、本日もね、ありがとうございました。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7293229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7293239,
    "dDurationMs": 5121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい、ありがとうございました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7295350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7295360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちなみに、あの、実はあの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7299149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7299159,
    "dDurationMs": 2241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7299350,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7299360,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人のさ、後にさ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7301390,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7301400,
    "dDurationMs": 880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7301750,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7301760,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、もう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 359,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7302270,
    "dDurationMs": 2969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7302280,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人さ、来たいって言ってたんだけど、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7305229,
    "dDurationMs": 1171,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7305239,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、そうなの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7306390,
    "dDurationMs": 2410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7306400,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、でもこれさ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7308790,
    "dDurationMs": 210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7308800,
    "dDurationMs": 3200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7308990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7309000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人しか遊べないんだよ。あーにさんごめん。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7313229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7313239,
    "dDurationMs": 3281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あーにさんごめん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7314950,
    "dDurationMs": 1570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7314960,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7316510,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7316520,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "せか、今度も行こうね。あさん、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7320189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7320199,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ごめんね。今度ギャンブル一緒に行こうね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7322990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7323000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ギャンブル一緒に行こう。やめとけて、お前。ギャンブル",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7327390,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7327400,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ギャンブル系だったら行きますって言って。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7328990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7329000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。ギャンブル系のゲームってなんで遊びたい。はい、ということで、え、本日もありがとうございました。ということで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7339990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7340000,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。ありがとうございました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7342830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7342840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあ最後お休まで終わりますか。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7346310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7346320,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7347069,
    "dDurationMs": 1251,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7347079,
    "dDurationMs": 4241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7348310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7348320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それではせーのお",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7352030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7352040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おつやスパスバン",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7356589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7356599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "バイバイ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7361109,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7361119,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、大富すんの忘れた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7364350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7364360,
    "dDurationMs": 3120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大富豪すんの忘れた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7365390,
    "dDurationMs": 2090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7365400,
    "dDurationMs": 2600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "全然忘れてる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7367470,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7367480,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7367990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7368000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあいいっか。今度またやろうぜ。じゃあね。バイバイ。あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 7371310,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 7371320,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "バイバイ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "バイ",
      "tOffsetMs": 640,
      "acAsrConf": 0
    }, {
      "utf8": "。",
      "tOffsetMs": 1080,
      "acAsrConf": 0
    } ]
  } ]
}
