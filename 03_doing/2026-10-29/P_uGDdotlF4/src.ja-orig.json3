    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5107800,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "さ、なりさんどうすか?",
