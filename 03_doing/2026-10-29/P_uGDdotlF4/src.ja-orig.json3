    "wWinId": 1,
    "segs": [ {
      "utf8": "頑張れるか?",
      "acAsrConf": 0
    }, {
      "utf8": "4",
      "tOffsetMs": 1080,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5166390,
    "dDurationMs": 2610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5166400,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "に決。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "いや、お前頑張れるか。",
      "tOffsetMs": 239,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5168990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5169000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "心の声を",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5172470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5172480,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "惜しい。ま、でもね、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 1159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5173790,
    "dDurationMs": 1650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5173800,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいらしいから。ま、ま、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5175430,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5175440,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "最低の",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 679,
      "acAsrConf": 0
    }, {
      "utf8": "いいよ。",
      "tOffsetMs": 1239,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5177550,
    "dDurationMs": 1730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5177560,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "個はいいよ。全然あり。",
      "tOffsetMs": 200,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5179270,
    "dDurationMs": 2130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5179280,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5181390,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5181400,
    "dDurationMs": 2520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、よ、これ。あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5183350,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5183360,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5183910,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5183920,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あれ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5184950,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5184960,
    "dDurationMs": 4800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、しっかり出していく。お",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5186750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5186760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お、出て。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5189990,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5190000,
    "dDurationMs": 4679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ボーナス狙いね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5191669,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5191679,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、先輩、このデ目でまだチョイス残ってるってのがやばくて。確かに",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5197790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5197800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なめ。あのは何が出ても入れられる。何が出ても入れられる場所で。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5203470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5203480,
    "dDurationMs": 5120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "う、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5204950,
    "dDurationMs": 3650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5204960,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ちょ、もう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 279,
      "acAsrConf": 0
    }, {
      "utf8": "回",
      "tOffsetMs": 400,
      "acAsrConf": 0
    }, {
      "utf8": "6",
      "tOffsetMs": 600,
      "acAsrConf": 0
    }, {
      "utf8": "狙って。こうや。やめ。",
      "tOffsetMs": 880,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5208590,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5208600,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "こっから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5209550,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5209560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、どう?いや、行けんのかな?やるか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5213870,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5213880,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。挑戦しようや。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5215669,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5215679,
    "dDurationMs": 2281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 281,
      "acAsrConf": 0
    }, {
      "utf8": "出るしょ。",
      "tOffsetMs": 560,
      "acAsrConf": 0
    }, {
      "utf8": "6",
      "tOffsetMs": 1440,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5217350,
    "dDurationMs": 610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5217360,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出るしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "6",
      "tOffsetMs": 359,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5217950,
    "dDurationMs": 3930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5217960,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "出るっしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 800,
      "acAsrConf": 0
    }, {
      "utf8": "回出る。",
      "tOffsetMs": 920,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5222470,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5222480,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うわ、えぐ、うわ、えぐチョイスフォ潰します。フライス。ここで、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5230149,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5230159,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5231109,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5231119,
    "dDurationMs": 3721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ここで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "4",
      "tOffsetMs": 401,
      "acAsrConf": 0
    }, {
      "utf8": "ダイス潰す。",
      "tOffsetMs": 600,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5232109,
    "dDurationMs": 2731,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5232119,
    "dDurationMs": 4881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これ、ここ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "4",
      "tOffsetMs": 281,
      "acAsrConf": 0
    }, {
      "utf8": "ダイス潰すの結構やばいの?",
      "tOffsetMs": 481,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5234830,
    "dDurationMs": 2170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5234840,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、わしだったらチョイス入れるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5236990,
    "dDurationMs": 1370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5237000,
    "dDurationMs": 4360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5238350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5238360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、もうちょいでかい方がいいかな。チョイス。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5241550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5241560,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 320,
      "acAsrConf": 0
    }, {
      "utf8": "つ上を狙っていきたい。",
      "tOffsetMs": 480,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5243390,
    "dDurationMs": 1890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5243400,
    "dDurationMs": 3279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうちょい星だ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5245270,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5245280,
    "dDurationMs": 2359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、どうしよう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5246669,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5246679,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、ミスった。よいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5247629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5247639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、よいしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5250910,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5250920,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今回",
      "acAsrConf": 0
    }, {
      "utf8": "6",
      "tOffsetMs": 400,
      "acAsrConf": 0
    }, {
      "utf8": "を狙わしていただきまして。",
      "tOffsetMs": 640,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5253550,
    "dDurationMs": 1050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5253560,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5254590,
    "dDurationMs": 2250,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5254600,
    "dDurationMs": 3119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いけるいける。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5256830,
    "dDurationMs": 889,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5256840,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいよ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5257709,
    "dDurationMs": 2211,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5257719,
    "dDurationMs": 3201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいよ。いいよ。揃ってんのでか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5259910,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5259920,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "6",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "でかいよ。",
      "tOffsetMs": 319,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5260910,
    "dDurationMs": 2570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5260920,
    "dDurationMs": 3319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よっか、お前。ヨっと行けるか。あと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5263470,
    "dDurationMs": 769,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5263480,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "2",
      "acAsrConf": 0
    }, {
      "utf8": "個。",
      "tOffsetMs": 159,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5264229,
    "dDurationMs": 1611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 5264239,
    "dDurationMs": 2041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "よっか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5265830,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
