    } ]
  }, {
    "tStartMs": 5118800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、フダイスだっていいんですけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
