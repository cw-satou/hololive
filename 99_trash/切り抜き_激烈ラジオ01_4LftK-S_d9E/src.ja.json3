  }, {
    "tStartMs": 199789,
    "dDurationMs": 1530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 199799,
    "dDurationMs": 2641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そういうのが目的じゃなくて",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 201309,
    "dDurationMs": 1131,
    "wWinId": 1,
