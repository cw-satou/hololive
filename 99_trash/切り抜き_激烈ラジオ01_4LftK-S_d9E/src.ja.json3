    } ]
  }, {
    "tStartMs": 203000,
    "dDurationMs": 2017,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 203430,
    "dDurationMs": 1587,
