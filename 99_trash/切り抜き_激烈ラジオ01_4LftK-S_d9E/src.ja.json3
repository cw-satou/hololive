      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 241069,
    "dDurationMs": 2971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 241079,
    "dDurationMs": 5961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ぶっちゃけそんなことないんだけどそんな場合じゃないんだけど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 244030,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 244040,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもこのチャンネルを持ってないとお前ら誰なのとかじゃあどんな動画作れんのって本当素材がないから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 250710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 250720,
    "dDurationMs": 3799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 251509,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 251519,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だからねだから今と始めたばっかりだからまだチャンネル登した多分",
      "acAsrConf": 0,
      "isSpeakerChange": 1
