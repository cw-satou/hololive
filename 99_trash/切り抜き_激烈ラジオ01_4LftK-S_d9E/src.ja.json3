    } ]
  }, {
    "tStartMs": 37239,
    "dDurationMs": 4201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そこはね、ほ当ら雑だよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
