    } ]
  }, {
    "tStartMs": 91270,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 91280,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、悪いです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 92830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 92840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "悪いです。ま、ま、ずれどっかのタイミングでなんか流せばいいかなぐらいにしといて一応一応だからあの暫定的にあのボツ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 101516,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 101526,
    "dDurationMs": 3834,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 102350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 102360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でいいやだってちゃんとタイトルとか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 106069,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 106079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 106670,
    "dDurationMs": 2409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 106680,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今日からこういうの始めますみたいな仕切りとかの第",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 109069,
    "dDurationMs": 1330,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 109079,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回目も取ってないじゃん。",
      "tOffsetMs": 161,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 110389,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 110399,
    "dDurationMs": 1441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 110789,
    "dDurationMs": 1051,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 110799,
    "dDurationMs": 1640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ただ喋ってたから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 111830,
    "dDurationMs": 609,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 111840,
    "dDurationMs": 3599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 112429,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 112439,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それで何のこっちゃわかんないまんま知らん人見てもしゃあなと思ったから、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 116590,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 116600,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、ちゃんと区切ろうと思ってる。え、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 119469,
    "dDurationMs": 2970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 119479,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "というわけでまずはあの、え、私",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 122429,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 122439,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "北海道札幌市でお笑い芸人をやりながらカレーとがきっちからやってます。よろしくお願いします。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 130430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 130440,
    "dDurationMs": 4439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、あなたな何て言ったらいいの?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 131869,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 131879,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、僕はもうただただあの一緒にいるおじさんでいいんじゃないですか?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 135710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 135720,
    "dDurationMs": 3851,
    "wWinId": 1,
    "segs": [ {
      "utf8": "一緒にいるおじさんっていうかさ、なんかなんなんでもいいかなんか名前あった方がいいじゃなんでもいい。好きな名前でいいよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 137541,
    "dDurationMs": 2030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 137551,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 142830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 142840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあそうですね。声だけおじさんですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 146030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 146040,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "声だけおじさん。声だけおじさん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 147869,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 147879,
    "dDurationMs": 2401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "声",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 149190,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 149200,
    "dDurationMs": 1560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ではですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 150270,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 150280,
    "dDurationMs": 3480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 150750,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 150760,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、あの僕らね作れるわけじゃない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 155869,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 155879,
    "dDurationMs": 3841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "企画構成して",
      "tOffsetMs": 561,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 158110,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 158120,
    "dDurationMs": 2320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あなた編集してみたいな。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 159710,
    "dDurationMs": 730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 159720,
    "dDurationMs": 2239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 160430,
    "dDurationMs": 1529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 160440,
    "dDurationMs": 2120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 680,
      "acAsrConf": 0
    }, {
      "utf8": "人で",
      "tOffsetMs": 840,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 161949,
    "dDurationMs": 611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 161959,
    "dDurationMs": 3521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 162550,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 162560,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、色々こう動画クリエーションしていこうと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 165470,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 165480,
    "dDurationMs": 2399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 165830,
    "dDurationMs": 2049,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 165840,
    "dDurationMs": 3039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、お仕事もらおうと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 167869,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 167879,
    "dDurationMs": 3681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 168869,
    "dDurationMs": 2691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 168879,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いう営業をかけていこうと言いながら",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 171550,
    "dDurationMs": 1049,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 171560,
    "dDurationMs": 4039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 172589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 172599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "じゃあお前ら何できんのよっていう実績が今ないわけじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 176030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 176040,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうですね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 177149,
    "dDurationMs": 1771,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 177159,
    "dDurationMs": 3720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "僕は僕もて言えないっていう。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 178910,
    "dDurationMs": 1969,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 178920,
    "dDurationMs": 4879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうでしょ?そういうのもあるから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 180869,
    "dDurationMs": 2930,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 180879,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だからとりあえずなんか僕もそういうじゃあ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 183789,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 183799,
    "dDurationMs": 3281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "動画やってますよっていうチャンネル持ってないと",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 186509,
    "dDurationMs": 571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 186519,
    "dDurationMs": 2000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "[笑い]",
      "tOffsetMs": 158
    } ]
  }, {
    "tStartMs": 187070,
    "dDurationMs": 1449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 187080,
    "dDurationMs": 2079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いけないなと思って",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 188509,
    "dDurationMs": 650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 188519,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 189149,
    "dDurationMs": 1691,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 189159,
    "dDurationMs": 2321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ていうきっかけで始めてるわけよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 190830,
    "dDurationMs": 650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 190840,
    "dDurationMs": 1720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 191470,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 191480,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だから特に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 192550,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 192560,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 193070,
    "dDurationMs": 2050,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 193080,
    "dDurationMs": 2400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何か面白い企画をしようとか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 195110,
    "dDurationMs": 370,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 195120,
    "dDurationMs": 2880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
