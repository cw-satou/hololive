    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 257359,
    "dDurationMs": 1600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 257749,
    "dDurationMs": 1210,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 257759,
    "dDurationMs": 1801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それをやっぱり",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 258949,
    "dDurationMs": 611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 258959,
    "dDurationMs": 1120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんて言うの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 259550,
    "dDurationMs": 529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 2519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 260069,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 260079,
    "dDurationMs": 2921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "持ってはいきたいじゃん。その",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    }, {
      "utf8": "万とか",
      "tOffsetMs": 1641,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 262069,
    "dDurationMs": 931,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 262079,
    "dDurationMs": 1521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10",
      "acAsrConf": 0
    }, {
      "utf8": "万とかに。",
      "tOffsetMs": 241,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 262990,
    "dDurationMs": 610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 263000,
    "dDurationMs": 3600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。ね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 263590,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 263600,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そのためにはなんか面白いとかなんか喋ろうとかじゃなくて",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 268189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 268199,
    "dDurationMs": 3629,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まずは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 269390,
    "dDurationMs": 2438,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 269400,
    "dDurationMs": 4448,
    "wWinId": 1,
    "segs": [ {
      "utf8": "チャンネルを持とうから始まっただけだからこれだから何やろうとか特に決まってない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 271818,
    "dDurationMs": 2030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 271828,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 273950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 273960,
    "dDurationMs": 1280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当に決まってない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 274790,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 274800,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 275230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 275240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、今まで何日間かさ結構何時間て何十分ってもう何本か喋ったじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 281150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 281160,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "喋った。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 282270,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 282280,
    "dDurationMs": 4680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもあれも本当取り止めなさすぎたから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 284990,
    "dDurationMs": 1970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 285000,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ただ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "30",
      "tOffsetMs": 240,
      "acAsrConf": 0
    }, {
      "utf8": "分ほとおじさん",
      "tOffsetMs": 600,
      "acAsrConf": 0
    }, {
      "utf8": "2",
      "tOffsetMs": 1840,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 286950,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 286960,
    "dDurationMs": 2560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人が喋ってるだけで",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 288390,
    "dDurationMs": 1130,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 288400,
    "dDurationMs": 1880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "僕見直したのさ。は",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 289510,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 289520,
    "dDurationMs": 3268,
    "wWinId": 1,
    "segs": [ {
      "utf8": "い。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 290270,
    "dDurationMs": 2518,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 290280,
    "dDurationMs": 3840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうねいとか面白くないとかじゃなかった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 292778,
    "dDurationMs": 1342,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 292788,
    "dDurationMs": 4332,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 294110,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 294120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見たくない。これはもう大問題よ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 298673,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 298683,
    "dDurationMs": 1277,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 299270,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 299280,
    "dDurationMs": 1440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大問題だね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 299950,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 299960,
    "dDurationMs": 3760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大問題。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 300710,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 300720,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "大問題だ。なんでこんなよくどこの誰かもしらんおっさんが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 303950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 303960,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "30",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 304310,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 304320,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分喋ってるのを見たくもないって思っちゃった。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 307629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 307639,
    "dDurationMs": 3881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今もそんな変わってねえけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 309230,
    "dDurationMs": 2290,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 309240,
    "dDurationMs": 2519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でも今回は",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "10",
      "tOffsetMs": 840,
      "acAsrConf": 0
    }, {
      "utf8": "分に区るから。",
      "tOffsetMs": 1080,
      "acAsrConf": 0
    }, {
      "utf8": "[笑い]",
      "tOffsetMs": 1888
    } ]
  }, {
    "tStartMs": 311510,
    "dDurationMs": 249,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 311520,
    "dDurationMs": 3239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 311749,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 311759,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分なら我慢できるから。もうこれどうせおいになるから言っちゃうけどさ。あの、そのバの愚痴とかさ、まあまあ長かったからな。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 317013,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 317023,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 321550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 321560,
    "dDurationMs": 3400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあまあいや、あれ、あ、あのバの口はもう",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 324550,
    "dDurationMs": 410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 324560,
    "dDurationMs": 1633,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "回",
      "tOffsetMs": 79,
      "acAsrConf": 0
    }, {
      "utf8": "10",
      "tOffsetMs": 199,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 324950,
    "dDurationMs": 1243,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 324960,
    "dDurationMs": 3253,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分間で取り直したいよ。ちゃんとやりたいわ。言いたいもん。だから、ま、なんかまとめてももう時間もね、そんなないからあれだけど、まとめと言えば、ま、一応は芸人だからそうだね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 326183,
    "dDurationMs": 2030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 326193,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 331423,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 331433,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 335110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 335120,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "これを持って売れたい、バズりたいもあるありますわ。前提にはね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 339469,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 339479,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、あの、ま、あなただって編集ができるわけだから、これを持ってバズるチャンネルになれば仕事依頼増えるかもしんないし、",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 346430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 346440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもそもそものあの始まりは僕らがいろんな企業さんにあの動画っていう営業の素材として君じゃあ何できんの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 355790,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 355800,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "YouTube",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 356070,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 356080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "のチャンネル持ってるんでこれ見てくださいっていうチャンネルみたいな感じ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 359430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 359440,
    "dDurationMs": 3920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "でもせっかくだからなんかこう毎回",
      "tOffsetMs": 920,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 363629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 363639,
    "dDurationMs": 4601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "つのなんかテーマに沿って",
      "tOffsetMs": 161,
      "acAsrConf": 0
    }, {
      "utf8": "10",
      "tOffsetMs": 1400,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 365230,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 365240,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分間喋って最後にまとめており合けって面白いなとかあり合いデスけてなんかまとめる能力あるなとかあ知識豊富だなとかあなんかわかんないけどなんかライフハックに使えるなみたいなちょっとしたね使える雑額みたいなことも",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 379710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 379720,
    "dDurationMs": 3199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10",
      "acAsrConf": 0
    }, {
      "utf8": "分間で喋ってそれを毎日",
      "tOffsetMs": 199,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 383629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 383639,
    "dDurationMs": 3280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    }, {
      "utf8": "日決まった時間にあげていこうと思って",
      "tOffsetMs": 241,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 386510,
    "dDurationMs": 409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 386520,
    "dDurationMs": 1360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10",
      "acAsrConf": 0
    }, {
      "utf8": "分",
      "tOffsetMs": 160,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 386909,
    "dDurationMs": 971,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 386919,
    "dDurationMs": 3481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はいな",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 387870,
    "dDurationMs": 2530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 387880,
    "dDurationMs": 4520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でそれ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "で、",
      "tOffsetMs": 879,
      "acAsrConf": 0
    }, {
      "utf8": "100",
      "tOffsetMs": 1680,
      "acAsrConf": 0
    }, {
      "utf8": "人だ、",
      "tOffsetMs": 1920,
      "acAsrConf": 0
    }, {
      "utf8": "200",
      "tOffsetMs": 2280,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 390390,
    "dDurationMs": 2010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 390400,
    "dDurationMs": 3919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "人だって登録者数が増えて",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 392390,
    "dDurationMs": 1929,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 392400,
    "dDurationMs": 2480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか興味が湧いてきてもらえたら",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 394309,
    "dDurationMs": 571,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 394319,
    "dDurationMs": 3561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 394870,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 394880,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね、そこから初めてなんかこう企画やったり",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 398469,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 398479,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ロケ行ったりもっと言っちゃえばお金がついてくるようになれば",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 402749,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 402759,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんか色々ねお金かけてやったりゲスト呼んだりもしていいわけです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 406430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 406440,
    "dDurationMs": 3594,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それまではとりあえず",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 408909,
    "dDurationMs": 1125,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 408919,
    "dDurationMs": 3135,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ただやるだけ。それまではただ喋ってただ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 410024,
    "dDurationMs": 2030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 410034,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 413550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 413560,
    "dDurationMs": 2919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10",
      "acAsrConf": 0
    }, {
      "utf8": "分取るだけ。",
      "tOffsetMs": 240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 414950,
    "dDurationMs": 1529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 414960,
    "dDurationMs": 4519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "おお、そうか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 416469,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 416479,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それでたまに面白いのがあればいいなって感じ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 420589,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 420599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもね、これ伝わってないと思うけどまま取ったのよ。取ったけどだからあれはもうなしでしょ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 423779,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 423789,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 426950,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 426960,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうね、僕自分で見ててやだったの。どうしよ、これどう流したらいいのかなと思って。いや、面白くないわけじゃないの。面白くない。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 434259,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 434269,
    "dDurationMs": 1971,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 435189,
    "dDurationMs": 1051,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 435199,
    "dDurationMs": 1601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "確かに。あの、分かる。あの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 436230,
    "dDurationMs": 570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 436240,
    "dDurationMs": 2359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 436790,
    "dDurationMs": 1809,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 436800,
    "dDurationMs": 2799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、あなたの話は長かったし。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 438589,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 438599,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 439589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 439599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "俺も確かに石切り不足ではあったのはちょっと認める。ただ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 442775,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 442785,
    "dDurationMs": 3694,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 443749,
    "dDurationMs": 2730,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 443759,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だって",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 241,
      "acAsrConf": 0
    }, {
      "utf8": "番最初にさ、あなたがさ、",
      "tOffsetMs": 401,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 446469,
    "dDurationMs": 2450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 446479,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかさ、いや、じゃあね、あの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 448909,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 448919,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "その僕のなんか引き出しながら喋るみたいな感じで、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 452110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 452120,
    "dDurationMs": 4000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、これ行けそうですねみたいな感じで",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 454589,
    "dDurationMs": 1531,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 454599,
    "dDurationMs": 2481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "プライベートで言ってたじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 456110,
    "dDurationMs": 970,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 456120,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "言ってたね。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 457070,
    "dDurationMs": 2529,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 457080,
    "dDurationMs": 5519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だから、あ、じゃあ僕も行けるかなと思って、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 459589,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 459599,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いざさ、スマホというもさ、カメラ回したらさ、硬いんだもん。結構",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 465110,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 465120,
    "dDurationMs": 4720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初回探り探りだったじゃ。探",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 466830,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 466840,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "りゃ探りだった。だ、プライベートの時みたいに普通に話ればいいのに。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 470629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 470639,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ね、そこはちょっと職業がってる。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 472469,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 472479,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だからそれがなんか硬技なくてなんか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 476180,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 476190,
    "dDurationMs": 4170,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 477350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 477360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、そこはね、そこはもう勘弁してる。それは職風有病ですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 480469,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 480479,
    "dDurationMs": 4160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なんかあの",
      "acAsrConf": 0
    }, {
      "utf8": "AV",
      "tOffsetMs": 801,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 481629,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 481639,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "かなんか最初女の子の人と隣を聞くさん成立してる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 485830,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 485840,
    "dDurationMs": 2759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやそれを初めてやった人みたいな",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 487970,
    "dDurationMs": 629,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 487980,
    "dDurationMs": 2460,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 488589,
    "dDurationMs": 1851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 488599,
    "dDurationMs": 4401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ぎこちねえ感じがすごかったから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 490430,
    "dDurationMs": 2570,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 490440,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいやいやそりゃそうだよ。俺だって寂",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 492990,
    "dDurationMs": 1410,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 493000,
    "dDurationMs": 4400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でもでも",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "3",
      "tOffsetMs": 840,
      "acAsrConf": 0
    }, {
      "utf8": "回",
      "tOffsetMs": 1039,
      "acAsrConf": 0
    }, {
      "utf8": "4",
      "tOffsetMs": 1240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 494390,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 494400,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "回ってやっぱこう取っていったらだいぶ変わってきてたからあやっぱり仕切り直してこう慣れたら今からスタートした方がいいなと思って今日が初回だからこれが初回です。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 502469,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 502479,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、そうすか。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 504070,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 504080,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だから、あの、ま、大体約",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 505909,
    "dDurationMs": 1531,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 505919,
    "dDurationMs": 2960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10",
      "acAsrConf": 0
    }, {
      "utf8": "分間ぐらい、",
      "tOffsetMs": 240,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 507430,
    "dDurationMs": 1449,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 507440,
    "dDurationMs": 3039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、喋って、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 508869,
    "dDurationMs": 1610,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 508879,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 510469,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 510479,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ま、最後、ま、止めて時間につぐみたいな感じでしていこうと思いますんで。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 514909,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 514919,
    "dDurationMs": 3521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なるほど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 515430,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 515440,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "で、もうまもなくね、そろそろ多分時間経つのよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 518550,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 518560,
    "dDurationMs": 4120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何した?今日",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 519670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 519680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だから今日はもう森合介っていう芸人があの声だけおじさんとは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 526670,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 526680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あのこんな動画が作れるよっていう",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 529150,
    "dDurationMs": 530,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 529160,
    "dDurationMs": 3520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "YouTube",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 529670,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 529680,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "チャンネルを用意しましたからみんな登録してこれからも続きを見てねっていうのをまとめた会",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 537269,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 537279,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まとめた回をまたさらにあと残り",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "1",
      "tOffsetMs": 1481,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 538870,
    "dDurationMs": 1409,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 538880,
    "dDurationMs": 2760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "分でまとめることになってる。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 540269,
    "dDurationMs": 1371,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 540279,
    "dDurationMs": 4361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もうここから次回予告。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 541630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 541640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、次回予告ですか?逆に時間全く知らないから。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 544956,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 544966,
    "dDurationMs": 993,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 545269,
    "dDurationMs": 690,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 545279,
    "dDurationMs": 3161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 545949,
    "dDurationMs": 2491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 545959,
    "dDurationMs": 4560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あなただった。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 548430,
    "dDurationMs": 2089,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 548440,
    "dDurationMs": 3560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。え、次回何喋る?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 550509,
    "dDurationMs": 1491,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 550519,
    "dDurationMs": 3361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "知らない。何喋んの?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 551990,
    "dDurationMs": 1890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 552000,
    "dDurationMs": 3360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何がいい?僕に何喋ってほしい?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 553870,
    "dDurationMs": 1490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 553880,
    "dDurationMs": 2920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "何喋ってほしい?あの、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 555350,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 555360,
    "dDurationMs": 4440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、墓地になったやつからでもいい?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 556790,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 556800,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、ボツになったやつからだった。僕は本当にあのババーバの話を聞きたいです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 561509,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 561519,
    "dDurationMs": 2481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、行く、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 562190,
    "dDurationMs": 1810,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 562200,
    "dDurationMs": 1960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "行くよ。あ、多分あれが",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 563990,
    "dDurationMs": 170,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 564000,
    "dDurationMs": 3160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 564150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 564160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "番そのたくさん多く前日に収録した中であなたが生き生きして",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 570750,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 570760,
    "dDurationMs": 2840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあ、それを今取るってことは",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 573110,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 573120,
    "dDurationMs": 3240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 573590,
    "dDurationMs": 2770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 573600,
    "dDurationMs": 3479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "第",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "2",
      "tOffsetMs": 239,
      "acAsrConf": 0
    }, {
      "utf8": "回目の放送でそれ使うから",
      "tOffsetMs": 400,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 576350,
    "dDurationMs": 729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 576360,
    "dDurationMs": 3719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 577069,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 577079,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "実際にそのババーに切れた時から結構期間ないから。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 581190,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 581200,
    "dDurationMs": 5160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あ、もう下がってちょっとちょっとボルテが落ちて",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 583350,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 583360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いやいや落ちてない。落ちてないところが全然まだあのバにむかついてるから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 587430,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 587440,
    "dDurationMs": 2360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 589030,
    "dDurationMs": 770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 589040,
    "dDurationMs": 1640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いけるけど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 589790,
    "dDurationMs": 890,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 589800,
    "dDurationMs": 2719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 590670,
    "dDurationMs": 1849,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 590680,
    "dDurationMs": 2279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "近金であった話だから",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 592509,
    "dDurationMs": 450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 592519,
    "dDurationMs": 1880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 592949,
    "dDurationMs": 1450,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 592959,
    "dDurationMs": 3761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "見る人によっちゃ",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 594389,
    "dDurationMs": 2331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 594399,
    "dDurationMs": 2680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "特定される可能性",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "[笑い]",
      "tOffsetMs": 1002
    } ]
  }, {
    "tStartMs": 596710,
    "dDurationMs": 369,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 596720,
    "dDurationMs": 1440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いいね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 597069,
    "dDurationMs": 1091,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 597079,
    "dDurationMs": 4081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "もう特定しちゃうんです。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 598150,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 598160,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "オオ定させ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 601350,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 601360,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、じゃあですね。え、紹介ありがとうございました。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 603990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 604000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "え、激烈傲なんとか監督ラジオ、ま、後でタイトル見てください。え、初回こんな感じでしたが、え、次回はですね、え、森合介、え、怪しいビジネスのババーに切れる、え、ご期待ください。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 621630,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 621640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "から",
      "acAsrConf": 0
    } ]
  } ]
}
