    } ]
  }, {
    "tStartMs": 198000,
    "dDurationMs": 1799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "受けようとか",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 199070,
    "dDurationMs": 729,
    "wWinId": 1,
