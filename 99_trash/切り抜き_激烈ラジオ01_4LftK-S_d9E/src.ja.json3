    } ]
  }, {
    "tStartMs": 11920,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "あの、僕タイトルな何て言ったっけ?激烈傲。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 17020,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 17030,
    "dDurationMs": 3329,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 17349,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 17359,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、今までそんなことを言ったことはなかった。ただね、ぬるっと喋ってた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 22189,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 22199,
    "dDurationMs": 2881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ずっと今までやってたじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 23269,
    "dDurationMs": 1811,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 23279,
    "dDurationMs": 3080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "うん。やってた、やってた。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 25070,
    "dDurationMs": 1289,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 25080,
    "dDurationMs": 2720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まだあげてないけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 26349,
    "dDurationMs": 1451,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 26359,
    "dDurationMs": 5201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そうだね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 27790,
    "dDurationMs": 3770,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 27800,
    "dDurationMs": 4840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "なん、や忘れちゃったね。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "激烈傲。",
      "tOffsetMs": 1239,
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 31550,
    "dDurationMs": 1090,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 31560,
    "dDurationMs": 4080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "そんな名前だったっけ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 32630,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 32640,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "激傲なんとかかんとかラジオってま見りゃわかんだけど。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 36150,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 36160,
    "dDurationMs": 3320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "ああ、",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 37229,
