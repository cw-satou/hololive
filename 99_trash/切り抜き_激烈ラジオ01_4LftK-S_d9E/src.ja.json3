  }, {
    "tStartMs": 205990,
    "dDurationMs": 3010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 206000,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "それは自は終わら芸人って名乗った割にどうなそれ?だから全然向上司のかけらもないでしょ。",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 210247,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 210257,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 213229,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 213239,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当はちゃんと企画でって喋ったり何どっかでロケに行ったりとかしたいけど",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 218509,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 218519,
    "dDurationMs": 3121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "今そんな時間も金もないじゃん。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 220789,
    "dDurationMs": 851,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 220799,
    "dDurationMs": 1841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "まあね",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 221630,
    "dDurationMs": 1010,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 221640,
    "dDurationMs": 1480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "僕らは今",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 222630,
    "dDurationMs": 490,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 222640,
    "dDurationMs": 1799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "はい。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 223110,
    "dDurationMs": 1329,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 223120,
    "dDurationMs": 2640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "逆っプチにいるわけよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 224429,
    "dDurationMs": 1331,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 224439,
    "dDurationMs": 1961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "いや、その通りですよ。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 225750,
    "dDurationMs": 650,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 225760,
    "dDurationMs": 1199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "でしょ?",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    }, {
      "utf8": "[笑い]",
      "tOffsetMs": 217
    } ]
  }, {
    "tStartMs": 226390,
    "dDurationMs": 569,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 226400,
    "dDurationMs": 1160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "本当に",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 226949,
    "dDurationMs": 611,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 226959,
    "dDurationMs": 1441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お互い",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 227550,
    "dDurationMs": 850,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 227560,
    "dDurationMs": 3002,
    "wWinId": 1,
    "segs": [ {
      "utf8": "お互い",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 228390,
    "dDurationMs": 2172,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 228400,
    "dDurationMs": 4182,
    "wWinId": 1,
    "segs": [ {
      "utf8": "楽しんでる場合じゃない。生活区にやられてこっちになっては会社だっていつ潰れるかわかんない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 230552,
    "dDurationMs": 2030,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 230562,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 234710,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 234720,
    "dDurationMs": 3047,
    "wWinId": 1,
    "segs": [ {
      "utf8": "風船のしみ",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 236229,
    "dDurationMs": 1538,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 236239,
    "dDurationMs": 2121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "初回からネガティブしかない。",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 237757,
    "dDurationMs": 603,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 237767,
    "dDurationMs": 3312,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[笑い]"
    } ]
  }, {
    "tStartMs": 238350,
    "dDurationMs": 2729,
    "wWinId": 1,
    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 238360,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "だからこんなことやってる場合じゃないの?そ、ぶっちゃけ",
